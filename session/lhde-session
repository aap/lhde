#!/bin/sh
# lhde-session: the Longhorn desktop session.
# luxwm in a restart loop, picom when the theme wants a compositor, luxshell (Avalon bars, sidebar), flxp-desktop (wallpaper and
# icons), a terminal. The theme is the root property _LH_THEME (SHELL-DESIGN.md 14): luxwm publishes the
# session's when it starts first, after that the root wins and luxwm, luxshell and the clients follow it live.
#
#   lhde-session start [--nested | --attach] [THEME]
#         (default) a real X server on $LHDE_DISPLAY (default :1) and virtual terminal $LHDE_VT (default vt8), started with
#                   startx from a console login (Xorg not setuid: log in on that tty first); Ctrl+Alt+F1 goes back,
#                   Ctrl+C there ends the session and everything it started (the bus too)
#         --nested  a Xephyr window on the current $DISPLAY (1280x800, LHDE_GEOMETRY=WxH), the session inside it on
#                   $LHDE_DISPLAY (default: the first free display from :2)
#         --attach  the session on an X server that already runs on $LHDE_DISPLAY (an Xvfb, a bare Xorg); nothing is started
#                   but the session's programs
#         THEME     a theme (lhde-theme list: slate4051, slate4074, jade4074, aero4074, aerovision, basic5048, aero5048,
#                   basic5112, aero5112, luna, luna-olive, luna-silver, the user's, bare styles; old names such as aero-patch
#                   work as aliases); default: the last one (settings.ini [theme] name), else aero4074
#   lhde-session xsession [THEME]      the session a display manager runs on the X server it started (share/xsessions/lhde.desktop):
#                                      in the foreground on $DISPLAY, the same programs as start; it returns when the session
#                                      ends (Log Off: luxshell's, the start panel's, lhde-session stop), and the display
#                                      manager then ends the server. No terminal unless LHDE_TERMINAL names one (~/.xprofile)
#   lhde-session theme NAME            switch the running session to NAME (root _LH_THEME; nothing restarts)
#   lhde-session taskbar avalon|classic|classic+sidebar|none
#                                      the bottom bar, live: luxshell's Avalon taskbar, flxp-taskbar (luxshell starts it; classic
#                                      hides the sidebar, classic+sidebar keeps it above the bar) or none; luxshell keeps the
#                                      choice per theme in settings.ini (written here when no luxshell runs)
#   lhde-session shell on|off          start / stop luxshell
#   lhde-session picom on|off          start / stop picom (glx backend; LHDE_PICOM_BACKEND=xrender for Xvfb)
#   lhde-session desktop on|off        start / stop flxp-desktop; restarts luxshell without / with its own desktop layer
#   lhde-session stop                  end the session (the X server of start and --nested ends with it; of --attach, --nested
#                                      and xsession every process the session started, a terminal or an autolaunched D-Bus too)
# The control commands act on $LHDE_DISPLAY, else on the one running session, else on $DISPLAY.
# Environment: LHDE_PICOM=0/1 forces the compositor off/on for the session (luxshell too); LHDE_SHELL=0 without luxshell;
# LHDE_DESKTOP=0 without flxp-desktop (luxshell then shows its own desktop layer); LHDE_WM=fvwm for an fvwm2 session (lab.fvwm2rc);
# LHDE_TERMINAL=command (default the terminal: settings.ini [commands] terminal, else the first of cmd, urxvt, xterm,
# x-terminal-emulator; none for no terminal); LHDE_WINDOWS another Windows tree (as every lhde program);
# Set for the session: XDG_CURRENT_DESKTOP=lhde and DESKTOP_SESSION=lhde (lhde-mimeapps.list, docs/SETTINGS.md "Associations");
# at start the role file of the default programs (lhde-mime roles apply, docs/SETTINGS.md "Default programs");
# LHDE_DISPLAY=<display>, the display the control commands of the session's programs act on (luxshell's Log Off);
# LHDE_SESSION_TAG=<display>.<pid>, by which stop finds what an attached, nested or xsession session started.
# Settings: ~/.config/lhde/settings.ini and themes/ (docs/SETTINGS.md).
# State: $XDG_RUNTIME_DIR/lhde-session<DISPLAY>/ (theme, shell, desktop, logs; luxshell's Log Off runs `lhde-session stop` when it exists).
SELF=$(readlink -f "$0")
if [ -f "$(dirname "$SELF")/lhde-paths.sh" ]; then . "$(dirname "$SELF")/lhde-paths.sh"; else . "$(dirname "$SELF")/../lib/lhde/session/lhde-paths.sh"; fi
lhde_self "$SELF"; lhde_setup_paths
: "${LHDE_WM:=luxwm}"
RUN=${XDG_RUNTIME_DIR:-/tmp}

statedir() { echo "$RUN/lhde-session$1"; }
# the display a control command acts on
target() {
	if [ -n "$LHDE_DISPLAY" ]; then echo "$LHDE_DISPLAY"; return; fi
	n=0; for s in "$RUN"/lhde-session:*; do [ -f "$s/loop.pid" ] && lhde_alive "$(cat "$s/loop.pid")" && { n=$((n + 1)); one=${s##*/lhde-session}; }; done
	if [ $n = 1 ]; then echo "$one"; else echo "${DISPLAY:-:1}"; fi
}
# a theme name (an alias, a bare style) through liblhde (lhde-theme resolve): prints the theme's name, nothing when unknown
themename() { lhde_themename "$1"; }
nosuch() { echo "lhde-session: no such theme $1; have: $(lhde_themes)" >&2; exit 1; }
LHDE_THEME_TOOL=$(lhde_bin lhde-theme)
# the session's own D-Bus session bus: started by the session when the login has none, its pid and address kept in the state
# directory, and stopped with the session together with everything that lives on it (an at-spi bus launcher and its dbus-daemon,
# xdg-desktop-portal and its backends, whatever GTK started): every process whose DBUS_SESSION_BUS_ADDRESS is this bus's
bus_start() {
	out=$(dbus-daemon --session --fork --print-address 1 --print-pid 1 2>/dev/null) || return 1
	addr=$(printf '%s\n' "$out" | sed -n 1p); pid=$(printf '%s\n' "$out" | sed -n 2p)
	[ -n "$addr" ] && [ -n "$pid" ] || return 1
	export DBUS_SESSION_BUS_ADDRESS=$addr
	printf '%s\n' "$addr" > "$STATE/dbus.addr"; printf '%s\n' "$pid" > "$STATE/dbus.pid"
}
bus_stop() {
	[ -f "$STATE/dbus.addr" ] || return 0
	addr=$(cat "$STATE/dbus.addr"); pid=$(cat "$STATE/dbus.pid" 2>/dev/null)
	for p in $(pgrep -u "$(id -u)"); do   # our own processes only (another user's environ is not readable anyway)
		[ "$p" = "$$" ] && continue
		lhde_environ $p | grep -qxF "DBUS_SESSION_BUS_ADDRESS=$addr" && kill $p 2>/dev/null
	done
	[ -n "$pid" ] && lhde_alive "$pid" && kill $pid 2>/dev/null
	rm -f "$STATE/dbus.addr" "$STATE/dbus.pid"
}
# what an attached or nested session started and the processes it started in turn (a terminal, a sound server or D-Bus
# autolaunched by a client): every process of ours with the session's tag in its environment. A real session leaves that to
# its X server, whose end ends its clients, and does not take the user's other programs down with it
sweep() {
	read -r mode tag < "$STATE/mode" 2>/dev/null || return 0
	[ "$mode" = real ] || [ -z "$tag" ] && return 0
	gone=
	for p in $(pgrep -u "$(id -u)"); do
		[ "$p" = "$$" ] && continue
		lhde_environ $p | grep -qxF "LHDE_SESSION_TAG=$tag" && kill $p 2>/dev/null && gone="$gone $p"
	done
	# the terminal by its pid: a set-user-id one (FreeBSD's urxvt) does not show its environment
	t=$(cat "$STATE/terminal.pid" 2>/dev/null); [ -n "$t" ] && lhde_alive "$t" && kill "$t" 2>/dev/null && gone="$gone $t"
	# what does not end on TERM within 2 s (a sound server busy with its clients) is killed
	n=20; while [ $n -gt 0 ]; do left=; for p in $gone; do lhde_alive $p && left="$left $p"; done; [ -z "$left" ] && break; sleep .1; n=$((n - 1)); done
	for p in $left; do kill -9 $p 2>/dev/null; done
	rm -f "$STATE/mode" "$STATE/terminal.pid"
}
killon() { # kill processes named $1 whose DISPLAY is $D (never pkill -f: it matches this shell)
	for p in $(pgrep -x "$1"); do lhde_environ $p | grep -qx "DISPLAY=$D" && kill $p; done
}
running_on() { for p in $(pgrep -x "$1"); do lhde_environ $p | grep -qx "DISPLAY=$D" && { echo $p; return 0; }; done; return 1; }
LUXWM=$(lhde_bin luxwm) LUXSHELL=$(lhde_bin luxshell) FLXPDESK=$(lhde_bin flxp-desktop)
PCONF=$LHDE_SESSION_DIR/picom-glass.conf
picom_start() { # picom with the session's config (glx on real hardware; LHDE_PICOM_BACKEND=xrender for Xvfb, with lab.sh's blur)
	if [ "${LHDE_PICOM_BACKEND:-glx}" = xrender ]; then set -- --backend xrender --blur-method gaussian --blur-size 5 --blur-deviation 1.2
	else set -- --backend glx; fi
	(DISPLAY=$D $LHDE_SETSID picom --config "$PCONF" "$@" >"$STATE/picom.log" 2>&1 </dev/null &)
}
# (re)start luxshell; without its desktop layer while flxp-desktop is on. Its pack follows the session theme (_LH_THEME).
startshell() {
	killon luxshell
	lhdesk=1; [ "$(cat "$STATE/desktop" 2>/dev/null)" = 1 ] && [ -x "$FLXPDESK" ] && lhdesk=0
	(cd "$HOME" && DISPLAY=$D LHSHELL_DESKTOP=$lhdesk $LHDE_SETSID "$LUXSHELL" >"$STATE/luxshell.log" 2>&1 </dev/null &)
}
startdesk() {
	# from a control command the session environment is not ours: DISPLAY and the D-Bus address of luxshell or luxwm on $D
	bus=$DBUS_SESSION_BUS_ADDRESS
	for p in $(pgrep -x luxshell) $(pgrep -x luxwm); do
		lhde_environ $p | grep -qx "DISPLAY=$D" || continue
		b=$(lhde_environ $p | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p'); [ -n "$b" ] && bus=$b; break
	done
	# no FLXP_<KEY> here: an exported one beats flxp.ini, and every program the desktop starts inherits it
	(cd "$HOME" && DISPLAY=$D DBUS_SESSION_BUS_ADDRESS=$bus $LHDE_SETSID "$FLXPDESK" >"$STATE/flxp-desktop.log" 2>&1 </dev/null &)
}

# ---- the session itself: runs on $D, in the X server's client process (startx) or in the background ----
session() {
	D=$DISPLAY STATE=$(statedir "$DISPLAY"); mkdir -p "$STATE"
	# no THEME given: the one saved last (settings.ini [theme] name, SETTINGS.md), else aero4074
	if [ ! -s "$STATE/theme" ]; then
		t=${LHDE_THEME:-$("$LHDE_THEME_TOOL" current 2>/dev/null)}; echo "${t:-aero4074}" > "$STATE/theme"
	fi
	[ -s "$STATE/shell" ] || echo "${LHDE_SHELL:-1}" > "$STATE/shell"
	[ -s "$STATE/desktop" ] || echo "${LHDE_DESKTOP:-1}" > "$STATE/desktop"
	rm -f "$STATE/quit"; echo $$ > "$STATE/loop.pid"
	export LHDE_SESSION_TAG="$D.$$" LHDE_DISPLAY="$D"; echo "$LHDE_MODE $LHDE_SESSION_TAG" > "$STATE/mode"
	trap session_end INT TERM HUP
	# the desktop's name for every program the session starts: the MIME Applications spec reads lhde-mimeapps.list (lhde's
	# default programs, installed in share/applications) only when XDG_CURRENT_DESKTOP names lhde; xdg-utils, which knows no
	# lhde, takes its generic path, which reads the same files (docs/SETTINGS.md "Associations")
	export XDG_CURRENT_DESKTOP=lhde DESKTOP_SESSION=lhde
	# the default programs by role (settings.ini [programs], roles.ini) into the role file, so a text type installed since the
	# last session follows its role (lhde-mime roles apply; docs/SETTINGS.md "Default programs")
	m=$(lhde_bin lhde-mime) && [ -n "$m" ] && "$m" roles apply >/dev/null 2>&1
	[ "$LHDE_MODE" = real ] && [ -f "$HOME/.xinit_all" ] && . "$HOME/.xinit_all"   # the user's own X startup, real sessions only
	[ -f "$HOME/.Xresources" ] && xrdb "$HOME/.Xresources" 2>/dev/null
	# a session bus for luxshell's notification server (toasts via notify-send); a tty login has none. Ours, ended with the session
	# (bus_stop): dbus-launch leaves one dbus-daemon per start behind, and with it an at-spi bus and an xdg-desktop-portal; a hundred
	# of them use up the user's inotify instances (fs.inotify.max_user_instances, 128)
	if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && { [ "$LHDE_MODE" = real ] || [ "$LHDE_MODE" = xsession ]; }; then bus_start; fi
	xset -b 2>/dev/null
	# the root background once, from the settings luxshell and flxp-desktop read (lhwall.sh): the first frames already show the
	# wallpaper the session keeps
	. "$LHDE_SESSION_DIR/lhwall.sh"; lhwall_apply "$(cat "$STATE/theme")"
	[ "$LHDE_WM" = fvwm ] && PCONF=$LHDE_SESSION_DIR/picom-glass-fvwm.conf
	# picom only when the session's theme wants one (lhcomp_wanted: the per-theme composition switch, auto = the theme's frame
	# mode); luxshell applies the same rule 1.5 s after it starts. LHDE_PICOM=0/1 forces it either way, for luxshell too.
	case ${LHDE_PICOM:-} in
	0) lhpicom=no; export LHSHELL_COMPOSITION=0 ;;
	1) lhpicom=yes; export LHSHELL_COMPOSITION=1 ;;
	*) lhpicom=$(lhcomp_wanted "$(cat "$STATE/theme")") ;;
	esac
	[ "$LHDE_WM" = fvwm ] && [ -z "$LHDE_PICOM" ] && lhpicom=yes   # fvwm: no luxshell to follow the theme
	echo "lhde-session: theme $(cat "$STATE/theme"), picom $lhpicom, Windows files $LHDE_USER_DATA" >&2
	[ "$lhpicom" = yes ] && picom_start
	term=${LHDE_TERMINAL:-}
	# the terminal's pid in terminal.pid: the sh that execs lhde-theme terminal, which execs the terminal's command line
	if [ -z "$term" ]; then (cd "$HOME" && $LHDE_SETSID sh -c 'echo $$ > "$1"; exec "$2" terminal --run "$HOME"' sh "$STATE/terminal.pid" "$LHDE_THEME_TOOL" >/dev/null 2>&1 </dev/null &)
	elif [ "$term" != none ]; then (cd "$HOME" && $LHDE_SETSID sh -c 'echo $$ > "$1"; shift; exec "$@"' sh "$STATE/terminal.pid" $term >/dev/null 2>&1 </dev/null &); fi
	[ -x "$FLXPDESK" ] || echo 0 > "$STATE/desktop"
	if [ "$LHDE_WM" = fvwm ]; then exec fvwm2 -f "$LHDE_SESSION_DIR/lab.fvwm2rc"; fi
	# luxwm in a loop: a restart (or a crash) brings it back without ending the session
	while [ ! -f "$STATE/quit" ]; do
		theme=$(cat "$STATE/theme")
		(cd "$HOME" && LHWM_THEME="$theme" exec "$LUXWM" >>"$STATE/luxwm.log" 2>&1) &
		wmpid=$!
		# the desktop after luxwm (so luxwm sees it map and keeps it at the bottom) and with luxshell; started once
		desk=$(cat "$STATE/desktop"); [ "$desk" != 0 ] && ! running_on flxp-desktop >/dev/null && ( sleep 1; startdesk ) &
		[ "$(cat "$STATE/shell")" != 0 ] && ( sleep 1; startshell ) &
		t0=$(date +%s); wait $wmpid
		killon luxshell   # restarted with the next luxwm
		# luxwm died at once (another WM holds the display): back off
		if [ $(( $(date +%s) - t0 )) -lt 2 ]; then sleep 3; else sleep 0.3; fi
	done
	session_end
}
# the session's end, on the loop's exit and on a signal: Ctrl+C on the console the session was started from (SIGINT to the
# process group: the X server goes down with it), xinit's SIGHUP/SIGTERM when the server exits, lhde-session stop (quit)
session_end() {
	trap - INT TERM HUP
	touch "$STATE/quit"
	killon luxshell; killon flxp-desktop; killon luxwm; killon picom
	bus_stop
	sweep
	rm -f "$STATE/loop.pid"
	exit 0
}

cmd=${1:-start}; [ $# -gt 0 ] && shift
case $cmd in
__session) LHDE_MODE=${LHDE_MODE:-real}; session ;;
xsession)
	# a display manager's session: its X server on $DISPLAY, this process the session (its end ends the login)
	[ -n "$DISPLAY" ] && xdpyinfo >/dev/null 2>&1 || { echo "lhde-session: xsession: no X server on DISPLAY=$DISPLAY" >&2; exit 1; }
	[ -x "$LUXWM" ] || { echo "lhde-session: no luxwm (make, or make install)" >&2; exit 1; }
	n=; [ -z "$1" ] || { n=$(themename "$1"); [ -n "$n" ] || nosuch "$1"; }
	STATE=$(statedir "$DISPLAY"); rm -rf "$STATE"; mkdir -p "$STATE"; [ -n "$n" ] && echo "$n" > "$STATE/theme"
	export LHDE_THEME="$n"
	: "${LHDE_TERMINAL:=none}"
	LHDE_MODE=xsession; session ;;
start)
	how=real
	case $1 in --nested) how=nested; shift ;; --attach) how=attach; shift ;; esac
	n=; [ -z "$1" ] || { n=$(themename "$1"); [ -n "$n" ] || nosuch "$1"; }
	[ -x "$LUXWM" ] || { echo "lhde-session: no luxwm (make, or make install)" >&2; exit 1; }
	case $how in
	real)   D=${LHDE_DISPLAY:-:1} ;;
	nested) D=$LHDE_DISPLAY; if [ -z "$D" ]; then i=2; while [ -e /tmp/.X11-unix/X$i ] || [ -e /tmp/.X$i-lock ]; do i=$((i + 1)); done; D=:$i; fi ;;
	attach) D=${LHDE_DISPLAY:-$DISPLAY}; DISPLAY=$D xdpyinfo >/dev/null 2>&1 || { echo "lhde-session: no X server on $D" >&2; exit 1; } ;;
	esac
	STATE=$(statedir "$D"); rm -rf "$STATE"; mkdir -p "$STATE"; [ -n "$n" ] && echo "$n" > "$STATE/theme"
	export LHDE_THEME="$n"
	case $how in
	real)   LHDE_MODE=real exec startx "$SELF" __session -- "$D" "${LHDE_VT:-vt8}" -keeptty ;;
	nested) ($LHDE_SETSID Xephyr "$D" -screen "${LHDE_GEOMETRY:-1280x800}" -title "lhde $D" +extension GLX -ac -br -noreset >"$STATE/x.log" 2>&1 </dev/null &)
	        i=0; until DISPLAY=$D xdpyinfo >/dev/null 2>&1; do i=$((i + 1)); [ $i -gt 50 ] && { echo "lhde-session: Xephyr did not start on $D" >&2; exit 1; }; sleep 0.1; done
	        (DISPLAY=$D LHDE_MODE=nested $LHDE_SETSID "$SELF" __session >"$STATE/session.log" 2>&1 </dev/null &)
	        echo "lhde-session: nested on $D (log $STATE)" ;;
	attach) (DISPLAY=$D LHDE_MODE=attach $LHDE_SETSID "$SELF" __session >"$STATE/session.log" 2>&1 </dev/null &)
	        echo "lhde-session: on $D (log $STATE)" ;;
	esac ;;
theme)
	D=$(target); STATE=$(statedir "$D")
	n=$(themename "$1"); [ -n "$n" ] || nosuch "$1"
	[ -d "$STATE" ] && echo "$n" > "$STATE/theme"   # for luxwm restarts of the loop, while the root has no _LH_THEME
	DISPLAY=$D xprop -root -f _LH_THEME 8u -set _LH_THEME "$n" && echo "theme $n on $D" || { echo "lhde-session: cannot set _LH_THEME on $D" >&2; exit 1; } ;;
shell)
	D=$(target); STATE=$(statedir "$D"); [ -d "$STATE" ] || { echo "lhde-session: no session on $D" >&2; exit 1; }
	case $1 in off) echo 0 > "$STATE/shell"; killon luxshell ;; *) echo 1 > "$STATE/shell"; startshell ;; esac
	echo "shell ${1:-on} on $D" ;;
desktop)
	D=$(target); STATE=$(statedir "$D"); [ -d "$STATE" ] || { echo "lhde-session: no session on $D" >&2; exit 1; }
	case $1 in
	off) echo 0 > "$STATE/desktop"; killon flxp-desktop
	     # the root background of the theme in use (it was flxp-desktop's to paint since the session started)
	     . "$LHDE_SESSION_DIR/lhwall.sh"; DISPLAY=$D lhwall_apply "$(cat "$STATE/theme" 2>/dev/null)" ;;
	*)   [ -x "$FLXPDESK" ] || { echo "lhde-session: no flxp-desktop (make, or make install)" >&2; exit 1; }
	     echo 1 > "$STATE/desktop"; killon flxp-desktop
	     . "$LHDE_SESSION_DIR/lhwall.sh"; DISPLAY=$D lhwall_apply "$(cat "$STATE/theme" 2>/dev/null)"
	     startdesk ;;
	esac
	[ "$(cat "$STATE/shell")" != 0 ] && startshell
	echo "desktop ${1:-on} on $D" ;;
taskbar)
	D=$(target); STATE=$(statedir "$D")
	# classic = the classic bar alone ([sidebar] with_classic = 0), classic+sidebar = with the sidebar above it (with_classic = 1)
	case $1 in avalon|none) kind=$1 wc= ;; classic) kind=classic wc=0 ;; classic+sidebar) kind=classic wc=1 ;;
	*) echo "usage: lhde-session taskbar avalon|classic|classic+sidebar|none" >&2; exit 1 ;; esac
	if running_on luxshell >/dev/null; then
		[ -n "$wc" ] && { DISPLAY=$D xprop -root -f _LHSHELL_COMMAND 8u -set _LHSHELL_COMMAND "sidebar-with-classic $wc" || exit 1; sleep 0.2; }
		DISPLAY=$D xprop -root -f _LHSHELL_COMMAND 8u -set _LHSHELL_COMMAND "taskbar $kind" && echo "taskbar $1 on $D" || exit 1
	else   # no luxshell: a theme key (Shell.taskbar into THEME-modified.theme, THEME-FORMAT.md section 3) the next one starts with
		t=$(cat "$STATE/theme" 2>/dev/null); [ -n "$t" ] || t=$("$LHDE_THEME_TOOL" current 2>/dev/null)
		sel=$("$LHDE_THEME_TOOL" set-key "${t:-aero4074}" Shell.taskbar "$kind" | cut -d' ' -f1)
		[ -n "$sel" ] && { "$LHDE_THEME_TOOL" set "$sel" >/dev/null; [ -d "$STATE" ] && echo "$sel" > "$STATE/theme"; }
		[ -n "$wc" ] && "$LHDE_THEME_TOOL" setting sidebar with_classic "$wc"
		echo "no luxshell on $D: theme $sel: Shell.taskbar = $kind (applies when it starts)"
	fi ;;
picom)
	D=$(target); STATE=$(statedir "$D"); mkdir -p "$STATE"
	case $1 in off) killon picom ;; *) killon picom; picom_start ;; esac; echo "picom ${1:-on} on $D" ;;
stop)
	# run from inside the session (luxshell's Log Off): without the session's tag and bus address, so neither this stop's sweep
	# nor the session's own end, which sweeps and stops the bus too once luxwm is gone, takes this process down halfway
	[ -n "$LHDE_SESSION_TAG$DBUS_SESSION_BUS_ADDRESS" ] && exec env -u LHDE_SESSION_TAG -u DBUS_SESSION_BUS_ADDRESS "$SELF" stop "$@"
	D=$(target); STATE=$(statedir "$D")
	[ -d "$STATE" ] && touch "$STATE/quit"
	killon luxshell; killon flxp-desktop; killon luxwm; killon picom; killon fvwm2
	bus_stop
	sweep
	# the X server this script started for --nested (Xephyr whose command line names the display)
	for p in $(pgrep -x Xephyr); do lhde_args $p | grep -qx -- "$D" && kill $p; done
	echo "stopped $D" ;;
-h|--help|help) sed -n '2,/^SELF=/p' "$SELF" | sed '$d; s/^# \{0,1\}//' ;;
*) echo "usage: lhde-session start [--nested|--attach] [THEME] | xsession [THEME] | theme NAME | taskbar KIND | shell on|off | picom on|off | desktop on|off | stop" >&2; exit 2 ;;
esac
