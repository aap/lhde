+static LRESULT LISTVIEW_InsertGroup(LISTVIEW_INFO *infoPtr, INT index, const LVGROUP *lvg)
+{
+    LV_GROUP_INFO *g;
+
+    if (!lvg || !(lvg->mask & LVGF_GROUPID) || group_by_id(infoPtr, lvg->iGroupId, NULL)) return -1;
+    if (!(g = Alloc(sizeof(*g)))) return -1;
+    g->id = lvg->iGroupId;
+    if ((lvg->mask & LVGF_HEADER) && lvg->pszHeader)
+    {
+        INT len = lstrlenW(lvg->pszHeader);
+        if ((g->header = Alloc((len + 1) * sizeof(WCHAR)))) memcpy(g->header, lvg->pszHeader, (len + 1) * sizeof(WCHAR));
+    }
+    if (lvg->mask & LVGF_STATE) g->state = lvg->state & lvg->stateMask;
+    if (index < 0 || index > DPA_GetPtrCount(infoPtr->hdpaGroups)) index = DPA_GetPtrCount(infoPtr->hdpaGroups);
+    index = DPA_InsertPtr(infoPtr->hdpaGroups, index, g);
+    if (index < 0) { group_free(g); return -1; }
+    infoPtr->groupsDirty = TRUE;
+    LISTVIEW_InvalidateList(infoPtr);
+    return index;
+}
+
+static LRESULT LISTVIEW_SetGroupInfo(LISTVIEW_INFO *infoPtr, INT id, const LVGROUP *lvg)
+{
+    LV_GROUP_INFO *g = group_by_id(infoPtr, id, NULL);
+
+    if (!g || !lvg) return -1;
+    if ((lvg->mask & LVGF_HEADER) && lvg->pszHeader)
+    {
+        INT len = lstrlenW(lvg->pszHeader);
+        Free(g->header);
+        if ((g->header = Alloc((len + 1) * sizeof(WCHAR)))) memcpy(g->header, lvg->pszHeader, (len + 1) * sizeof(WCHAR));
+    }
+    if (lvg->mask & LVGF_STATE) g->state = (g->state & ~lvg->stateMask) | (lvg->state & lvg->stateMask);
+    infoPtr->groupsDirty = TRUE;
+    LISTVIEW_InvalidateList(infoPtr);
+    return id;
+}
+
+static LRESULT LISTVIEW_GetGroupInfo(const LISTVIEW_INFO *infoPtr, INT id, LVGROUP *lvg)
+{
+    LV_GROUP_INFO *g = group_by_id(infoPtr, id, NULL);
+
+    if (!g || !lvg) return -1;
+    if (lvg->mask & LVGF_STATE) lvg->state = g->state & lvg->stateMask;
+    if (lvg->mask & LVGF_GROUPID) lvg->iGroupId = g->id;
+    if ((lvg->mask & LVGF_HEADER) && lvg->pszHeader && lvg->cchHeader > 0)
+        lstrcpynW(lvg->pszHeader, g->header ? g->header : L"", lvg->cchHeader);
+    return id;
+}
+
+static LRESULT LISTVIEW_RemoveGroup(LISTVIEW_INFO *infoPtr, INT id)
+{
+    INT index;
+    LV_GROUP_INFO *g = group_by_id(infoPtr, id, &index);
+
+    if (!g) return -1;
+    DPA_DeletePtr(infoPtr->hdpaGroups, index);
+    group_free(g);
+    infoPtr->groupsDirty = TRUE;
+    LISTVIEW_InvalidateList(infoPtr);
+    return index;
+}
+
+static void LISTVIEW_RemoveAllGroups(LISTVIEW_INFO *infoPtr)
+{
+    while (DPA_GetPtrCount(infoPtr->hdpaGroups) > 0)
