+/* each group: its header, then its items row by row from the left edge; the
+   items of a collapsed group are moved out of sight; items in no group
+   follow the last group without a header */
+static void LISTVIEW_ArrangeGroups(LISTVIEW_INFO *infoPtr)
+{
+    INT nListWidth = infoPtr->rcList.right - infoPtr->rcList.left;
+    INT n = DPA_GetPtrCount(infoPtr->hdpaGroups), hdr = group_header_height(infoPtr);
+    INT g, i, y = 0;
+    BYTE *placed = infoPtr->nItemCount ? Alloc(infoPtr->nItemCount) : NULL;
+    POINT pos;
+
+    if (infoPtr->nItemCount && !placed) return;
+    for (g = 0; g <= n; g++)
+    {
+        LV_GROUP_INFO *grp = g < n ? DPA_GetPtr(infoPtr->hdpaGroups, g) : NULL;
+        INT x = 0, count = 0;
+
+        if (grp)
+        {
+            grp->top = y;
+            y += (grp->state & LVGS_HIDDEN) ? 0 : hdr;
+        }
+        for (i = 0; i < infoPtr->nItemCount; i++)
+        {
+            if (placed[i] || (grp && item_group(infoPtr, i) != grp->id)) continue;
+            placed[i] = 1;
+            if (grp && (grp->state & (LVGS_COLLAPSED | LVGS_HIDDEN)))
+            {
+                pos.x = -32000; pos.y = grp->top;
+                LISTVIEW_MoveIconTo(infoPtr, i, &pos, FALSE);
+                continue;
+            }
+            if (x > 0 && x + infoPtr->nItemWidth > nListWidth)
+            {
+                x = 0;
+                y += infoPtr->nItemHeight;
+            }
+            pos.x = x; pos.y = y;
+            LISTVIEW_MoveIconTo(infoPtr, i, &pos, FALSE);
+            x += infoPtr->nItemWidth;
+            count++;
+        }
+        if (count) y += infoPtr->nItemHeight;
+        if (grp && !(grp->state & LVGS_HIDDEN)) y += 6;
+    }
+    Free(placed);
+    /* items inserted later go under the last row until the next arrange */
+    infoPtr->currIconPos.x = 0;
+    infoPtr->currIconPos.y = y;
+    infoPtr->groupsDirty = FALSE;
+}
+
+/* the group whose header row is at client point (x, y), or NULL */
+static LV_GROUP_INFO *group_header_at(const LISTVIEW_INFO *infoPtr, INT x, INT y)
+{
+    POINT Origin;
+    INT i, hdr = group_header_height(infoPtr);
+
+    if (!groups_active(infoPtr) || x < infoPtr->rcList.left || x >= infoPtr->rcList.right) return NULL;
+    LISTVIEW_GetOrigin(infoPtr, &Origin);
+    y -= Origin.y;
+    for (i = 0; i < DPA_GetPtrCount(infoPtr->hdpaGroups); i++)
+    {
+        LV_GROUP_INFO *g = DPA_GetPtr(infoPtr->hdpaGroups, i);
+        if (!(g->state & LVGS_HIDDEN) && y >= g->top && y < g->top + hdr) return g;
+    }
+    return NULL;
+}
+
+/* the headers: the title in grey, a pale blue rule to the right and, for a
+   collapsible group, a small triangle (up: expanded) at the right end - the
+   pre-reset Longhorn Save File concept (image9.jpeg) */
+static void LISTVIEW_RefreshGroups(const LISTVIEW_INFO *infoPtr, HDC hdc)
+{
+    POINT Origin;
+    RECT rcClip, r, tmp;
+    INT i, hdr = group_header_height(infoPtr);
+    HPEN pen, oldPen;
+    HBRUSH brush, oldBrush;
+
+    LISTVIEW_GetOrigin(infoPtr, &Origin);
+    if (GetClipBox(hdc, &rcClip) == ERROR) rcClip = infoPtr->rcList;
+    SetBkMode(hdc, TRANSPARENT);
+    for (i = 0; i < DPA_GetPtrCount(infoPtr->hdpaGroups); i++)
+    {
+        LV_GROUP_INFO *g = DPA_GetPtr(infoPtr->hdpaGroups, i);
+        RECT tr, line;
+        SIZE sz = { 0, 0 };
+        INT len, mid, gx;
+
+        if (g->state & LVGS_HIDDEN) continue;
+        r.left = infoPtr->rcList.left;
+        r.right = infoPtr->rcList.right;
+        r.top = g->top + Origin.y;
+        r.bottom = r.top + hdr;
+        if (!IntersectRect(&tmp, &r, &rcClip)) continue;
+        len = g->header ? lstrlenW(g->header) : 0;
+        tr = r;
+        tr.left += 8;
+        tr.right -= 44;
+        tr.top += 4;
+        if (len) GetTextExtentPoint32W(hdc, g->header, len, &sz);
+        SetTextColor(hdc, RGB(114, 114, 114));
+        if (len) DrawTextW(hdc, g->header, len, &tr, DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX | DT_END_ELLIPSIS);
+        mid = tr.top + (tr.bottom - tr.top) / 2 + 1;
+        line.left = min(tr.left + sz.cx + 10, tr.right);
+        line.right = r.right - 36;
+        line.top = mid;
+        line.bottom = mid + 1;
+        if (line.right > line.left)
+        {
+            brush = CreateSolidBrush(RGB(193, 204, 226));
+            FillRect(hdc, &line, brush);
+            DeleteObject(brush);
+        }
+        if (g->state & LVGS_COLLAPSIBLE)
+        {
+            POINT tri[3];
+            BOOL collapsed = (g->state & LVGS_COLLAPSED) != 0;
+            gx = r.right - 28;
+            tri[0].x = gx;     tri[0].y = collapsed ? mid - 2 : mid + 2;
+            tri[1].x = gx + 6; tri[1].y = tri[0].y;
+            tri[2].x = gx + 3; tri[2].y = collapsed ? mid + 1 : mid - 1;
+            pen = CreatePen(PS_SOLID, 1, RGB(97, 131, 179));
+            brush = CreateSolidBrush(RGB(97, 131, 179));
+            oldPen = SelectObject(hdc, pen);
+            oldBrush = SelectObject(hdc, brush);
+            Polygon(hdc, tri, 3);
+            SelectObject(hdc, oldPen);
+            SelectObject(hdc, oldBrush);
+            DeleteObject(pen);
+            DeleteObject(brush);
+        }
+    }
+}
