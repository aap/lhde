+    if (infoPtr->bTileSavedAuto) LISTVIEW_SetIconSpacing(infoPtr, -1, -1);
+    else LISTVIEW_SetIconSpacing(infoPtr, infoPtr->tileSavedSpacing.cx, infoPtr->tileSavedSpacing.cy);
+}
