+/* flxp: Vista's themed item backgrounds. When the window's theme class has
+   LVP_LISTITEM (Longhorn's Explorer::ListView after SetWindowTheme(L"Explorer"):
+   the 4051 peach/grey rounded rectangles; XP's ListView class has none),
+   selected and hot items get that part behind icon and label instead of the
+   highlight colours. Returns the LISS_* state, 0 for a plain item. */
+static int LISTVIEW_ThemedItemState(const LISTVIEW_INFO *infoPtr, UINT cdstate, UINT lvstate)
+{
+    HTHEME theme = GetWindowTheme(infoPtr->hwndSelf);
+    BOOL hot = (cdstate & CDIS_HOT) != 0, drop = (lvstate & LVIS_DROPHILITED) || (cdstate & CDIS_DROPHILITED);
+
+    if (!theme || !IsThemePartDefined(theme, LVP_LISTITEM, 0)) return 0;
+    if (drop || ((cdstate & CDIS_SELECTED) && (infoPtr->bFocus || (infoPtr->dwStyle & LVS_SHOWSELALWAYS))))
+    {
+        if (!infoPtr->bFocus && !drop) return LISS_SELECTEDNOTFOCUS;
+        return hot ? LISS_HOTSELECTED : LISS_SELECTED;
+    }
+    return hot ? LISS_HOT : 0;
+}
+
+static BOOL LISTVIEW_HasThemedItems(const LISTVIEW_INFO *infoPtr)
+{
+    HTHEME theme = GetWindowTheme(infoPtr->hwndSelf);
+    return theme && IsThemePartDefined(theme, LVP_LISTITEM, 0);
+}
