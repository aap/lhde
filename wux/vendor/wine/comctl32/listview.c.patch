+   row every 92 px) */
+static inline INT group_header_height(const LISTVIEW_INFO *infoPtr)
+{
+    INT h;
+    if (group_theme(infoPtr, &h)) return h + 10;
+    return infoPtr->ntmHeight + 16;
+}
