+
+static inline BOOL groups_active(const LISTVIEW_INFO *infoPtr)
+{
+    return infoPtr->groupView && DPA_GetPtrCount(infoPtr->hdpaGroups) > 0 &&
+        (infoPtr->uView == LV_VIEW_ICON || infoPtr->uView == LV_VIEW_SMALLICON);
+}
+
+/* the header row: the title (the list's font) with room above and below */
+static inline INT group_header_height(const LISTVIEW_INFO *infoPtr)
+{
+    return infoPtr->ntmHeight + 16;
+}
+
+static LV_GROUP_INFO *group_by_id(const LISTVIEW_INFO *infoPtr, INT id, INT *index)
+{
+    INT i;
+    for (i = 0; i < DPA_GetPtrCount(infoPtr->hdpaGroups); i++)
+    {
+        LV_GROUP_INFO *g = DPA_GetPtr(infoPtr->hdpaGroups, i);
+        if (g->id == id) { if (index) *index = i; return g; }
+    }
+    return NULL;
+}
+
+static inline INT item_group(const LISTVIEW_INFO *infoPtr, INT nItem)
+{
+    HDPA hdpaSubItems = DPA_GetPtr(infoPtr->hdpaItems, nItem);
+    ITEM_INFO *lpItem = hdpaSubItems ? DPA_GetPtr(hdpaSubItems, 0) : NULL;
+    return lpItem ? lpItem->iGroupId : I_GROUPIDNONE;
+}
+
+static void group_free(LV_GROUP_INFO *g)
+{
+    if (!g) return;
+    Free(g->header);
+    Free(g);
+}
