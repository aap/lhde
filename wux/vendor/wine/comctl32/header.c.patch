+/* flxp: true when the normal item image is mostly see-through (a Vista header
+ * item: a separator line on the background), judged by its centre pixel drawn
+ * over black and over white; remembered for the last theme handle */
+static HTHEME see_through_theme;     /* flxp: forgotten on WM_THEMECHANGED (a handle may be reused) */
+static BOOL header_items_see_through (HTHEME theme)
+{
+    static BOOL last_out;
+    RECT r = { 0, 0, 40, 24 };
+    HDC dc;
+    HBITMAP bmp, old;
+    BITMAPINFO bi = {{ sizeof(BITMAPINFOHEADER), 40, -24, 1, 32, BI_RGB }};
+    DWORD *bits;
+    BOOL out;
+    if (theme == see_through_theme) return last_out;
+    see_through_theme = theme;
+    last_out = FALSE;
+    if (!IsThemeBackgroundPartiallyTransparent (theme, HP_HEADERITEM, HIS_NORMAL)) return FALSE;
+    dc = CreateCompatibleDC (0);
+    bmp = CreateDIBSection (dc, &bi, DIB_RGB_COLORS, (void **)&bits, NULL, 0);
+    if (!bmp) { DeleteDC (dc); return FALSE; }
+    old = SelectObject (dc, bmp);
+    memset (bits, 0, 40 * 24 * 4);
+    DrawThemeBackground (theme, dc, HP_HEADERITEM, HIS_NORMAL, &r, NULL);
+    out = !(bits[12 * 40 + 20] & 0xffffff);
+    memset (bits, 0xff, 40 * 24 * 4);
+    DrawThemeBackground (theme, dc, HP_HEADERITEM, HIS_NORMAL, &r, NULL);
+    out = out && (bits[12 * 40 + 20] & 0xffffff) == 0xffffff;
+    SelectObject (dc, old);
+    DeleteObject (bmp);
+    DeleteDC (dc);
+    last_out = out;
+    return out;
+}
+
+/* flxp: Vista-era styles (5112's aero) have see-through header items (a
+ * separator line, glows for hot/pressed) and a see-through Header background:
+ * the bar is the window colour under them. XP-era items are opaque but for a
+ * colour-keyed edge: nothing drawn, XP's look does not change. */
+static BOOL header_see_through_background (HTHEME theme, HDC hdc, const RECT *r)
+{
+    if (!header_items_see_through (theme)) return FALSE;
+    FillRect (hdc, r, GetSysColorBrush (COLOR_WINDOW));
+    if (IsThemePartDefined (theme, 0, 0))
+        DrawThemeBackground (theme, hdc, 0, 0, r, NULL);
+    return TRUE;
+}
