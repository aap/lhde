+/* flxp: horizontal space a band takes besides its cx (XP _FudgeWidth without the edge) */
+#define BAND_MARGINS_CX(infoPtr) ((infoPtr)->mBand.cxLeftWidth + (infoPtr)->mBand.cxRightWidth)
