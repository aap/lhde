     /* handle fontsize > bitmap_height */
     top = (h>bm.bmHeight) ? rect->top+(h-bm.bmHeight)/2 : rect->top;
     left=rect->left;
+    /* flxp: a 32 bpp bitmap is drawn with its (premultiplied) alpha and is not
+     * inverted when the item is highlighted (as Windows since Vista; the start
+     * menu's program icons) */
+    if (bm.bmBitsPixel == 32 && !IS_MAGIC_BITMAP(hbmToDraw))
+    {
+        BLENDFUNCTION bf = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+        int bw = min( w, bm.bmWidth - bmp_xoffset ), bh = min( h, bm.bmHeight );
+        if (w > bw) left += (w - bw) / 2;
+        GdiAlphaBlend( hdc, left, top, bw, bh, hdcMem, bmp_xoffset, 0, bw, bh, bf );
+        DeleteDC( hdcMem );
+        return;
+    }
     rop=((lpitem->fState & MF_HILITE) && !IS_MAGIC_BITMAP(hbmToDraw)) ? NOTSRCCOPY : SRCCOPY;
