+/* flxp: one [SysMetrics] value (factored out of MSSTYLES_ParseThemeIni for the v4 reader) */
+static void parse_sysmetric(PTHEME_FILE tf, struct PARSECOLORSTATE *colorState,
+                            struct PARSENONCLIENTSTATE *nonClientState, BOOL setMetrics,
+                            int iPropertyPrimitive, int iPropertyId, LPCWSTR lpValue, DWORD dwValueLen)
+{
+    if(iPropertyId >= TMT_FIRSTCOLOR && iPropertyId <= TMT_LASTCOLOR) {
+        if (!parse_handle_color_property (colorState, iPropertyId,
+            lpValue, dwValueLen))
+            FIXME("Invalid color value for %d\n", iPropertyId);
+    }
+    else if (setMetrics && (iPropertyId == TMT_FLATMENUS)) {
+        BOOL flatMenus = (*lpValue == 'T') || (*lpValue == 't');
+        SystemParametersInfoW (SPI_SETFLATMENU, 0, (PVOID)(INT_PTR)flatMenus, 0);
+    }
+    else if ((iPropertyId >= TMT_FIRSTFONT)
+        && (iPropertyId <= TMT_LASTFONT))
+    {
+        if (!parse_handle_nonclient_font (nonClientState,
+            iPropertyId, lpValue, dwValueLen))
+            FIXME("Invalid font value for %d\n", iPropertyId);
+    }
+    else if ((iPropertyId >= TMT_FIRSTSIZE)
+        && (iPropertyId <= TMT_LASTSIZE))
+    {
+        if (!parse_handle_nonclient_size (nonClientState,
+            iPropertyId, lpValue, dwValueLen))
+            FIXME("Invalid size value for %d\n", iPropertyId);
+    }
+    /* Catch all metrics, including colors */
+    MSSTYLES_AddMetric(tf, iPropertyPrimitive, iPropertyId, lpValue, dwValueLen);
+}
+
+/* flxp: the Longhorn-compiled format: the records of the selected variant,
+ * already in the ini's text form (src/uxtheme/v4.cpp) */
+static void MSSTYLES_ParseV4(PTHEME_FILE tf, BOOL setMetrics)
+{
+    const struct flxp_v4_record *r;
+    int i, n = FLXP_V4_Records(tf->v4, &r);
+    struct PARSECOLORSTATE colorState;
+    struct PARSENONCLIENTSTATE nonClientState;
+    PTHEME_CLASS cls;
+    PTHEME_PARTSTATE ps;
+
+    parse_init_color (&colorState);
+    parse_init_nonclient (&nonClientState);
+    for (i = 0; i < n; i++, r++) {
+        if (!*r->app && !lstrcmpiW(r->cls, L"SysMetrics")) {
+            parse_sysmetric(tf, &colorState, &nonClientState, setMetrics, r->prim, r->id, r->value, r->len);
+            continue;
+        }
+        cls = MSSTYLES_AddClass(tf, r->app, r->cls);
+        ps = MSSTYLES_AddPartState(cls, r->part, r->state);
+        MSSTYLES_AddProperty(ps, r->prim, r->id, r->value, r->len, !lstrcmpiW(r->cls, L"globals"));
+    }
+    if (setMetrics)
+    {
+        parse_apply_color (&colorState);
+        parse_apply_nonclient (&nonClientState);
+    }
+}
