+/* flxp: an edge piece of a nine-grid: sized (tiled/stretched) along the edge
+ * and, when the margins were shrunk, scaled across it (XP ninegrid2.cpp).
+ * along_x: the piece runs horizontally (top/bottom edge). */
+static BOOL UXTHEME_SidedBlt (HDC hdcDst, int xDst, int yDst, int wDst, int hDst,
+                              HDC hdcSrc, int xSrc, int ySrc, int wSrc, int hSrc,
+                              BOOL along_x, int sizingtype, INT transparent, COLORREF transcolor)
+{
+    HDC hdcTemp;
+    HBITMAP bmp, old;
+    BOOL ret;
+    int wTemp = along_x ? wDst : wSrc, hTemp = along_x ? hSrc : hDst;
+
+    if (along_x ? (hDst == hSrc) : (wDst == wSrc))
+        return UXTHEME_SizedBlt (hdcDst, xDst, yDst, wDst, hDst, hdcSrc, xSrc, ySrc, wSrc, hSrc,
+                                 sizingtype, transparent, transcolor);
+    if (wDst <= 0 || hDst <= 0) return TRUE;
+    /* size along the edge at the source thickness, then scale across */
+    hdcTemp = CreateCompatibleDC(hdcSrc);
+    bmp = CreateCompatibleBitmap(hdcSrc, wTemp, hTemp);
+    old = SelectObject(hdcTemp, bmp);
+    ret = UXTHEME_SizedBlt (hdcTemp, 0, 0, wTemp, hTemp, hdcSrc, xSrc, ySrc, wSrc, hSrc,
+                            sizingtype, ALPHABLEND_NONE, 0);
+    if (ret)
+        ret = UXTHEME_StretchBlt (hdcDst, xDst, yDst, wDst, hDst, hdcTemp, 0, 0, wTemp, hTemp,
+                                  transparent, transcolor);
+    SelectObject(hdcTemp, old);
+    DeleteObject(bmp);
+    DeleteDC(hdcTemp);
+    return ret;
+}
