 {
     DWORD item = 0;
+    /* flxp: v4 styles (src/uxtheme/v4.cpp) give enum values as numbers */
+    if(pszValueName[0] >= '0' && pszValueName[0] <= '9') {
+        int v = 0;
+        LPCWSTR p = pszValueName;
+        while(*p >= '0' && *p <= '9') v = v * 10 + (*p++ - '0');
+        if(*p) return FALSE;
+        if(dwValue) *dwValue = v;
+        return TRUE;
+    }
