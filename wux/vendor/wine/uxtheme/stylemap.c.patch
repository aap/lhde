+/**********************************************************************
+ * flxp: reverse lookups for libuxtheme's listings (src/uxtheme)
+ */
+BOOL MSSTYLES_LookupPartStateName(LPCWSTR pszClass, int iPartId, int iStateId, LPCWSTR *pszPart, LPCWSTR *pszState)
+{
+    unsigned int i;
+    const MSSTYLES_CLASS_MAP *map;
+
+    if(pszPart) *pszPart = NULL;
+    if(pszState) *pszState = NULL;
+    for(i=0; i<ARRAY_SIZE(mapClass); i++) {
+        if(lstrcmpiW(mapClass[i].pszClass, pszClass)) continue;
+        for(map = mapClass[i].lpMap; *map->szName; map++) {
+            if(pszPart && iPartId && map->dwPartID == iPartId && map->dwStateID == 0 && !*pszPart)
+                *pszPart = map->szName;
+            if(pszState && iStateId && map->dwPartID == iPartId && map->dwStateID == iStateId && !*pszState)
+                *pszState = map->szName;
+        }
+        return TRUE;
+    }
+    return FALSE;
+}
+
+LPCWSTR MSSTYLES_LookupPropertyName(int iPropertyId, int *dwPrimitive)
+{
+    unsigned int i;
+    for(i=0; i<ARRAY_SIZE(mapProperty); i++)
+        if(mapProperty[i].dwPropertyID == iPropertyId) {
+            if(dwPrimitive) *dwPrimitive = mapProperty[i].dwPrimitiveType;
+            return mapProperty[i].szPropertyName;
+        }
+    return NULL;
+}
+
+LPCWSTR MSSTYLES_LookupEnumName(int dwEnum, int dwValue)
+{
+    DWORD item;
+    for(item = 0; *mapEnum[item].szValueName; item++)
+        if(mapEnum[item].dwEnum == dwEnum && mapEnum[item].dwValue == dwValue)
+            return mapEnum[item].szValueName;
+    return NULL;
+}
