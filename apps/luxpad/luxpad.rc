/*
 * PROJECT:    luxpad, lhde's notepad (from ReactOS Notepad: base/applications/notepad/rsrc.rc and lang/en-US.rc)
 * LICENSE:    LGPL-2.1-or-later (https://spdx.org/licenses/LGPL-2.1-or-later)
 * PURPOSE:    Providing a Windows-compatible simple text editor
 * COPYRIGHT:  Copyright 1997,98 Marcel Baur <mbaur@g26.ethz.ch>
 *             Copyright 2002 Sylvain Petreolle <spetreolle@yahoo.fr>
 *
 * The English resources only. The menu is XP's notepad's (no New Window item: its Ctrl+Shift+N stays; Page Setup, Print and
 * Help Topics are gone with printing and help; About names luxpad); the Go To dialog has XP's caption and label; the
 * status bar's text is XP's "Ln, Col"; F5 inserts XP's short time and date (main.cpp). The Encoding and line-end boxes
 * under the Save As dialog are ReactOS's template (XP has the Encoding box alone). The icon is ReactOS's notepad.ico.
 * Build: make apps/luxpad/luxpad.res (mingw windres; the .res is checked in); embedded by main.cpp.
 */
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

#pragma code_page(65001)

IDI_NPICON ICON "luxpad.ico"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

ID_ACCEL ACCELERATORS
BEGIN
    "^A", CMD_SELECT_ALL
    "^C", CMD_COPY
    "^F", CMD_SEARCH
    "^G", CMD_GOTO
    "H", CMD_REPLACE, VIRTKEY, CONTROL
    "^N", CMD_NEW
    "N", CMD_NEW_WINDOW, VIRTKEY, CONTROL, SHIFT
    "^O", CMD_OPEN
    "^S", CMD_SAVE
    "^V", CMD_PASTE
    "^X", CMD_CUT
    "^Z", CMD_UNDO
    VK_F3, CMD_SEARCH_NEXT, VIRTKEY
    VK_F3, CMD_SEARCH_PREV, VIRTKEY, SHIFT
    VK_F5, CMD_TIME_DATE, VIRTKEY
END

MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N", CMD_NEW
        MENUITEM "&Open...\tCtrl+O", CMD_OPEN
        MENUITEM "&Save\tCtrl+S", CMD_SAVE
        MENUITEM "Save &As...", CMD_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "E&xit", CMD_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z", CMD_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X", CMD_CUT
        MENUITEM "&Copy\tCtrl+C", CMD_COPY
        MENUITEM "&Paste\tCtrl+V", CMD_PASTE
        MENUITEM "De&lete\tDel", CMD_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Find...\tCtrl+F", CMD_SEARCH
        MENUITEM "Find &Next\tF3", CMD_SEARCH_NEXT
        MENUITEM "&Replace...\tCtrl+H", CMD_REPLACE
        MENUITEM "&Go To...\tCtrl+G", CMD_GOTO
        MENUITEM SEPARATOR
        MENUITEM "Select &All\tCtrl+A", CMD_SELECT_ALL
        MENUITEM "Time/&Date\tF5", CMD_TIME_DATE
    END
    POPUP "F&ormat"
    BEGIN
        MENUITEM "&Word Wrap", CMD_WRAP
        MENUITEM "&Font...", CMD_FONT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Status Bar", CMD_STATUSBAR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About luxpad", CMD_HELP_ABOUT_NOTEPAD
    END
END

/* Dialog 'Encoding': a child of the Save As dialog, its controls under the dialog's own (OFN_ENABLETEMPLATE) */
DIALOG_ENCODING DIALOGEX 0, 0, 256, 44
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPSIBLINGS | WS_CAPTION | WS_SYSMENU
FONT 8, "MS Shell Dlg"
CAPTION "Encoding"
BEGIN
    COMBOBOX ID_ENCODING, 124, 0, 125, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Encoding:", 0x155, 65, 2, 56, 12
    COMBOBOX ID_EOLN, 124, 18, 125, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Line endings:", 0x156, 65, 20, 56, 12
END

/* Dialog 'Go To' */
DIALOG_GOTO DIALOGEX 0, 0, 165, 50
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 8, "MS Shell Dlg"
CAPTION "Go To Line"
BEGIN
    LTEXT "&Line number:", 0x155, 5, 12, 47, 12
    EDITTEXT ID_LINENUMBER, 54, 10, 106, 12, ES_NUMBER
    DEFPUSHBUTTON "OK", IDOK, 75, 30, 40, 15
    PUSHBUTTON "Cancel", IDCANCEL, 120, 30, 40, 15
END

STRINGTABLE
BEGIN
    STRING_NOTEPAD "luxpad"
    STRING_ERROR "ERROR"
    STRING_WARNING "WARNING"
    STRING_INFO "Information"
    STRING_UNTITLED "Untitled"
    STRING_ALL_FILES "All Files (*.*)"
    STRING_TEXT_FILES_TXT "Text Documents (*.txt)"
    STRING_TOOLARGE "File '%s' is too large for luxpad.\n\
Please use a different editor."
    STRING_NOTEXT "You didn't enter any text.\n\
Please type something and try again"
    STRING_DOESNOTEXIST "Cannot find the %s file.\n\n\
Do you want to create a new file?"
    STRING_NOTSAVED "The text in the %s file has changed.\n\n\
Do you want to save the changes?"
    STRING_NOTFOUND "%s\nFile not found.\nPlease verify the correct file name was given."
    STRING_OUT_OF_MEMORY "Not enough memory to complete this task.\n\
Close one or more applications to increase the amount of\nfree memory."
    STRING_CANNOTFIND "Cannot find ""%s"""
    STRING_ANSI "ANSI (UTF-8)"
    STRING_UNICODE "Unicode"
    STRING_UNICODE_BE "Unicode big endian"
    STRING_UTF8 "UTF-8"
    STRING_UTF8_BOM "UTF-8 with BOM"
    STRING_CRLF "Windows (CR + LF)"
    STRING_LF "Unix (LF)"
    STRING_CR "Mac (CR)"
    STRING_LINE_COLUMN "   Ln %d, Col %d"
    STRING_DEFAULTFONT "Lucida Console"
    STRING_LINE_NUMBER_OUT_OF_RANGE "The line number is beyond the total number of lines"

    STRING_TEXT_DOCUMENT "Text Document"
    STRING_NOTEPAD_AUTHORS "Copyright 1997,98 Marcel Baur, 2000 Mike McCormack, 2002 Sylvain Petreolle, 2002 Andriy Palamarchuk, 2019-2023 Katayama Hirofumi MZ"
    STRING_ABOUT "luxpad, lhde's notepad: ReactOS Notepad on wux.\n\n%s\n\nGNU LGPL 2.1 or later; part of lhde (GNU GPL 2)."
END
