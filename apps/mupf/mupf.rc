/* mupf's menu, accelerators and dialogs, in dialog units for "MS Shell Dlg" 8 like flxp's (flxp/rc/explorer.rc).
 *
 * The menu is in the idiom of XP's programs (File, Edit, View, Go, Help); its items and keys are Acrobat Reader 6's where
 * Acrobat had one (View > Page Layout's four layouts, Zoom In Ctrl++ and Zoom Out Ctrl+-, Actual Size Ctrl+1, Fit Page
 * Ctrl+0, Fit Width Ctrl+2, Full Screen Ctrl+L, Document Properties Ctrl+D, Find Ctrl+F, F4 for the navigation pane,
 * Back and Forward Alt+Left and Alt+Right). Go To Page is Ctrl+G (notepad's Go To, where Acrobat had Ctrl+N); Ctrl++ is
 * Ctrl+= or Ctrl+Shift+= alike, so rotating is Ctrl+] and Ctrl+[ (mupdf's ] and [) rather than Acrobat's Ctrl+Shift++ and
 * Ctrl+Shift+-; Show Cover Page is Acrobat 7's. The Go To Page dialog has notepad's Go To layout.
 * Build: make apps/mupf/mupf.res (mingw windres; the .res is checked in); embedded by mupf.cpp.
 */
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

#pragma code_page(65001)

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

IDM_MAIN MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open...\tCtrl+O", CMD_OPEN
        MENUITEM "&Close\tCtrl+W", CMD_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "Document P&roperties...\tCtrl+D", CMD_PROPERTIES
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tCtrl+Q", CMD_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Find...\tCtrl+F", CMD_FIND
        MENUITEM "Find &Next\tF3", CMD_FIND_NEXT
        MENUITEM "Find &Previous\tShift+F3", CMD_FIND_PREV
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar", CMD_TOOLBAR
        MENUITEM "Status &Bar", CMD_STATUSBAR
        MENUITEM "&Contents\tF4", CMD_CONTENTS
        MENUITEM SEPARATOR
        MENUITEM "Zoom &In\tCtrl++", CMD_ZOOM_IN
        MENUITEM "Zoom &Out\tCtrl+-", CMD_ZOOM_OUT
        MENUITEM "&Actual Size\tCtrl+1", CMD_ACTUAL
        MENUITEM "Fit &Page\tCtrl+0", CMD_FIT_PAGE
        MENUITEM "Fit &Width\tCtrl+2", CMD_FIT_WIDTH
        MENUITEM SEPARATOR
        POPUP "Page &Layout"
        BEGIN
            MENUITEM "&Single Page", CMD_SINGLE
            MENUITEM "&Continuous", CMD_CONTINUOUS
            MENUITEM "&Facing", CMD_FACING
            MENUITEM "Continuous - F&acing", CMD_CONT_FACING
            MENUITEM SEPARATOR
            MENUITEM "Show Co&ver Page", CMD_COVER
        END
        MENUITEM "Rotate Cloc&kwise\tCtrl+]", CMD_ROT_CW
        MENUITEM "Rotate Counterclock&wise\tCtrl+[", CMD_ROT_CCW
        MENUITEM SEPARATOR
        MENUITEM "F&ull Screen\tCtrl+L", CMD_FULLSCREEN
    END
    POPUP "&Go"
    BEGIN
        MENUITEM "&First Page\tHome", CMD_FIRST
        MENUITEM "&Previous Page\tPage Up", CMD_PREV
        MENUITEM "&Next Page\tPage Down", CMD_NEXT
        MENUITEM "&Last Page\tEnd", CMD_LAST
        MENUITEM SEPARATOR
        MENUITEM "&Go To Page...\tCtrl+G", CMD_GOTO
        MENUITEM SEPARATOR
        MENUITEM "&Back\tAlt+Left", CMD_BACK
        MENUITEM "F&orward\tAlt+Right", CMD_FORWARD
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About mupf", CMD_ABOUT
    END
END

IDA_MAIN ACCELERATORS
BEGIN
    "^O", CMD_OPEN
    "^W", CMD_CLOSE
    "^D", CMD_PROPERTIES
    "^Q", CMD_EXIT
    "^F", CMD_FIND
    VK_F3, CMD_FIND_NEXT, VIRTKEY
    VK_F3, CMD_FIND_PREV, VIRTKEY, SHIFT
    VK_F4, CMD_CONTENTS, VIRTKEY
    VK_OEM_PLUS, CMD_ZOOM_IN, VIRTKEY, CONTROL
    VK_ADD, CMD_ZOOM_IN, VIRTKEY, CONTROL
    VK_OEM_MINUS, CMD_ZOOM_OUT, VIRTKEY, CONTROL
    VK_SUBTRACT, CMD_ZOOM_OUT, VIRTKEY, CONTROL
    "1", CMD_ACTUAL, VIRTKEY, CONTROL
    "0", CMD_FIT_PAGE, VIRTKEY, CONTROL
    "2", CMD_FIT_WIDTH, VIRTKEY, CONTROL
    VK_OEM_PLUS, CMD_ZOOM_IN, VIRTKEY, CONTROL, SHIFT
    VK_OEM_MINUS, CMD_ZOOM_OUT, VIRTKEY, CONTROL, SHIFT
    VK_OEM_6, CMD_ROT_CW, VIRTKEY, CONTROL
    VK_OEM_4, CMD_ROT_CCW, VIRTKEY, CONTROL
    "^L", CMD_FULLSCREEN
    "^G", CMD_GOTO
END

IDD_GOTO DIALOGEX 0, 0, 165, 50
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 8, "MS Shell Dlg"
CAPTION "Go To Page"
BEGIN
    LTEXT "&Page number:", -1, 5, 12, 47, 12
    EDITTEXT IDC_GOTO_PAGE, 54, 10, 50, 12, ES_NUMBER
    LTEXT "", IDC_GOTO_OF, 108, 12, 52, 12
    DEFPUSHBUTTON "OK", IDOK, 75, 30, 40, 15
    PUSHBUTTON "Cancel", IDCANCEL, 120, 30, 40, 15
END

/* a protected document: Acrobat 6's Password dialog ("'NAME' is protected. Please enter a Document Open Password."), its
   layout mupf's */
IDD_PASSWORD DIALOGEX 0, 0, 220, 76
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 8, "MS Shell Dlg"
CAPTION "Password"
BEGIN
    LTEXT "", IDC_PASSWORD_TEXT, 7, 7, 206, 18, SS_NOPREFIX
    LTEXT "&Enter Password:", -1, 7, 31, 58, 12
    EDITTEXT IDC_PASSWORD, 66, 29, 147, 12, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "", IDC_PASSWORD_NOTE, 7, 46, 206, 8
    DEFPUSHBUTTON "OK", IDOK, 109, 57, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 163, 57, 50, 14
END

/* Help > About: the layout of flxp's message box (IDD_MESSAGE), as the skeleton's */
IDD_ABOUT DIALOGEX 0, 0, 220, 62
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About mupf"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            "", IDC_ABOUT_ICON, 7, 7, 21, 20
    LTEXT           "mupf: lhde's document viewer.\nPDF, XPS, EPUB and comic books, drawn by mupdf.", IDC_ABOUT_TEXT, 41, 11, 172, 26, SS_NOPREFIX
    DEFPUSHBUTTON   "OK", IDOK, 163, 41, 50, 14
END
