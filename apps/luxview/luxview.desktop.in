[Desktop Entry]
Type=Application
Name=luxview
GenericName=Image Viewer
Comment=View pictures the Windows XP way
Exec=@BINDIR@/luxview %F
TryExec=@BINDIR@/luxview
Terminal=false
MimeType=image/png;image/jpeg;image/pjpeg;image/bmp;image/x-bmp;image/x-ms-bmp;image/vnd.microsoft.icon;image/x-icon;image/x-ico;image/x-win-bitmap;image/webp;
Categories=Graphics;RasterGraphics;Viewer;
StartupWMClass=luxview
