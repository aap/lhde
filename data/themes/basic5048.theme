; Longhorn 5048 without composition (aap's themes.txt: "basic5048"): 5048's own Window class (the opaque frame of its
; aero.msstyles), the classic taskbar, the vision header (luxnav) instead of the faithful one
[Theme]
name     = Basic (5048)
build    = 5048

[VisualStyle]
style    = aero5048
color    = NormalColor       ; its only scheme
size     = Normal

[Glass]
frames         = aero5048    ; the uDWM bitmaps' glass, for aero5048 (composition on)
frames_classic = none        ; the style's own decorations
composition    = off

[Shell]
taskbar  = classic

[Explorer]
chrome   = longhorn
navbar   = vision
navbar_preset = concept     ; a named luxnav preset (data/navbar/vision.ini); the Vista era has no header sizes
taskpane = bottom            ; the task band under the list, close to Vista's details pane (a choice, not 5048's/5112's)

[Desktop]
wallpaper = 5048/Longhorn    ; Windows/web/Wallpaper/Longhorn.jpg: the glass facade
mode      = fill
icons     = longhorn4074
