; Windows XP's Luna, Metallic: the real XP style (styles/luna, from the Server 2003 ISO; decision 2), else Longhorn's copy
; (luna4051, luna4074). The XP explorer, the classic taskbar; the classic frames tuned from 4051's copy (luna4051-silver)
[Theme]
name     = Windows XP (Luna, Silver)

[VisualStyle]
style    = luna
color    = Metallic
size     = NormalSize

[Glass]
frames         = none
frames_classic = luna4051-silver
composition    = off

[Shell]
taskbar  = classic

[Explorer]
chrome   = xp
navbar   = none

[Desktop]
wallpaper = 5048/winxp
mode      = fill
icons     = xp
