; Windows 2000 icons and toolbar art, read by resource id from lhde-import's resources/2k (Windows 2000 SP4's
; shell32.dll and browseui.dll; docs/history/flxp-NOTES.md "XP and 2000 art by resource id"). Format: xp.theme.
[theme]
name = Windows 2000
resources = resources/2k
depth = 4        ; the 16-colour frames, as the XP-source-based 2k set had them

[icons]
folder = pe:shell32.dll#4
folder_open = pe:shell32.dll#5
document = pe:shell32.dll#1
text = pe:shell32.dll#152
drive = pe:shell32.dll#9
computer = pe:shell32.dll#16
desktop = pe:shell32.dll#35
home = pe:resources/xp/shell32.dll#235   ; not in 2000's shell32 (mydocs.dll, ...): XP's, 4-bit frames
image = pe:resources/xp/shell32.dll#226   ; not in 2000's shell32 (mydocs.dll, ...): XP's, 4-bit frames
audio = pe:resources/xp/shell32.dll#225   ; not in 2000's shell32 (mydocs.dll, ...): XP's, 4-bit frames
video = pe:resources/xp/shell32.dll#224   ; not in 2000's shell32 (mydocs.dll, ...): XP's, 4-bit frames
zip = pe:shell32.dll#4
pdf = pe:shell32.dll#2
exe = pe:shell32.dll#3
dll = pe:shell32.dll#154
html = pe:shell32.dll#178
disc = pe:resources/xp/shell32.dll#294   ; not in 2000's shell32: XP's, 4-bit frames
settings = pe:shell32.dll#151
binary = pe:shell32.dll#154
network = pe:shell32.dll#18
favorites = pe:shell32.dll#173
search = pe:shell32.dll#134
trash = pe:shell32.dll#32
help = pe:shell32.dll#24
pictures = pe:resources/xp/shell32.dll#236   ; not in 2000's shell32 (mydocs.dll, ...): XP's, 4-bit frames
control_panel = pe:shell32.dll#137
display = pe:resources/4074/desk.cpl#100
run = pe:shell32.dll#25
recent = pe:shell32.dll#21

[toolbar]
; browseui's IE5-era standard buttons (IDB_SHSTDHICOLOR 276 / HOTHICOLOR 277, 20 px; ..16 278/279)
strip = pe:browseui.dll#276
hot = pe:browseui.dll#277
size = 20
small = pe:browseui.dll#278
small_hot = pe:browseui.dll#279
small_size = 16
back = 0
forward = 1
up = 28
search = 17
folders = 43
views = 32
