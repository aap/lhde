; Windows XP icons and toolbar art, read by resource id from lhde-import's resources/xp (the Server 2003 SP1 x64
; DLLs: XP's resources; docs/flxp-NOTES.md "XP and 2000 art by resource id"). The recipe format (flxp/shell/icons.h):
; [theme] resources = resources/BUILD is the base of every relative source; pe:DLL#ID is an icon (RT_GROUP_ICON) or,
; in [toolbar], a bitmap (RT_BITMAP); a relative path starting with resources/ names another build's file.
; The ids are XP's (Longhorn 4074 keeps them).
[theme]
name = Windows XP
resources = resources/xp
depth = 32

[icons]
folder = pe:shell32.dll#4
folder_open = pe:shell32.dll#5
document = pe:shell32.dll#1
text = pe:shell32.dll#152
drive = pe:shell32.dll#9
computer = pe:shell32.dll#16
desktop = pe:shell32.dll#35
home = pe:shell32.dll#235
image = pe:shell32.dll#226
audio = pe:shell32.dll#225
video = pe:shell32.dll#224
zip = pe:shell32.dll#4
pdf = pe:shell32.dll#2
exe = pe:shell32.dll#3
dll = pe:shell32.dll#154
html = pe:shell32.dll#178
disc = pe:shell32.dll#294
settings = pe:shell32.dll#151
binary = pe:shell32.dll#154
network = pe:shell32.dll#18
favorites = pe:shell32.dll#173
search = pe:shell32.dll#134
trash = pe:shell32.dll#32
help = pe:shell32.dll#24
pictures = pe:shell32.dll#236
control_panel = pe:shell32.dll#137
run = pe:shell32.dll#25
recent = pe:shell32.dll#21

; the file dialog's small toolbar (comdlg32 loads comctl32's IDB_VIEW_SMALL_COLOR 124 / IDB_HIST_SMALL_COLOR 130)
; comes from comctl32 6.0, which is in WinSxS (ASMS01.CAB) and not imported: comctl32's own images stand in.
; resources/xp/comctl32.dll is 5.82 (the Windows 2000 art).

[toolbar]
; shell32's standard-buttons strip (IDB_TB_SH_DEF_24 / HOT_24, _16): HIST (5) + STD (15) + VIEW images
strip = pe:shell32.dll#214
hot = pe:shell32.dll#215
size = 24
small = pe:shell32.dll#216
small_hot = pe:shell32.dll#217
small_size = 16
back = 0
forward = 1
up = 28
search = 17
folders = 43
views = 32
; browseui's brand band (XP loads shell32's IDB_BRAND_BITMAP_MICRO 240) and the
; address band's Go button (shell32 IDB_TB_GO_DEF_20 / _HOT_20)
brand = pe:shell32.dll#240
go = pe:shell32.dll#230
go_hot = pe:shell32.dll#231
go_size = 20
; explorer bar (Folders) close button: browseui IDB_BROWSERTOOLBAR
close = pe:browseui.dll#545
