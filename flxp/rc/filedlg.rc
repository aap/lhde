/* flxp's file dialog (src/filedlg). The Open/Save template is XP's
 * NEWFILEOPENV2ORD from the public SDK's fileopen.dlg (the layout apps were
 * meant to copy for custom templates), in "MS Shell Dlg" 8 dialog units.
 * Build: make rc/filedlg.res (mingw windres); embedded by filedlg.cpp. */
#include <windows.h>
#include <commctrl.h>
#include <dlgs.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

IDD_FILEDLG DIALOG 0, 0, 370, 237
STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN | WS_THICKFRAME
CAPTION "Open"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Look &in:", stc4, 4, 7, 57, 8, SS_NOTIFY, WS_EX_RIGHT
    COMBOBOX        cmb2, 66, 4, 174, 300, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", stc1, 248, 4, 80, 14, NOT WS_GROUP | NOT WS_VISIBLE
    CONTROL         "", ctl1, "ToolbarWindow32", WS_TABSTOP | CCS_NODIVIDER | CCS_NOPARENTALIGN | CCS_NORESIZE | TBSTYLE_WRAPABLE | TBSTYLE_FLAT | TBSTYLE_TOOLTIPS | TBSTYLE_CUSTOMERASE,
                    4, 22, 58, 208, WS_EX_CLIENTEDGE
    LISTBOX         lst1, 66, 22, 300, 156, LBS_SORT | LBS_NOINTEGRALHEIGHT | LBS_MULTICOLUMN | WS_HSCROLL | NOT WS_VISIBLE
    LTEXT           "File &name:", stc3, 67, 187, 58, 8, SS_NOTIFY
    EDITTEXT        edt1, 130, 184, 164, 12, WS_TABSTOP | ES_AUTOHSCROLL | NOT WS_VISIBLE
    CONTROL         "", cmb13, "ComboBoxEx32", WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWN | CBS_AUTOHSCROLL, 130, 184, 164, 150
    LTEXT           "Files of &type:", stc2, 67, 203, 58, 8, SS_NOTIFY
    COMBOBOX        cmb1, 130, 201, 164, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Open as &read-only", chx1, 130, 217, 160, 8, WS_TABSTOP
    DEFPUSHBUTTON   "&Open", IDOK, 316, 184, 50, 14, WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 316, 200, 50, 14, WS_GROUP
    PUSHBUTTON      "&Help", pshHelp, 316, 218, 50, 14, WS_GROUP
END

/* The Longhorn look (src/filedlg/filedlg.cpp "Longhorn"): the controls the
 * dialog manager needs (mnemonics, tab order, the default button) with
 * comdlg32's ids so the accept logic is shared; the header, command bar,
 * places pane and list are created in code and everything is laid out in
 * pixels there. */
IDD_FILEDLG_LH DIALOGEX 0, 0, 440, 330
STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN | WS_THICKFRAME
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Open"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "File &name:", stc3, 7, 280, 58, 8, SS_NOTIFY
    EDITTEXT        edt1, 70, 278, 164, 12, WS_TABSTOP | ES_AUTOHSCROLL | NOT WS_VISIBLE
    CONTROL         "", cmb13, "ComboBoxEx32", WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWN | CBS_AUTOHSCROLL, 70, 278, 200, 150
    LTEXT           "Files of &type:", stc2, 7, 296, 58, 8, SS_NOTIFY
    COMBOBOX        cmb1, 70, 294, 200, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Open as &read-only", chx1, 70, 312, 160, 10, WS_TABSTOP
    DEFPUSHBUTTON   "&Open", IDOK, 330, 278, 50, 14, WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 384, 278, 50, 14, WS_GROUP
    CONTROL         "&Hide Explorer", IDC_FD_HIDE, "Button", BS_OWNERDRAW | WS_TABSTOP, 7, 312, 70, 12
END

/* A message box (the shim's MessageBoxW is a stub): XP's user32 layout,
 * icon at 7,7, text at 41; resized to the text at run time. */
IDD_FD_MESSAGE DIALOGEX 0, 0, 240, 62
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            "", IDC_FD_MSG_ICON, 7, 7, 21, 20
    LTEXT           "", IDC_FD_MSG_TEXT, 41, 9, 192, 28, SS_NOPREFIX
    DEFPUSHBUTTON   "&Yes", IDYES, 66, 41, 50, 14
    PUSHBUTTON      "&No", IDNO, 120, 41, 50, 14
    PUSHBUTTON      "OK", IDOK, 95, 41, 50, 14
END
