/* The explorer's own dialogs (flxp, not Wine). Layouts follow XP's shell32
 * dialogs where there is one (Open With, Confirm File Delete, the General
 * property page), in dialog units for "MS Shell Dlg" 8.
 * Build: make rc/explorer.res (mingw windres); embedded by dialogs.cpp. */
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

IDD_OPENWITH DIALOGEX 0, 0, 260, 232
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Open With"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            "", IDC_OW_ICON, 7, 7, 21, 20
    LTEXT           "Choose the program you want to use to open this file:", -1, 40, 7, 213, 8
    LTEXT           "File:", -1, 40, 22, 20, 8
    LTEXT           "", IDC_OW_FILE, 62, 22, 191, 8, SS_NOPREFIX
    GROUPBOX        "&Programs", -1, 7, 38, 246, 140
    CONTROL         "", IDC_OW_TREE, "SysTreeView32", TVS_HASBUTTONS | TVS_LINESATROOT | TVS_SHOWSELALWAYS | TVS_DISABLEDRAGDROP | WS_BORDER | WS_TABSTOP, 14, 50, 232, 121
    LTEXT           "", IDC_OW_TYPE, 7, 184, 246, 8, SS_NOPREFIX
    AUTOCHECKBOX    "&Always use the selected program to open this kind of file", IDC_OW_ALWAYS, 7, 196, 246, 10
    DEFPUSHBUTTON   "OK", IDOK, 149, 212, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 203, 212, 50, 14
END

IDD_CONFIRMDELETE DIALOGEX 0, 0, 262, 62
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Confirm File Delete"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            "", IDC_CD_ICON, 7, 7, 21, 20
    LTEXT           "", IDC_CD_TEXT, 41, 11, 214, 26, SS_NOPREFIX
    DEFPUSHBUTTON   "&Yes", IDYES, 151, 41, 50, 14
    PUSHBUTTON      "&No", IDNO, 205, 41, 50, 14
END

IDD_MESSAGE DIALOGEX 0, 0, 240, 62
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            "", IDC_MSG_ICON, 7, 7, 21, 20
    LTEXT           "", IDC_MSG_TEXT, 41, 9, 192, 28, SS_NOPREFIX
    DEFPUSHBUTTON   "OK", IDOK, 95, 41, 50, 14
END

IDD_BOOKMARKS DIALOGEX 0, 0, 300, 190
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Organize Bookmarks"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Select a bookmark to rename, move or remove it. The Bookmarks menu lists them in this order.", -1, 7, 7, 286, 16
    CONTROL         "", IDC_BM_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | LVS_SHAREIMAGELISTS | WS_BORDER | WS_TABSTOP, 7, 27, 226, 118
    PUSHBUTTON      "Move &Up", IDC_BM_UP, 240, 27, 53, 14
    PUSHBUTTON      "Move &Down", IDC_BM_DOWN, 240, 45, 53, 14
    PUSHBUTTON      "&Remove", IDC_BM_REMOVE, 240, 63, 53, 14
    LTEXT           "&Name:", -1, 7, 153, 24, 8
    EDITTEXT        IDC_BM_NAME, 33, 151, 148, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "Re&name", IDC_BM_RENAME, 185, 150, 48, 14
    DEFPUSHBUTTON   "OK", IDOK, 189, 169, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 243, 169, 50, 14
END

/* XP's Choose Details (shell32 DLG_COLUMN_SETTINGS: the columns with check boxes, Move
 * Up/Down, Show/Hide and the selected column's width); the layout is ours, in XP's style */
IDD_CHOOSEDETAILS DIALOGEX 0, 0, 253, 214
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Choose Details"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Select the details you want to display for the files in this folder.", -1, 7, 7, 239, 16
    LTEXT           "&Details:", -1, 7, 26, 60, 8
    CONTROL         "", IDC_CDT_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP, 7, 37, 175, 132
    PUSHBUTTON      "Move &Up", IDC_CDT_UP, 189, 37, 57, 14
    PUSHBUTTON      "Move Do&wn", IDC_CDT_DOWN, 189, 55, 57, 14
    PUSHBUTTON      "&Show", IDC_CDT_SHOW, 189, 73, 57, 14
    PUSHBUTTON      "&Hide", IDC_CDT_HIDE, 189, 91, 57, 14
    LTEXT           "&Width of selected column (in pixels):", -1, 7, 177, 130, 8
    EDITTEXT        IDC_CDT_WIDTH, 140, 175, 30, 12, ES_NUMBER | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 142, 193, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 196, 193, 50, 14
END

/* Edit Description...: one line kept with the file (user.lux.desc) */
IDD_EDITTEXT DIALOGEX 0, 0, 262, 78
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            "", IDC_TX_ICON, 7, 7, 21, 20
    LTEXT           "", IDC_TX_PROMPT, 41, 7, 214, 8, SS_NOPREFIX | SS_ENDELLIPSIS
    EDITTEXT        IDC_TX_TEXT, 41, 19, 214, 12, ES_AUTOHSCROLL
    LTEXT           "", IDC_TX_NOTE, 41, 36, 214, 16, SS_NOPREFIX
    DEFPUSHBUTTON   "OK", IDOK, 151, 57, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 205, 57, 50, 14
END

/* Add Tag...: tags for the selection, the folder's tags offered in the drop-down */
IDD_ADDTAG DIALOGEX 0, 0, 262, 78
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            "", IDC_TX_ICON, 7, 7, 21, 20
    LTEXT           "", IDC_TX_PROMPT, 41, 7, 214, 8, SS_NOPREFIX | SS_ENDELLIPSIS
    COMBOBOX        IDC_TX_TEXT, 41, 19, 214, 90, CBS_DROPDOWN | CBS_AUTOHSCROLL | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_TX_NOTE, 41, 36, 214, 16, SS_NOPREFIX
    DEFPUSHBUTTON   "OK", IDOK, 151, 57, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 205, 57, 50, 14
END

IDD_PROPERTIES DIALOGEX 0, 0, 227, 215
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "General"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            "", IDC_PR_ICON, 7, 7, 21, 20
    EDITTEXT        IDC_PR_NAME, 53, 11, 167, 12, ES_AUTOHSCROLL | ES_READONLY
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 7, 32, 213, 1
    LTEXT           "Type of file:", -1, 7, 40, 58, 8
    LTEXT           "", IDC_PR_TYPE, 70, 40, 150, 8, SS_NOPREFIX
    LTEXT           "Opens with:", IDC_PR_OPENSL, 7, 55, 58, 8
    LTEXT           "", IDC_PR_OPENS, 70, 55, 95, 8, SS_NOPREFIX
    PUSHBUTTON      "&Change...", IDC_PR_CHANGE, 170, 52, 50, 14
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 7, 72, 213, 1
    LTEXT           "Location:", -1, 7, 80, 58, 8
    LTEXT           "", IDC_PR_LOCATION, 70, 80, 150, 8, SS_NOPREFIX | SS_PATHELLIPSIS
    LTEXT           "Size:", -1, 7, 94, 58, 8
    LTEXT           "", IDC_PR_SIZE, 70, 94, 150, 8, SS_NOPREFIX
    LTEXT           "Contains:", IDC_PR_CONTAINSL, 7, 108, 58, 8
    LTEXT           "", IDC_PR_CONTAINS, 70, 108, 150, 8, SS_NOPREFIX
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 7, 124, 213, 1
    LTEXT           "Modified:", -1, 7, 132, 58, 8
    LTEXT           "", IDC_PR_MODIFIED, 70, 132, 150, 8, SS_NOPREFIX
    LTEXT           "Accessed:", -1, 7, 146, 58, 8
    LTEXT           "", IDC_PR_ACCESSED, 70, 146, 150, 8, SS_NOPREFIX
    LTEXT           "Changed:", -1, 7, 160, 58, 8
    LTEXT           "", IDC_PR_CHANGED, 70, 160, 150, 8, SS_NOPREFIX
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 7, 176, 213, 1
    LTEXT           "Permissions:", -1, 7, 184, 58, 8
    LTEXT           "", IDC_PR_PERMS, 70, 184, 150, 8, SS_NOPREFIX
    LTEXT           "", IDC_PR_EXTRAL, 7, 198, 58, 8
    LTEXT           "", IDC_PR_EXTRA, 70, 198, 150, 8, SS_NOPREFIX
END

/* Folder Options (Tools menu): XP's General and View pages reduced to what
 * flxp has: the default view of folders never opened (with the Longhorn
 * frame's icon size and thumbnails), Apply to All / Reset All Folders and
 * two of the advanced settings. */
IDD_FO_GENERAL DIALOGEX 0, 0, 227, 215
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "General"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Default view", -1, 7, 7, 213, 106
    LTEXT           "Folders that have not been opened before are shown in this view. Ctrl+0 shows a folder in it again.", -1, 16, 20, 196, 18
    LTEXT           "&View:", -1, 16, 46, 50, 8
    COMBOBOX        IDC_FO_VIEW, 70, 44, 140, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Icon &size:", IDC_FO_ZOOML, 16, 64, 50, 8
    COMBOBOX        IDC_FO_ZOOM, 70, 62, 140, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Show &thumbnails of pictures", IDC_FO_THUMBS, 16, 82, 194, 10
    PUSHBUTTON      "Restore &Defaults", IDC_FO_RESTORE, 146, 94, 64, 14
END

IDD_FO_VIEW DIALOGEX 0, 0, 227, 215
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "View"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Folder views", -1, 7, 7, 213, 66
    LTEXT           "You can apply the view (such as Details or Thumbnails) that you are using for this folder to all folders.", -1, 16, 20, 196, 24
    PUSHBUTTON      "Apply to &All Folders", IDC_FO_APPLYALL, 16, 50, 92, 14
    PUSHBUTTON      "&Reset All Folders", IDC_FO_RESETALL, 116, 50, 92, 14
    GROUPBOX        "Advanced settings", -1, 7, 80, 213, 64
    AUTOCHECKBOX    "&Remember each folder's view settings", IDC_FO_REMEMBER, 16, 94, 194, 10
    AUTOCHECKBOX    "Show &hidden files and folders", IDC_FO_HIDDEN, 16, 110, 194, 10
    AUTOCHECKBOX    "Display the full &path in the address bar", IDC_FO_FULLPATH, 16, 126, 194, 10
END

/* File operations (fileopui.cpp), XP's shell32 dialogs in their layout:
 * Confirm File Replace (DLG_REPLACE_FILE), Confirm Folder Replace
 * (DLG_REPLACE_FOLDER), Confirm File Move (DLG_MOVE_FILE), the progress
 * dialog (DLG_MOVECOPYPROGRESS) and a message box for the copy and rename errors that is
 * sized to its text as user32's MessageBox. The texts are filled in at run
 * time; buttons a case does not offer are removed then (copy.c
 * HideConfirmButtons). */
IDD_OP_REPLACEFILE DIALOGEX 0, 0, 280, 141
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Confirm File Replace"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON   "&Yes", IDYES, 46, 120, 53, 14
    PUSHBUTTON      "Yes to &All", IDC_OP_YESTOALL, 104, 120, 53, 14
    PUSHBUTTON      "&No", IDNO, 161, 120, 53, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 219, 120, 53, 14
    ICON            "", IDC_OP_ICON, 10, 10, 21, 20
    LTEXT           "", IDC_OP_TEXT, 41, 10, 222, 22, SS_NOPREFIX
    LTEXT           "Would you like to replace the existing file", -1, 41, 35, 180, 10, SS_NOPREFIX
    LTEXT           "(unknown date and size)", IDC_OP_OLDINFO, 79, 51, 194, 18, SS_NOPREFIX
    ICON            "", IDC_OP_OLDICON, 51, 49, 21, 20
    LTEXT           "with this one?", -1, 41, 75, 180, 10, SS_NOPREFIX
    LTEXT           "(unknown date and size)", IDC_OP_NEWINFO, 79, 91, 194, 18, SS_NOPREFIX
    ICON            "", IDC_OP_NEWICON, 51, 89, 21, 20
END

IDD_OP_REPLACEFOLDER DIALOGEX 0, 0, 275, 85
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Confirm Folder Replace"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON   "&Yes", IDYES, 41, 64, 53, 14
    PUSHBUTTON      "Yes to &All", IDC_OP_YESTOALL, 99, 64, 53, 14
    PUSHBUTTON      "&No", IDNO, 157, 64, 53, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 215, 64, 53, 14
    ICON            "", IDC_OP_ICON, 10, 10, 21, 20
    LTEXT           "", IDC_OP_TEXT, 41, 10, 222, 53, SS_NOPREFIX
END

IDD_OP_MOVEFILE DIALOGEX 0, 0, 275, 65
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Confirm File Move"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON   "&Yes", IDYES, 41, 43, 53, 14
    PUSHBUTTON      "Yes to &All", IDC_OP_YESTOALL, 99, 43, 53, 14
    PUSHBUTTON      "&No", IDNO, 157, 43, 53, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 215, 43, 53, 14
    ICON            "", IDC_OP_ICON, 10, 10, 21, 20
    LTEXT           "", IDC_OP_TEXT, 41, 14, 222, 24, SS_NOPREFIX
END

IDD_OP_PROGRESS DIALOGEX 20, 20, 250, 84
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "", IDC_OP_ANIMATE, "Static", SS_OWNERDRAW, 7, 0, 236, 25
    LTEXT           "", IDC_OP_NAME, 7, 38, 236, 10, SS_LEFTNOWORDWRAP | SS_NOPREFIX
    LTEXT           "", IDC_OP_TONAME, 7, 48, 236, 10, SS_LEFTNOWORDWRAP | SS_NOPREFIX
    CONTROL         "", IDC_OP_PROGRESS, "msctls_progress32", 0, 7, 63, 190, 8
    LTEXT           "", IDC_OP_TIMEEST, 7, 74, 192, 10, SS_NOPREFIX
    DEFPUSHBUTTON   "Cancel", IDCANCEL, 202, 63, 40, 14, NOT WS_TABSTOP
END

IDD_OP_MESSAGE DIALOGEX 0, 0, 240, 62
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            "", IDC_OP_ICON, 7, 7, 21, 20
    LTEXT           "", IDC_OP_TEXT, 41, 9, 192, 28, SS_NOPREFIX
    DEFPUSHBUTTON   "OK", IDOK, 95, 41, 50, 14
    PUSHBUTTON      "&Retry", IDRETRY, 66, 41, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 120, 41, 50, 14
    PUSHBUTTON      "&Yes", IDYES, 66, 41, 50, 14
    PUSHBUTTON      "&No", IDNO, 120, 41, 50, 14
END
