/* flxp-settings, the Display Properties (flxp, not Wine): XP desk.cpl's
 * property pages in dialog units for "MS Shell Dlg" 8. Build: make
 * rc/settings.res (mingw windres); embedded by src/settings/settings.cpp. */
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

IDD_THEMES DIALOGEX 0, 0, 246, 222
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Themes"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "A theme is a visual style plus window frames, a background and other elements that give the desktop one look.", -1, 7, 7, 232, 18
    LTEXT           "&Theme:", -1, 7, 30, 100, 8
    COMBOBOX        IDC_TH_LIST, 7, 41, 126, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Save As...", IDC_TH_SAVE, 137, 40, 52, 14
    PUSHBUTTON      "&Delete", IDC_TH_DELETE, 193, 40, 46, 14
    LTEXT           "Sample:", -1, 7, 60, 100, 8
    CONTROL         "", IDC_TH_PREVIEW, "Static", SS_OWNERDRAW, 7, 71, 232, 144
END

IDD_DESKTOP DIALOGEX 0, 0, 246, 222
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Desktop"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "", IDC_DT_PREVIEW, "Static", SS_OWNERDRAW, 60, 7, 125, 92
    LTEXT           "Bac&kground:", -1, 7, 104, 50, 8
    CONTROL         "", IDC_DT_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP | WS_GROUP, 7, 115, 178, 66
    PUSHBUTTON      "&Browse...", IDC_DT_BROWSE, 189, 115, 50, 14, WS_GROUP
    LTEXT           "&Position:", -1, 189, 136, 50, 8
    COMBOBOX        IDC_DT_MODE, 189, 146, 50, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Desktop and folder &icons:", -1, 7, 188, 90, 8
    COMBOBOX        IDC_DT_ICONS, 100, 186, 68, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_DT_ICONS_SC, 172, 186, 67, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_DT_ICONS_SRC, 100, 202, 139, 8
END

IDD_APPEARANCE DIALOGEX 0, 0, 246, 280
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Appearance"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Explorer &frame:", -1, 7, 10, 58, 8
    COMBOBOX        IDC_AP_FRAME, 66, 8, 100, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_AP_FRAME_SC, 170, 8, 69, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_AP_FRAME_SRC, 66, 23, 173, 8
    LTEXT           "&Taskbar:", -1, 7, 34, 58, 8
    COMBOBOX        IDC_AP_TASKBAR, 66, 32, 100, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_AP_TASKBAR_SC, 170, 32, 69, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_AP_TASKBAR_SRC, 66, 47, 173, 8
    LTEXT           "Side&bar:", -1, 7, 58, 58, 8
    COMBOBOX        IDC_AP_SBSTACK, 66, 56, 173, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Start menu:", -1, 7, 74, 58, 8
    COMBOBOX        IDC_AP_START, 66, 72, 100, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_AP_START_SC, 170, 72, 69, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_AP_START_SRC, 66, 87, 173, 8
    LTEXT           "&Composition:", -1, 7, 98, 58, 8
    COMBOBOX        IDC_AP_COMP, 66, 96, 100, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_AP_COMP_SC, 170, 96, 69, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_AP_COMP_SRC, 66, 111, 173, 8
    LTEXT           "&Animations:", -1, 7, 122, 58, 8
    COMBOBOX        IDC_AP_ANIM, 66, 120, 100, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_AP_ANIM_SC, 170, 120, 69, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_AP_ANIM_SRC, 66, 135, 173, 8
    GROUPBOX        "Sidebar (lux)", -1, 4, 147, 238, 58
    LTEXT           "&Mode:", -1, 13, 161, 52, 8
    COMBOBOX        IDC_AP_SBMODE, 66, 159, 100, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_AP_SBMODE_SC, 170, 159, 69, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_AP_SBMODE_SRC, 66, 174, 167, 8
    AUTOCHECKBOX    "S&how the sidebar with the classic taskbar", IDC_AP_SBCLASSIC, 13, 185, 153, 10
    COMBOBOX        IDC_AP_SBCLASSIC_SC, 170, 183, 69, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_AP_SBCLASSIC_SRC, 66, 195, 167, 8
    LTEXT           "These settings belong to the theme selected on the Themes tab. ""This theme only"" keeps a change for that theme (in its preset, or as an override of the built-in theme). ""All themes"" sets it for every theme and drops the themes' own choices. ""Theme defaults"" goes back to what each theme brings.", -1, 7, 212, 232, 42
    LTEXT           "The taskbar kind applies when the shell starts its bar again. The sidebar's place (Sidebar) is not per theme; Win+S switches it too.", -1, 7, 256, 232, 20
END

IDD_EFFECTS DIALOGEX 0, 0, 246, 222
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Effects"
FONT 8, "MS Shell Dlg"
BEGIN
    AUTOCHECKBOX    "&Use the following method to smooth edges of screen fonts:", IDC_EF_SMOOTH, 7, 8, 232, 10
    COMBOBOX        IDC_EF_METHOD, 19, 22, 120, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

IDD_SAVEAS DIALOGEX 0, 0, 200, 62
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Save Theme As"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Theme &name:", -1, 7, 9, 50, 8
    EDITTEXT        IDC_SA_NAME, 60, 7, 133, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 89, 41, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 143, 41, 50, 14
END
