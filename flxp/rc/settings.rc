/* flxp-settings, the Display Properties (flxp, not Wine): XP desk.cpl's
 * property pages in dialog units for "MS Shell Dlg" 8. Build: make
 * rc/settings.res (mingw windres); embedded by src/settings/settings.cpp. */
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

IDD_THEMES DIALOGEX 0, 0, 246, 222
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Themes"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "A theme is a visual style plus window frames, a background and other elements that give the desktop one look.", -1, 7, 7, 232, 18
    LTEXT           "&Theme:", -1, 7, 30, 100, 8
    COMBOBOX        IDC_TH_LIST, 7, 41, 126, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Save As...", IDC_TH_SAVE, 137, 40, 52, 14
    PUSHBUTTON      "&Delete", IDC_TH_DELETE, 193, 40, 46, 14
    LTEXT           "Sample:", -1, 7, 60, 100, 8
    CONTROL         "", IDC_TH_PREVIEW, "Static", SS_OWNERDRAW, 7, 71, 232, 144
END

IDD_DESKTOP DIALOGEX 0, 0, 246, 222
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Desktop"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "", IDC_DT_PREVIEW, "Static", SS_OWNERDRAW, 60, 7, 125, 92
    LTEXT           "Bac&kground:", -1, 7, 104, 50, 8
    CONTROL         "", IDC_DT_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP | WS_GROUP, 7, 115, 178, 66
    PUSHBUTTON      "&Browse...", IDC_DT_BROWSE, 189, 115, 50, 14, WS_GROUP
    LTEXT           "&Position:", -1, 189, 136, 50, 8
    COMBOBOX        IDC_DT_MODE, 189, 146, 50, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Desktop and folder &icons:", -1, 7, 188, 90, 8
    COMBOBOX        IDC_DT_ICONS, 100, 186, 139, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_DT_ICONS_SRC, 100, 202, 139, 8
END

IDD_APPEARANCE DIALOGEX 0, 0, 246, 262
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Appearance"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Explorer &frame:", -1, 7, 10, 58, 8
    COMBOBOX        IDC_AP_FRAME, 66, 8, 173, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_AP_FRAME_SRC, 66, 23, 173, 8
    LTEXT           "&Navigation bar:", -1, 7, 34, 58, 8
    COMBOBOX        IDC_AP_NAVBAR, 66, 32, 173, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_AP_NAVBAR_SRC, 66, 47, 173, 8
    LTEXT           "&Taskbar:", -1, 7, 58, 58, 8
    COMBOBOX        IDC_AP_TASKBAR, 66, 56, 173, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_AP_TASKBAR_SRC, 66, 71, 173, 8
    LTEXT           "&Start menu:", -1, 7, 82, 58, 8
    COMBOBOX        IDC_AP_START, 66, 80, 173, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_AP_START_SRC, 66, 95, 173, 8
    LTEXT           "&Composition:", -1, 7, 106, 58, 8
    COMBOBOX        IDC_AP_COMP, 66, 104, 173, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_AP_COMP_SRC, 66, 119, 173, 8
    LTEXT           "&Animations:", -1, 7, 130, 58, 8
    COMBOBOX        IDC_AP_ANIM, 66, 128, 173, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_AP_ANIM_SRC, 66, 143, 173, 8
    GROUPBOX        "Sidebar (luxshell)", -1, 4, 156, 238, 62
    LTEXT           "&Mode:", -1, 13, 170, 52, 8
    COMBOBOX        IDC_AP_SBMODE, 66, 168, 167, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_AP_SBMODE_SRC, 66, 183, 167, 8
    LTEXT           "P&lace:", -1, 13, 194, 52, 8
    COMBOBOX        IDC_AP_SBSTACK, 66, 192, 167, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "S&how the sidebar with the classic taskbar", IDC_AP_SBCLASSIC, 13, 206, 220, 10
    LTEXT           "The settings above the Sidebar belong to the theme chosen on the Themes tab: Apply keeps a change in your copy of it, ""NAME (modified)"", which Save As names. The Sidebar's are yours for every theme.", -1, 7, 222, 232, 34
END

IDD_EFFECTS DIALOGEX 0, 0, 246, 222
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Effects"
FONT 8, "MS Shell Dlg"
BEGIN
    AUTOCHECKBOX    "&Use the following method to smooth edges of screen fonts:", IDC_EF_SMOOTH, 7, 8, 232, 10
    COMBOBOX        IDC_EF_METHOD, 19, 22, 120, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

IDD_SAVEAS DIALOGEX 0, 0, 200, 62
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Save Theme As"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Theme &name:", -1, 7, 9, 50, 8
    EDITTEXT        IDC_SA_NAME, 60, 7, 133, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 89, 41, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 143, 41, 50, 14
END
