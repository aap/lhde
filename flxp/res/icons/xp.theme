; Windows XP icons, read straight from the XP SP1 source tree's .ico files
; (not redistributed here). Set nt5src= in ~/.config/flxp/flxp.ini (or
; FLXP_NT5SRC), or copy them into the data directory with make install-icons.
[theme]
name = Windows XP
base = $FLXP_NT5SRC/Source/XPSP1/NT/shell
depth = 32

[icons]
folder = shell32/folder.ico
folder_open = shell32/folderop.ico
document = shell32/document.ico
text = shell32/txtfile.ico
drive = shell32/drivehar.ico
computer = explorer/mycomp.ico
desktop = shell32/desktop.ico
home = shell32/mydocs.ico
image = shell32/pics.ico
audio = shell32/genericmusicdoc.ico
video = shell32/genvideodoc.ico
zip = shell32/folder.ico
pdf = shell32/docassoc.ico
exe = shell32/app.ico
dll = shell32/sysfile.ico
html = shell32/htt.ico
disc = shell32/cdrom.ico
settings = shell32/inifile.ico
binary = shell32/sysfile.ico
network = shell32/mynet.ico
favorites = shell32/fave.ico
search = shell32/docfind.ico
trash = shell32/recycler.ico
help = shell32/sthelp.ico
pictures = shell32/mypics.ico
control_panel = shell32/control.ico
run = shell32/strun.ico
recent = shell32/stdocs.ico

; the file dialog's small toolbar (comdlg32 loads comctl32's IDB_VIEW_SMALL_COLOR / IDB_HIST_SMALL_COLOR)
filedlg_view = comctl32/v6/viewsm.bmp
filedlg_hist = comctl32/v6/histsm.bmp

[toolbar]
; shell32's standard-buttons strip: HIST (5) + STD (15) + VIEW images, 24px
strip = shell32/tb_sh_def_24.bmp
hot = shell32/tb_sh_hot_24.bmp
size = 24
small = shell32/tb_sh_def_16.bmp
small_hot = shell32/tb_sh_hot_16.bmp
small_size = 16
back = 0
forward = 1
up = 28
search = 17
folders = 43
views = 32
; browseui brand band (XP loads shell32's IDB_BRAND_BITMAP_MICRO) and the
; address band's Go button (shell32 IDB_TB_GO_DEF_20 / _HOT_20)
brand = shell32/brand_sml.bmp
go = shell32/tb_go_def_20.bmp
go_hot = shell32/tb_go_hot_20.bmp
go_size = 20
; explorer bar (Folders) close button: browseui IDB_BROWSERTOOLBAR
close = browseui/browtb.bmp
