; Windows 2000 look: the 16-colour frames of the XP source icons and the
; 20px IE5-era standard buttons.
; Files from nt5src (nt5src= in flxp.ini), or make install-icons.
[theme]
name = Windows 2000
base = $FLXP_NT5SRC/Source/XPSP1/NT/shell
depth = 4        ; the 16-colour frames of the same icons are the Windows 2000 set

[icons]
folder = shell32/folder.ico
folder_open = shell32/folderop.ico
document = shell32/document.ico
text = shell32/txtfile.ico
drive = shell32/drivehar.ico
computer = explorer/mycomp.ico
desktop = shell32/desktop.ico
home = shell32/mydocs.ico
image = shell32/pics.ico
audio = shell32/genericmusicdoc.ico
video = shell32/genvideodoc.ico
zip = shell32/folder.ico
pdf = shell32/docassoc.ico
exe = shell32/app.ico
dll = shell32/sysfile.ico
html = shell32/htt.ico
disc = shell32/cdrom.ico
settings = shell32/inifile.ico
binary = shell32/sysfile.ico
network = shell32/mynet.ico
favorites = shell32/fave.ico
search = shell32/docfind.ico
trash = shell32/recycler.ico
help = shell32/sthelp.ico
pictures = shell32/mypics.ico
control_panel = shell32/control.ico
run = shell32/strun.ico
recent = shell32/stdocs.ico

[toolbar]
; shell32's standard-buttons strip: HIST (5) + STD (15) + VIEW images, 24px
strip = browseui/shdefhi.bmp
hot = browseui/shhothi.bmp
size = 20
small = browseui/shdef16h.bmp
small_hot = browseui/shhot16h.bmp
small_size = 16
back = 0
forward = 1
up = 28
search = 17
folders = 43
views = 32
