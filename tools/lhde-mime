#!/usr/bin/env python3
"""lhde-mime: which program opens what, and why (docs/USAGE.md "File types and programs", docs/SETTINGS.md "Associations").
It reads the freedesktop files every program reads (shared-mime-info's database, the mimeapps.list layers, mimeinfo.cache,
the desktop entries) and says what GIO (Firefox, GTK programs), xdg-open and flxp make of them.

usage:
  lhde-mime explain FILE|TYPE     the type (detected how: glob and weight, or magic), its parents, every file and section
                                  that names it, the claimants with their desktop file and layer, what Removed Associations
                                  took out, and the verdict of GIO, xdg-open and flxp
  lhde-mime list [--programs|--types|--defaults|--user]
                                  every association: by program (the types each desktop file claims, and where it is the
                                  default), by type (the default and the claimants; the default), --defaults only the types
                                  with a default, --user what the user's own files set, with the file and line
  lhde-mime default TYPE APP      APP (a desktop file id: flxp.desktop) opens TYPE: written to ~/.config/mimeapps.list as
                                  flxp's Open With and Folder Options do
  lhde-mime reset TYPE            the user's lines for TYPE out of ~/.config/mimeapps.list: lhde's or the distribution's
                                  default again
  lhde-mime check                 the audit: programs claiming types they are unlikely to handle (a music player claiming
                                  folders, catch-all claims), the verdicts that follow, defaults naming desktop files that
                                  do not exist, duplicate lines, mimeinfo.cache files out of date, legacy files, lhde's
                                  defaults not read (XDG_CURRENT_DESKTOP)
The environment's XDG_* variables decide which files are read, as for every program."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib', 'lhde', 'tools'))
import lhdemime as M   # noqa: E402


def explain(db, what):
    e = db.env
    if '/' in what and not os.path.exists(what) and not what.startswith(('/', '.', '~')):
        t, how = db.mime.canonical(what), 'given'
        if t != what:
            how = 'given as %s, an alias' % what
    else:
        t, how = db.mime.detect(what)
        if not t:
            print('%s: %s' % (what, how))
            return 1
        t = db.mime.canonical(t)
    print('%s  %s' % (t, db.mime.comment(t) or '(no description)'))
    print('  type:     %s' % how)
    print('  parents:  %s' % (', '.join(db.mime.ancestors(t)) or 'none'))
    print('  desktops: XDG_CURRENT_DESKTOP=%s' % (':'.join(e.desktops) or '(not set)'))
    print()
    print('The files, most important first, and what each says of %s and its parents:' % t)
    chain = db.chain(t)
    n = 0
    for lf in db.lists:
        if not lf.exists:
            continue
        said = []
        for c in chain:
            for g, d in (('Default Applications', lf.default), ('Added Associations', lf.added),
                         ('Removed Associations', lf.removed)):
                for k, ids in d.items():
                    if db.mime.canonical(k) == c:
                        said.append('  line %d [%s] %s=%s' % (lf.lines.get((g, k), 0), g, k, ';'.join(ids)))
        n += 1
        print('  %-58s %s%s' % (e.short(lf.path), lf.layer, '' if said else ': nothing'))
        for s in said:
            print('    ' + s)
    if not n:
        print('  (no mimeapps.list or defaults.list exists)')
    print()
    print('Claimants of %s (Added Associations, then each directory\'s mimeinfo.cache, as GIO and xdg-open read them):' % t)
    cl = db.claimants(t, 'cache')
    for a, id_, how2, layer in cl:
        print('  %-30s %-12s %s%s' % (id_, layer, how2, '' if a else '  (not installed)'))
    if not cl:
        print('  none')
    files = db.claimants(t, 'files')
    extra = [c for c in files if c[1] not in {x[1] for x in cl}]
    if extra:
        print('  claims GIO and xdg-open do not see (no mimeinfo.cache lists them; flxp reads MimeType= itself):')
        for a, id_, how2, layer in extra:
            print('  %-30s %-12s %s' % (id_, layer, how2))
    removed = [(lf, ids) for lf in db.lists for k, ids in lf.removed.items() if db.mime.canonical(k) == t]
    print('Removed: %s' % ('; '.join('%s by %s' % (';'.join(ids), e.short(lf.path)) for lf, ids in removed) or 'none'))
    print()
    xid, xwhy = db.xdg_open(t)
    a, why, _, layer = db.resolve(t, 'cache')
    f, fwhy, _, flayer = db.resolve(t, 'files')
    print('xdg-open would run: %s because %s' % (xid or 'nothing', xwhy))
    print('GIO (Firefox, GTK programs) would run: %s because %s' % (a.id if a else 'nothing', why))
    print('flxp would run: %s because %s' % (f.id if f else 'nothing', fwhy))
    return 0


def list_cmd(db, mode):
    e = db.env
    if mode == '--user':
        user = [lf for lf in db.lists if lf.exists and lf.layer == M.USER]
        if not user:
            print('the user\'s files set nothing (%s does not exist)' % e.short(db.user_file()))
        for lf in user:
            print(e.short(lf.path))
            for g, d in (('Default Applications', lf.default), ('Added Associations', lf.added),
                         ('Removed Associations', lf.removed)):
                for k in sorted(d):
                    print('  %4d  %-22s %s=%s' % (lf.lines.get((g, k), 0), g.split()[0], k, ';'.join(d[k])))
        return 0
    types = set()
    for a in db.apps.values():
        types.update(db.mime.canonical(m) for m in a.mime_types)
    for lf in db.lists:
        for d in (lf.default, lf.added):
            types.update(db.mime.canonical(k) for k in d)
    if mode == '--programs':
        defaults = {}
        for t in types:
            a, _, c, _ = db.resolve(t)
            if a and c == t:
                defaults.setdefault(a.id, []).append(t)
        for id_ in sorted(db.apps):
            a = db.apps[id_]
            if not a.mime_types and id_ not in defaults:
                continue
            print('%s  %s%s  %s' % (id_, a.name, '' if a.usable(e) else ' (not usable)', e.short(a.path)))
            if a.mime_types:
                print('  claims:     %s' % ' '.join(a.mime_types))
            if id_ in defaults:
                print('  default of: %s' % ' '.join(sorted(defaults[id_])))
        return 0
    for t in sorted(types):
        a, why, c, layer = db.resolve(t)
        if mode == '--defaults' and (not a or layer == 'nothing (first claimant)'):
            continue
        cl = [x[1] for x in db.claimants(t, 'cache')]
        print('%-44s %-28s %s' % (t, a.id if a else '-', layer or '-'))
        if mode != '--defaults' and cl:
            print('  claimants: %s' % ' '.join(cl))
    return 0


def main(argv):
    if len(argv) < 2 or argv[1] in ('-h', '--help', 'help'):
        print(__doc__.split('usage:', 1)[1] if len(argv) >= 2 else __doc__)
        return 0 if len(argv) >= 2 else 2
    db = M.Db()
    cmd = argv[1]
    if cmd == 'explain' and len(argv) == 3:
        return explain(db, argv[2])
    if cmd == 'list' and len(argv) <= 3:
        mode = argv[2] if len(argv) == 3 else '--types'
        if mode not in ('--programs', '--types', '--defaults', '--user'):
            print('lhde-mime list: --programs, --types, --defaults or --user', file=sys.stderr)
            return 2
        return list_cmd(db, mode)
    if cmd == 'default' and len(argv) == 4:
        t, id_ = db.mime.canonical(argv[2]), argv[3]
        if not id_.endswith('.desktop'):
            id_ += '.desktop'
        if id_ not in db.apps:
            print('lhde-mime: no desktop file %s in %s' % (id_, ', '.join(db.env.short(d) for d in db.env.app_dirs())),
                  file=sys.stderr)
            return 1
        M.set_default(db.user_file(), t, id_)
        a, why, _, _ = M.Db(db.env).resolve(t)
        print('%s: %s (%s); flxp and GIO now run %s' % (t, id_, db.env.short(db.user_file()), a.id if a else 'nothing'))
        return 0
    if cmd == 'reset' and len(argv) == 3:
        t = db.mime.canonical(argv[2])
        had = M.reset(db.user_file(), t)
        a, why, _, _ = M.Db(db.env).resolve(t)
        print('%s: %s; now %s because %s' % (t, 'the user\'s lines removed from ' + db.env.short(db.user_file()) if had else
                                              'the user\'s file sets nothing for it', a.id if a else 'nothing', why))
        return 0
    if cmd == 'check' and len(argv) == 2:
        found = M.check(db)
        for kind, text in found:
            print('%-9s %s' % (kind, text))
        print('%d finding%s' % (len(found), '' if len(found) == 1 else 's'))
        return 0
    print('usage: lhde-mime explain FILE|TYPE | list [--programs|--types|--defaults|--user] | default TYPE APP | reset TYPE '
          '| check', file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv))
