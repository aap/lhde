#!/usr/bin/env python3
"""lhde-pack: a resource pack of raw, unmodified Windows files, made from ISOs (or WIMs, or Windows directories) by the rules in
share/sources/<source>.ini (docs/USAGE.md "Getting the Windows resources", docs/LAYOUT.md "Asset policy"). lhde-import --pack
turns a pack into lhde's Windows tree (~/.local/share/lhde-windows); nobody needs the ISOs after that.

usage: lhde-pack [--profile essentials|museum] [--themes A,B,C] [--isos DIR]... [--sources ID,ID] [--all] [--from-pack PACK]
                 [--from-tree [DIR]] [--local DIR | --no-local] [--out DIR] [--name NAME] [--no-tar] [--zip] [--tmp DIR] [--medium ID=PATH]...
                 [--notes DIR] [--reproducible] [--no-annotate] [--list]
  --profile P     essentials (the default): only the files the themes need, from the resolver itself (see --themes);
                  museum: every file of every source (today's complete pack, for archaeology and for making essentials later)
  --themes A,B,C  the themes essentials is made for (default: the shipped ones, share/themes/*.theme without .todo). For each,
                  `lhde-theme explain --files NAME` names the Windows files it reads: its visual style (+ shellstyles), the
                  styles/DLLs its frame sets and pack images are made from, the icon recipe's DLLs, the wallpaper, the fonts
                  directory, the build's shell32/browseui/explorer/shellstyle/comctl32/themeui/imageres/logonui, and
                  setup/hivedef.inf for a classic scheme. The union is packed; a build no theme needs is left out.
  --from-pack P   take the files from the pack P (a directory or .tar.zst/.tar.xz, normally a museum pack) instead of the
                  ISOs: nothing is read from any medium, the pack is only re-profiled (also: museum from a museum pack = a copy
                  with the duplicates linked)
  --from-tree [DIR]  take the files from a Windows tree (default $LHDE_WINDOWS, else ~/.local/share/lhde-windows): its
                  <source>/ directories are a museum pack already (the in-image paths are not recorded there: the MANIFEST
                  says tree:<path>); then profiled like --from-pack. The way to pack the tree a desktop runs on
  --local DIR     the files dropped in by hand that the pack carries as local/ (default: the Windows tree's local/ when there
                  is one; with --from-pack only when the pack has no local/ of its own): styles imported with lhde-import
                  --style (RealAero, the Aero reconstruction realaero.msstyles that aero4074 and aerovision use), schemes,
                  resources, fonts, wallpapers, icons. museum takes all of it, essentials what the themes name
  --no-local      no local/ in the pack
  --isos DIR      where the ISOs are (several allowed; default $LHDE_ISOS, a :-list, else .); each source
                  names its ISO file (iso = ...)
  --sources A,B   only these sources (default: every source with default = yes whose ISO is found; --all: also the others,
                  e.g. 4074r2, 4042main)
  --medium ID=PATH  take source ID from PATH (an ISO, a WIM or an extracted Windows directory) instead of its ISO; a source
                  with no ISO (layout tree: the free wallpapers, share/sources/free.ini) only this way
  --out DIR       where the pack goes (default .): DIR/NAME/ and DIR/NAME.tar.zst (zstd, else .tar.xz; --no-tar: the directory only)
  --zip           also DIR/NAME.zip (deflate; for the make install-resources-* targets' lhde_winthemes.zip and the like): a
                  zip has no hard links and no extended attributes, so identical files are stored once each and lhde-import
                  annotates them itself; the tarball stays the smaller and more faithful form
  --name NAME     default lhde-resources-<date> (essentials: lhde-resources-<date>-essentials)
  --tmp DIR       scratch space for an extracted WIM (up to 1 GB at a time) and, for essentials from ISOs, the museum pack made
                  on the way (about 400 MB; default a temporary directory beside --out)
  --notes DIR     the files of DIR copied into the pack's root as they are (a LICENSE note and the licence texts of a pack that
                  gets published: make free-pack); lhde-import reads only the pack's sources and local/, so they stay in the pack
  --reproducible  the same archive from the same files: no annotations (--no-annotate); the tarball's names sorted, owner root,
                  every mtime $SOURCE_DATE_EPOCH (else 0), compressed single-threaded; the zip's entries dated $SOURCE_DATE_EPOCH
                  (at least 1980), mode 644. A pack made again has the published one's sha256 (make free-pack)
  --no-annotate   write no file annotations (extended attributes user.lux.*, user.xdg.tags; docs/ANNOTATIONS.md). Without it the
                  files, the source directories and the pack carry author/build/source/desc/tags, and the tarball is made with
                  tar --xattrs so that lhde-import --pack restores them
  --list          the sources and whether their medium was found
Identical files (same sha256, within and across sources) are stored once: the first path keeps the file, the others are hard
links to it (relative symlinks where hard links fail), and the tarball holds the bytes once (tar, without --hard-dereference).
lhde-import --pack copies every path as a normal file. The MANIFEST stays the authority: one line per path, all of them.
Pack layout: NAME/<source>/{system32,themes,fonts,wallpapers}/..., NAME/<source>/source.ini (the rules it was made with, and
the recipes lhde-import runs), NAME/local/{themes,schemes,resources,fonts,wallpapers,icons}/... (the tree's local/, source
`local` in the MANIFEST), NAME/MANIFEST (sha256, size, pack path, source, medium:in-image path). Adding a file or a source
is editing or adding an ini in share/sources/; an in-image path share:FILE is lhde's own file beside the ini (a licence note).
"""
import os
import shutil
import sys
import tempfile
import datetime
_here = os.path.dirname(os.path.realpath(__file__))
sys.path[:0] = [_here, os.path.join(_here, '..', 'lib', 'lhde', 'tools')]   # the tree's tools/, or installed: <prefix>/bin + lib/lhde/tools
import lhdeimport as L
import lhdetree as T


def main():
    a = sys.argv[1:]
    isos, want, out, name, tar, tmpd, media, listing, allsrc = [], None, '.', None, True, None, {}, False, False
    profile, themes, frompack, fromtree, local, nolocal = 'essentials', None, None, None, None, False
    while a:
        o = a.pop(0)
        if o == '--isos': isos.append(a.pop(0))
        elif o == '--sources': want = [x for x in a.pop(0).split(',') if x]
        elif o == '--all': allsrc = True
        elif o == '--out': out = a.pop(0)
        elif o == '--name': name = a.pop(0)
        elif o == '--no-tar': tar = False
        elif o == '--zip': ZIP['on'] = True
        elif o == '--tmp': tmpd = a.pop(0)
        elif o == '--medium': k, v = a.pop(0).split('=', 1); media[k] = v
        elif o == '--profile': profile = a.pop(0)
        elif o == '--themes': themes = [x for x in a.pop(0).replace(' ', ',').split(',') if x]
        elif o == '--from-pack': frompack = a.pop(0)
        elif o == '--from-tree': fromtree = a.pop(0) if a and not a[0].startswith('--') else T.windows_dir()
        elif o == '--local': local = a.pop(0)
        elif o == '--no-local': nolocal = True
        elif o == '--list': listing = True
        elif o == '--no-annotate': T.set_annotate(False)
        elif o == '--notes': NOTES['dir'] = a.pop(0)
        elif o == '--reproducible': T.set_annotate(False); L.REPRODUCIBLE['on'] = True
        elif o in ('-h', '--help'): print(__doc__); return 0
        else: L.die('unknown argument %s (--help)' % o)
    if profile not in ('essentials', 'museum'):
        L.die('--profile is essentials or museum')
    if themes and profile == 'museum':
        L.die('--themes belongs to --profile essentials')
    if frompack and fromtree:
        L.die('--from-pack or --from-tree, not both')
    if local and not os.path.isdir(local):
        L.die('--local %s is no directory' % local)
    if NOTES['dir'] and not os.path.isdir(NOTES['dir']):
        L.die('--notes %s is no directory' % NOTES['dir'])
    explicit = bool(local)
    if not local and not nolocal:   # the Windows tree's local/ (the one --from-tree reads, else the user's)
        d = os.path.join(os.path.realpath(fromtree or T.windows_dir()), 'local')
        local = d if os.path.isdir(d) else None
    if nolocal:
        local = None
    if not isos:
        isos = [x for x in os.environ.get('LHDE_ISOS', '.').split(':') if x]
    sources = L.load_sources()
    if not sources:
        L.die('no share/sources/*.ini found')

    def medium(s):
        if s.id in media:
            return media[s.id]
        for d in isos:
            if not os.path.isdir(d):
                continue
            for f in os.listdir(d):
                if any(f.lower() == i.lower() for i in s.isos):
                    return os.path.join(d, f)
        return None
    if listing:
        for s in sorted(sources.values(), key=lambda s: s.id):
            m = medium(s)
            print('%-10s %-8s %-4s %-55s %s' % (s.id, s.layout, 'yes' if s.default else 'no', s.title[:55], m or ('(no %s)' % ' | '.join(s.isos) if s.isos else '(a directory: --medium %s=DIR)' % s.id)))
        return 0
    sel = [sources[x] for x in want] if want else [s for s in sources.values() if s.default or allsrc]
    missing = [x for x in (want or []) if x not in sources]
    if missing:
        L.die('no source %s (lhde-pack --list)' % ', '.join(missing))
    if profile == 'essentials':
        themes = themes or L.shipped_themes()
        if not themes:
            L.die('no shipped themes found (share/themes/*.theme); name some with --themes')
    name = name or 'lhde-resources-%s%s' % (datetime.date.today().isoformat(), '-essentials' if profile == 'essentials' else '')
    os.makedirs(out, exist_ok=True)
    pack = os.path.join(os.path.realpath(out), name)
    tmp = tempfile.mkdtemp(prefix='.lhde-pack-', dir=tmpd or os.path.realpath(out))
    try:
        if profile == 'essentials' or frompack or fromtree:
            return from_museum(profile, themes, frompack, fromtree, local, explicit, sel, want, isos, medium, pack, tmp, tar)
        return pack_media(sel, medium, isos, pack, tmp, tar, 'museum', None, local)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def pack_media(sel, medium, isos, pack, tmp, tar, profile, themes, local):
    """the museum pack: every file of the selected sources, from their media, and local/ (all of it); the pack directory is
    kept if it exists (this run's sources replace their old lines in the MANIFEST)"""
    os.makedirs(pack, exist_ok=True)
    T.xput(pack, {T.A_AUTHOR: 'lhde-pack', T.A_DESC: 'lhde resource pack: raw Windows files by source (lhde-import --pack)', T.A_TAGS: 'pack'})
    lines = []
    for s in sorted(sel, key=lambda s: s.id):
        m = medium(s)
        if not m:
            L.log('%s: skipped, no %s in %s' % (s.id, ' | '.join(s.isos), ', '.join(isos)))
            continue
        L.log('%s: %s from %s' % (s.id, s.title, m))
        shutil.rmtree(os.path.join(pack, s.id), ignore_errors=True)
        try:
            img, used = L.image_for(s, m, tmp)
            # the MANIFEST's medium: the ISO's file name; a source without one (a directory) by its id, whatever the directory
            lines += L.pack_image(s, img, pack, tmp, os.path.basename(m) if s.isos else s.id)
        except Exception as e:
            L.log('%s: failed: %s' % (s.id, e))
        shutil.rmtree(tmp, ignore_errors=True)
        os.makedirs(tmp, exist_ok=True)
    if local:
        lines += L.pack_local(local, pack)
    # the MANIFEST: this run's sources replace their old lines
    mf = os.path.join(pack, 'MANIFEST')
    keep = []
    if os.path.exists(mf):
        done = set(s.id for s in sel) | ({'local'} if local else set())
        keep = [l.rstrip('\n') for l in open(mf) if not l.startswith('#') and l.split('\t')[3] not in done]
        os.unlink(mf)
    finish(pack, keep + lines, tar, profile, themes)
    return 0


def finish(pack, lines, tar, profile, themes):
    """dedup, MANIFEST, the sizes, the tarball"""
    if NOTES['dir']:   # the notes beside the sources (no MANIFEST lines: they are no Windows files and are not imported)
        for r, ds, fs in os.walk(NOTES['dir']):
            for f in fs:
                q = os.path.join(r, f)
                d = os.path.join(pack, os.path.relpath(q, NOTES['dir']))
                os.makedirs(os.path.dirname(d), exist_ok=True)
                shutil.copyfile(q, d)
        L.log('notes: %s copied into %s' % (NOTES['dir'], pack))
    n, saved = L.dedup_pack(pack, lines)
    L.log('dedup: %d identical files linked, %.1f MB stored once' % (n, saved / 1e6))
    mf = os.path.join(pack, 'MANIFEST')
    L.write_pack(pack, lines, False, L.manifest_head(profile, themes))
    T.xput(mf, {T.A_AUTHOR: 'lhde-pack', T.A_DESC: 'sha256, size, pack path, source, in-image path of every file', T.A_TAGS: 'pack'})
    sz = L.pack_sizes(pack)
    for d, (nf, ap, un) in sz.items():
        if d:
            print('  %-10s %4d files %8.1f MB (%.1f MB stored)' % (d, nf, ap / 1e6, un / 1e6))
    nf, ap, un = sz['']
    print('  %-10s %4d files %8.1f MB (%.1f MB stored, dedup saved %.1f MB) in %s' % ('total', nf, ap / 1e6, un / 1e6, (ap - un) / 1e6, pack))
    if tar:
        L.write_pack(pack, [], True)
    if ZIP['on']:
        L.write_zip(pack)


ZIP = {'on': False}   # --zip
NOTES = {'dir': None}   # --notes


def from_museum(profile, themes, frompack, fromtree, local, explicit, sel, want, isos, medium, pack, tmp, tar):
    """essentials (or a re-linked museum) pack out of a museum pack: --from-pack, --from-tree (the Windows tree seen as one),
    else one made from the media on the way. local/: the tree's (or --local's); a pack's own local/ stays unless --local names
    another"""
    if fromtree:
        W = os.path.realpath(fromtree)
        if not os.path.isdir(W):
            L.die('--from-tree %s is no directory' % W)
        M = os.path.join(tmp, 'tree')
        L.log('the Windows tree %s as the museum pack (in %s)' % (W, M))
        lines = L.tree_pack(W, M)
        if local:
            lines += L.pack_local(local, M)
        L.write_pack(M, lines, False, L.manifest_head('museum'))
    elif frompack:
        M = L.unpack(frompack, tmp)
        if not os.path.exists(os.path.join(M, 'MANIFEST')):
            L.die('%s is no resource pack (no MANIFEST)' % frompack)
    else:
        M = os.path.join(tmp, 'museum')
        L.log('essentials from the media: the museum pack first (in %s), then the files the themes need' % M)
        work = os.path.join(tmp, 'work')
        os.makedirs(work)
        pack_media(sel, medium, isos, M, work, False, 'museum', None, local)
    lines_in = [l.rstrip('\n') for l in open(os.path.join(M, 'MANIFEST')) if l.strip() and not l.startswith('#')]
    if frompack and local and (explicit or not os.path.isdir(os.path.join(M, 'local'))):
        # the pack (read only) seen through an overlay: its sources as symlinks, local/ copied from the tree (or --local)
        O = os.path.join(tmp, 'overlay')
        os.makedirs(O)
        for d in os.listdir(M):
            if d not in ('local', 'MANIFEST'):
                os.symlink(os.path.join(os.path.realpath(M), d), os.path.join(O, d))
        lines_in = [l for l in lines_in if l.split('\t')[3] != 'local'] + L.pack_local(local, O)
        M = O
    if want:
        lines_in = [l for l in lines_in if l.split('\t')[3] in want or l.split('\t')[3] == 'local']
    if profile == 'museum':
        need = set(l.split('\t')[2] for l in lines_in)
    else:
        need = None
    shutil.rmtree(pack, ignore_errors=True)
    os.makedirs(pack)
    T.xput(pack, {T.A_AUTHOR: 'lhde-pack', T.A_DESC: 'lhde resource pack: raw Windows files by source (lhde-import --pack)', T.A_TAGS: 'pack'})
    lines = L.profile_pack(M, pack, themes, tmp, lines_in, need)
    finish(pack, lines, tar, profile, themes if profile == 'essentials' else None)
    return 0


if __name__ == '__main__':
    sys.exit(main())
