#!/usr/bin/env python3
"""lhde-firefox: Firefox's own chrome in the lhde theme's look, through userChrome.css (docs/USAGE.md "Firefox").

usage:
  lhde-firefox generate [THEME] [--look ff4|explorer] [-o FILE]
                                            a userChrome.css for THEME (default: the current theme) on stdout or into FILE;
                                            with -o Firefox 4's pictures (share/firefox/ff4) are copied and the pieces of
                                            the visual style Firefox cannot read from a .msstyles are rendered by ut-dump
                                            into lhde-art/ beside FILE
  lhde-firefox install [THEME] [--look ff4|explorer] [--profile DIR]
                                            write it into the profile's chrome/userChrome.css (an existing one not ours is
                                            kept as userChrome.css.lhde-backup), the prefs the look needs into user.js, and
                                            once the search box into the toolbar layout (prefs.js); under a glass theme
                                            settings.ini [extend_frame] firefox for luxwm; the profile must be closed.
                                            DIR: a profile directory or a profile's name in profiles.ini; default: the
                                            default profile
  lhde-firefox remove [--profile DIR]       undo install: our userChrome.css and lhde-art/ out (the backup back), our block
                                            out of user.js, the [extend_frame] key out of settings.ini
  lhde-firefox profiles                     the profiles profiles.ini lists, which is the default, which are in use

The look: for a Longhorn theme (Explorer.chrome = longhorn) Firefox 4's on Windows 7, with its own pictures, under luxwm's
caption: the tabs on the caption's colour without glass, on luxwm's glass under the glass themes when composited
(--look explorer: flxp's Explorer header band, with the tabs and flxp's menu band below it); for the others Firefox 4's
look on XP in the theme's colours and parts (its tabs, toolbar button frames). Colours, fonts and pictures come from
liblhde's resolver (lhde-theme resolve --shell) and from the visual style through ut-dump; without the Windows tree (or with
only the free ReactOS import) the CSS uses colours (and Firefox 4's pictures) alone. Nothing of the Windows tree is copied:
fonts are file:// URLs into it; only the parts that live inside a .msstyles are rendered into the profile.

A theme switch could run `lhde-firefox install` again for a closed profile (or generate into it: Firefox reads
userChrome.css at start only); that hook belongs beside session/theme-reload.sh and is not built.
"""
import os
import re
import shlex
import shutil
import struct
import subprocess
import sys
import zlib

HERE = os.path.dirname(os.path.realpath(__file__))
MARK = 'lhde-firefox'
BEGIN = '// ---- lhde-firefox begin (lhde-firefox remove takes this block out) ----'
END = '// ---- lhde-firefox end ----'


def tool(name):
    """lhde's programs: the build tree's build/bin, beside an installed tools/ (<prefix>/bin), PATH"""
    for d in (os.path.join(HERE, '..', 'build', 'bin'), os.path.join(HERE, '..', '..', '..', 'bin'), HERE):
        p = os.path.join(d, name)
        if os.access(p, os.X_OK) and os.path.isfile(p):
            return os.path.realpath(p)
    return shutil.which(name)


def run(args):
    try:
        r = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True, timeout=60)
    except OSError:
        return None
    return r.stdout if r.returncode == 0 else None


# ---- the theme --------------------------------------------------------------------------------------------------------

def lhde_theme(*args):
    lt = tool('lhde-theme')
    if not lt:
        sys.exit('lhde-firefox: needs lhde-theme (make, or an installed lhde)')
    return run([lt] + list(args))


def resolve(theme):
    out = lhde_theme('resolve', theme, '--shell')
    if out is None:
        sys.exit('lhde-firefox: no theme %s (lhde-theme list)' % theme)
    r = {}
    for line in out.splitlines():
        if '=' in line and line.startswith('lhde_'):
            k, v = line.split('=', 1)
            try:
                r[k[5:]] = shlex.split(v)[0] if v else ''
            except (ValueError, IndexError):
                r[k[5:]] = ''
    return r


def current_theme():
    out = lhde_theme('current')
    return (out or '').strip().splitlines()[0] if out and out.strip() else 'classic'


def template():
    # the source tree's own first (run from a checkout, its template goes with its code), then lhde's data directories
    for p in (os.path.join(HERE, '..', 'share', 'firefox', 'userChrome.css.in'),
              (lhde_theme('find', 'firefox/userChrome.css.in') or '').strip()):
        if p and os.path.isfile(p):
            with open(p) as f:
                return f.read()
    sys.exit('lhde-firefox: firefox/userChrome.css.in not found in lhde\'s data directories')


# ---- the visual style through ut-dump ---------------------------------------------------------------------------------

class Style:
    def __init__(self, path, color='', size=''):
        self.path = path if path and os.path.isfile(path) else ''
        self.ut = tool('ut-dump') if self.path else None
        self.opts = (['--color', color] if color else []) + (['--size', size] if size else [])
        self._list = None

    def ok(self):
        return bool(self.path and self.ut)

    def call(self, *args):
        return run([self.ut, self.path] + self.opts + list(args)) if self.ok() else None

    def listing(self):
        if self._list is None:
            self._list = self.call('--list') or ''
        return self._list

    def has(self, cls):
        return ('[%s.' % cls) in self.listing() or ('[%s]' % cls) in self.listing()

    def section(self, name):
        """key = value lines of a [name] section of --list"""
        out, on = {}, False
        for line in self.listing().splitlines():
            if line.startswith('['):
                on = line.strip().lower() == '[%s]' % name.lower()
            elif on and '=' in line:
                k, v = line.split('=', 1)
                out[k.strip().upper()] = v.strip()
        return out

    def get(self, cls, part, prop):
        out = self.call('--get', cls, part, '0', prop)
        return out.splitlines()[0].strip() if out else None

    def colour(self, cls, part, prop='TEXTCOLOR'):
        v = self.get(cls, part, prop)
        m = re.match(r'(\d+)[,\s]+(\d+)[,\s]+(\d+)', v or '')        # "216, 210, 189" (v4) or "216 210 189" (XP)
        return tuple(int(x) for x in m.groups()) if m else None

    def size_of(self, cls, part, state='NORMAL'):
        out = self.call('--size-of', cls, part, state, 'true')
        m = re.match(r'(\d+)x(\d+)', (out or '').strip())
        return (int(m.group(1)), int(m.group(2))) if m else None

    def render(self, cls, part, state, w, h, dest):
        return self.call('--render', cls, part, state, '%dx%d' % (w, h), dest) is not None and os.path.isfile(dest)


# ---- pixels: a PNG reader for sampling colours (8-bit RGB/RGBA, as ut-dump and lhde-import write them) -----------------

def read_png(path):
    with open(path, 'rb') as f:
        data = f.read()
    if data[:8] != b'\x89PNG\r\n\x1a\n':
        return None
    pos, idat, w = 8, b'', 0
    while pos < len(data):
        n, typ = struct.unpack('>I4s', data[pos:pos + 8])
        body = data[pos + 8:pos + 8 + n]
        if typ == b'IHDR':
            w, h, depth, ctype, _, _, inter = struct.unpack('>IIBBBBB', body)
            if depth != 8 or ctype not in (2, 6) or inter:
                return None
        elif typ == b'IDAT':
            idat += body
        pos += 12 + n
    bpp = 4 if ctype == 6 else 3
    raw, stride = zlib.decompress(idat), w * bpp
    rows, prev = [], bytearray(stride)
    for y in range(h):
        ft = raw[y * (stride + 1)]
        cur = bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
        for i in range(stride):
            a = cur[i - bpp] if i >= bpp else 0
            b = prev[i]
            c = prev[i - bpp] if i >= bpp else 0
            if ft == 1:
                cur[i] = (cur[i] + a) & 255
            elif ft == 2:
                cur[i] = (cur[i] + b) & 255
            elif ft == 3:
                cur[i] = (cur[i] + (a + b) // 2) & 255
            elif ft == 4:
                p = a + b - c
                pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
                cur[i] = (cur[i] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
        rows.append([tuple(cur[x * bpp:x * bpp + 3]) + ((cur[x * bpp + 3],) if bpp == 4 else (255,)) for x in range(w)])
        prev = cur
    return rows


def average(rows, y0, y1, x0=0, x1=None):
    t, n = [0, 0, 0], 0
    for row in rows[y0:y1]:
        for p in row[x0:x1]:
            if p[3] > 128:
                for i in range(3):
                    t[i] += p[i]
                n += 1
    return tuple(v // n for v in t) if n else None


def mix(a, b, k):
    return tuple(int(round(a[i] + (b[i] - a[i]) * k)) for i in range(3))


def lum(c):
    return 0.299 * c[0] + 0.587 * c[1] + 0.114 * c[2]


def css(c):
    return '#%02x%02x%02x' % c if c else 'transparent'


def rgb(v):
    m = re.match(r'\s*(\d+)\D+(\d+)\D+(\d+)', v or '')
    return tuple(int(x) for x in m.groups()) if m else None


def url(path):
    return 'url("file://%s")' % path


def write_png(path, rows):
    """8-bit RGBA"""
    h, w = len(rows), len(rows[0])
    raw = b''.join(b'\0' + bytes(c for p in row for c in p) for row in rows)

    def chunk(typ, body):
        return struct.pack('>I', len(body)) + typ + body + struct.pack('>I', zlib.crc32(typ + body) & 0xffffffff)
    with open(path, 'wb') as f:
        f.write(b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 6, 0, 0, 0)) +
                chunk(b'IDAT', zlib.compress(raw)) + chunk(b'IEND', b''))


def clear_corners(path):
    """a rendered XP part whose corners carry the bitmap's opaque background (Luna's tab items: the dialog colour
    241 239 223 outside the rounded corners and in the spare right column): that colour made transparent where it
    touches the picture's top corners or its right edge"""
    rows = read_png(path)
    if not rows:
        return False
    h, w = len(rows), len(rows[0])
    bg = rows[0][0]
    if bg[3] < 255 or rows[0][w - 1] != bg or rows[0][w // 2] == bg:
        return True                                       # transparent already, or square corners: nothing to clear
    rows = [list(r) for r in rows]
    todo = [(0, 0), (w - 1, 0)] + [(w - 1, y) for y in range(h)]
    while todo:
        x, y = todo.pop()
        if 0 <= x < w and 0 <= y < h and rows[y][x] == bg:
            rows[y][x] = (0, 0, 0, 0)
            todo += [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)]
    write_png(path, rows)
    return True


# ---- fonts: the theme's font directory (the Windows tree), else fontconfig -------------------------------------------

FONT_FILES = {'Tahoma': (['tahoma.ttf'], ['tahomabd.ttf']),
              'Segoe UI': (['segoeui.ttf', 'seguibk.ttf'], ['segoeuib.ttf', 'seguibd.ttf']),
              'Trebuchet MS': (['trebuc.ttf'], ['trebucbd.ttf'])}


def font_faces(face, fontdir):
    """@font-face rules for face from the theme's font directory, and the family list"""
    rules = []
    files = FONT_FILES.get(face)
    if files and fontdir and os.path.isdir(fontdir):
        have = {f.lower(): os.path.join(fontdir, f) for f in os.listdir(fontdir)}
        for weight, names in (('normal', files[0]), ('bold', files[1])):
            for n in names:
                if n in have:
                    rules.append('@font-face { font-family: "lhde %s"; font-weight: %s; src: %s; }'
                                 % (face, weight, url(os.path.realpath(have[n]))))
                    break
    family = (['"lhde %s"' % face] if rules else []) + ['"%s"' % face, 'Tahoma', '"DejaVu Sans"', 'sans-serif']
    return rules, ', '.join(family)


# ---- the values --------------------------------------------------------------------------------------------------------

# flxp's header geometry (flxp/shell/ui/lhheader.cpp, navbar.cpp's layouts): measured against the builds there
NAV_X = 2                                     # the travel buttons' x
LAYOUT = {   # crumb text x, crumb px, field height, field bottom gap, search w, h, right margin
    'slate': dict(crumb_x=83, crumb_px=11, face='Tahoma', field_h=20, row_bottom=10, search_w=160, search_h=20, right=8),
    'jade': dict(crumb_x=89, crumb_px=12, face='Segoe UI', field_h=20, row_bottom=5, search_w=160, search_h=20, right=8),
    'vision': dict(crumb_x=83, crumb_px=12, face='Segoe UI', field_h=21, row_bottom=7, search_w=180, search_h=21, right=4,
                   band_h=43),
}
# vision's band_h: flxp's vision header is 70 frame rows (aerovision, lab); luxwm gives Firefox its 27-row glass caption
SEG_PAD = 6                                    # a breadcrumb segment's text inset: the field starts this much left of it


def longhorn_vars(t, style, art):
    """the custom properties of the Longhorn band; art: a directory for rendered pieces (None: colours only)"""
    fam = t.get('style_family', '') or next((f for f in ('slate', 'jade', 'aero') if f in t.get('VisualStyle_style', '') + t.get('theme', '')), '')
    nav = t.get('Explorer_navbar', '')
    lay = dict(LAYOUT['vision' if nav == 'vision' else 'slate' if fam == 'slate' else 'jade'])
    v = {}
    # the band: Navbar::Rebar BACKGROUND (InactiveNavbar for an inactive window) with its sizing margins
    band, band_in, rows = None, None, None
    if style.ok() and style.has('Navbar::Rebar'):
        size = style.size_of('Navbar::Rebar', 'BACKGROUND')
        m = re.findall(r'-?\d+', style.get('Navbar::Rebar', 'BACKGROUND', 'SIZINGMARGINS') or '')
        if size and len(m) == 4:
            l, r, top, b = (int(x) for x in m)
            tmp = art or os.path.join(os.environ.get('TMPDIR', '/tmp'), 'lhde-firefox-%d' % os.getpid())
            os.makedirs(tmp, exist_ok=True)
            p = os.path.join(tmp, 'band.png')
            if style.render('Navbar::Rebar', 'BACKGROUND', 'NORMAL', size[0], size[1], p):
                rows = read_png(p)
                if art:
                    band = p
                    v['band-slice'] = '%d %d %d %d' % (top, r, b, l)
                    v['band-border'] = '%dpx %dpx %dpx %dpx' % (top, r, b, l)
                    pi = os.path.join(art, 'band-inactive.png')
                    if style.has('InactiveNavbar::Rebar') and \
                            style.render('InactiveNavbar::Rebar', 'BACKGROUND', 'NORMAL', size[0], size[1], pi):
                        band_in = pi
            if not art:
                shutil.rmtree(tmp, ignore_errors=True)
    title = style.colour('Navbar', 'TITLE') if style.ok() else None
    title_in = style.colour('InactiveNavTitle::Navbar', 'TITLE') if style.ok() and style.has('InactiveNavTitle::Navbar') else None
    if rows:
        h = len(rows)
        body = average(rows, 0, h)
        low = average(rows, max(0, h - 4), h - 1) or body
        line = average(rows, h - 1, h) or low
    else:
        # no style art (the free tree): the family's colours, measured on flxp's drawn Slate header (lhheader.cpp
        # paint_slate) and on Jade's band
        body = (150, 150, 150) if fam == 'slate' else (216, 225, 245)
        low, line = (body, (33, 36, 36)) if fam == 'slate' else ((206, 216, 238), (120, 130, 160))
    if not title:
        title = (255, 255, 255) if fam == 'slate' or lum(body) < 150 else (0, 2, 92)
    selected = mix(low, (255, 255, 255), 0.8)                      # taste: the selected tab lighter, near the page's white
    v.update({
        'band-h': '54px', 'nav-x': '%dpx' % NAV_X, 'travel-h': '54px',
        'band-image': url(band) if band else 'none',
        'band-image-inactive': url(band_in or band) if band else 'none',
        'band-color': css(body), 'band-color-inactive': css(mix(body, (255, 255, 255), 0.2)),
        'band-low': css(low), 'band-line': css(line),
        'text': css(title), 'text-inactive': css(title_in or mix(title, body, 0.3)),
        'text-shadow': '0 1px 1px rgba(0, 0, 0, 0.55)' if lum(title) > 160 else 'none',
        'field-h': '%dpx' % lay['field_h'], 'row-bottom': '%dpx' % lay['row_bottom'],
        'field-hover': 'rgba(255, 255, 255, 0.3)' if lum(title) > 160 else 'rgba(255, 255, 255, 0.55)',
        'field-border': css(mix(line, body, 0.35)),
        'search-w': '%dpx' % lay['search_w'], 'search-h': '%dpx' % lay['search_h'],
        'search-right': '%dpx' % lay['right'], 'search-bg': '#ffffff',
        'tab-h': '24px', 'tab-hover': css(mix(low, (255, 255, 255), 0.25)), 'tab-selected': css(selected),
        'tab-text': '#ffffff' if lum(low) < 140 else '#000000', 'tab-selected-text': '#000000',
        'tab-line': css(mix(line, low, 0.3)), 'tab-sep': css(mix(low, line, 0.35)),
    })
    v.setdefault('band-slice', '0 0 0 0')
    v.setdefault('band-border', '0px')
    # the travel buttons: TravelBack / TravelFwd::AnimationButton, states DISABLED NORMAL HOT PRESSED
    back_w = fwd_w = 0
    if art and style.ok() and style.has('TravelBack::AnimationButton') and style.has('TravelFwd::AnimationButton'):
        bs = style.size_of('TravelBack::AnimationButton', 'ABBACKGROUND')
        fs = style.size_of('TravelFwd::AnimationButton', 'ABBACKGROUND')
        if bs and fs:
            done = True
            for name, cls, s in (('back', 'TravelBack', bs), ('fwd', 'TravelFwd', fs)):
                for state in ('NORMAL', 'HOT', 'PRESSED', 'DISABLED'):
                    p = os.path.join(art, '%s-%s.png' % (name, state.lower()))
                    if style.render(cls + '::AnimationButton', 'ABBACKGROUND', state, s[0], s[1], p):
                        v['%s-%s' % (name, state.lower())] = url(p)
                    else:
                        done = False
            if done:
                back_w, fwd_w = bs[0], fs[0]
                v['travel-h'] = '%dpx' % bs[1]
                v['band-h'] = '%dpx' % (bs[1] if bs[1] >= 52 else bs[1] + 4)   # navbar.cpp: the Medium band
                if lay.get('band_h'):
                    # the vision header: luxwm's frame deco is 15 rows over flxp's header, and Firefox has the whole
                    # caption above its band; the band keeps flxp's header height, the art scaled down into it
                    k = lay['band_h'] / bs[1]
                    back_w, fwd_w = round(bs[0] * k), round(fs[0] * k)
                    v['travel-h'] = v['band-h'] = '%dpx' % lay['band_h']
    if back_w:
        v.update({'back-w': '%dpx' % back_w, 'fwd-w': '%dpx' % fwd_w, 'glyph-size': '0px',
                  'back-glyph': 'none', 'fwd-glyph': 'none'})
    else:
        # colours alone: Firefox's own arrows on the band, the buttons as wide as the art would be
        back_w, fwd_w = 38, 27
        for name in ('back', 'fwd'):
            for state in ('normal', 'hot', 'pressed', 'disabled'):
                v['%s-%s' % (name, state)] = 'none'
        v.update({'back-w': '38px', 'fwd-w': '27px', 'glyph-size': '16px',
                  'back-glyph': 'url("chrome://browser/skin/back.svg")', 'fwd-glyph': 'url("chrome://browser/skin/forward.svg")'})
    v['crumb-gap'] = '%dpx' % max(0, lay['crumb_x'] - SEG_PAD - NAV_X - back_w - fwd_w)
    return v, lay


def menu_font(t, style, dflt):
    """the menu font (the style's [sysmetrics] MENUFONT, else the theme's Metrics): (face, px at 96 dpi)"""
    sm = style.section('sysmetrics') if style.ok() else {}
    f = sm.get('MENUFONT') or t.get('Metrics_menufont') or ''
    parts = [p.strip() for p in f.split(',')]
    face = parts[0] if parts and parts[0] else dflt[0]
    try:
        pt = float(parts[1])
        px = int(round(-pt if pt < 0 else pt * 96 / 72))
    except (IndexError, ValueError):
        px = dflt[1]
    return face, px


def longhorn_menu_vars(t, style, art):
    """flxp's menu band under the header (flxp/explorer/lhbar.cpp): the Document::Rebar BACKGROUND strip of the build's
    slate.msstyles (838x8, sizing margins 1 1 1 0: a highlight row over a horizontal gradient), white text
    (ExplorerMenu::Toolbar TEXTCOLOR), the hot and pressed frames ExplorerMenu::Toolbar.BUTTON; flxp takes Slate's strip
    under every Longhorn style, so does this"""
    build = os.path.basename(t.get('path_resources', ''))
    slate = Style((lhde_theme('find', 'styles/slate%s.msstyles' % build) or '').strip()) if re.match(r'^\d{4}$', build) else None
    src = slate if slate and slate.ok() and slate.has('Document::Rebar') else style if style.ok() and style.has('Document::Rebar') else None
    v = {'menu-h': '22px'}                  # flxp's menu band: 22 rows (1 highlight row, 21 of gradient), the hot frame all of them
    rows = None
    if src and art:
        p = os.path.join(art, 'menu-band.png')
        if src.render('Document::Rebar', 'BACKGROUND', 'NORMAL', 838, 8, p):
            rows = read_png(p)
            v['menu-image'] = url(p)
        for state in ('HOT', 'PRESSED'):
            p = os.path.join(art, 'menu-%s.png' % state.lower())
            if src.has('ExplorerMenu::Toolbar') and src.render('ExplorerMenu::Toolbar', 'BUTTON', state, 40, 22, p):
                v['menu-%s' % state.lower()] = url(p)
    if rows:
        w = len(rows[0])
        edge, centre = rows[3][1][:3], rows[3][w // 2][:3]
    else:
        edge, centre = (36, 67, 142), (85, 115, 187)          # lhbar.cpp's drawn gradient
    v.setdefault('menu-image', 'none')
    v.setdefault('menu-hot', 'none')
    v.setdefault('menu-pressed', 'none')
    text = (src.colour('ExplorerMenu::Toolbar', '0') if src else None) or (255, 255, 255)
    v.update({
        'menu-bg': 'linear-gradient(to right, %s, %s, %s)' % (css(edge), css(centre), css(edge)),
        'menu-highlight': css(mix(centre, (255, 255, 255), 0.24)),
        'menu-text': css(text), 'menu-text-inactive': css(mix(text, centre, 0.45)),   # lhbar.cpp text_color
    })
    return v


def xp_vars(t, style, art):
    """the XP look (Firefox 4's on XP): the style's [sysmetrics] (Luna), else the theme's classic colours; with art, the
    style's tab (Tab.TABITEM) and toolbar button (Toolbar.BUTTON) pictures"""
    sm = style.section('sysmetrics') if style.ok() else {}

    def c(key, dflt):
        return rgb(sm.get(key.upper())) or rgb(t.get('Colors_' + key.lower())) or dflt
    face = c('btnface', (212, 208, 200))
    hilite = c('btnhighlight', (255, 255, 255))
    shadow = c('btnshadow', (128, 128, 128))
    dark = c('dkshadow3d', (64, 64, 64))
    text = c('btntext', (0, 0, 0))
    font = (sm.get('MENUFONT') or t.get('Metrics_menufont') or 'Tahoma').split(',')[0].strip()
    themed = bool(sm)
    v = {
        'xp-face': css(face), 'xp-text': css(text), 'xp-light': css(hilite), 'xp-shadow': css(shadow), 'xp-dark': css(dark),
        'xp-field-border': css(rgb(sm.get('EDGESHADOWCOLOR')) or (127, 157, 185) if themed else shadow),
        # the rebar's band line (flxp under Luna: EDGESHADOWCOLOR 216 210 189 over BTNHIGHLIGHT; classic: BTNSHADOW)
        'xp-etch': css((style.colour('Rebar', 'BAND', 'EDGESHADOWCOLOR') if themed else None) or shadow),
        # classic: Windows' tab control (raised, the selected one joined to the pane by the pane's BTNHIGHLIGHT edge)
        'xp-tab-line': css(hilite), 'xp-nav-top': css(face),
        'xp-tab-normal': 'none', 'xp-tab-hot': 'none', 'xp-tab-selected': 'none',
        'xp-tb-hot': 'none', 'xp-tb-pressed': 'none', 'xp-tb-checked': 'none',
    }
    if art and style.ok() and style.has('Tab.TABITEM'):
        done = True
        sel = None
        for state in ('NORMAL', 'HOT', 'SELECTED'):
            p = os.path.join(art, 'tab-%s.png' % state.lower())
            if style.render('Tab', 'TABITEM', state, 40, 24, p) and clear_corners(p):
                v['xp-tab-%s' % state.lower()] = url(p)
                if state == 'SELECTED':
                    sel = read_png(p)
            else:
                done = False
        if done and sel:
            # the line under the tabs is the selected tab's side edge (Luna: the pane's 145 155 156), the navigation
            # toolbar starts in the selected tab's bottom colour, so the tab joins it (Firefox 4's look)
            v['xp-tab-line'] = css(sel[len(sel) // 2][0][:3])
            v['xp-nav-top'] = css(sel[-1][len(sel[-1]) // 2][:3])
        else:
            for state in ('normal', 'hot', 'selected'):
                v['xp-tab-%s' % state] = 'none'
    if art and style.ok() and style.has('Toolbar.BUTTON'):
        for state in ('HOT', 'PRESSED', 'CHECKED'):
            p = os.path.join(art, 'tb-%s.png' % state.lower())
            if style.render('Toolbar', 'BUTTON', state, 24, 24, p):
                v['xp-tb-%s' % state.lower()] = url(p)
    return v, font


# Firefox 4's pictures (share/firefox/ff4, Mozilla's: MANIFEST and LICENSE there), copied into the profile's lhde-art/ff4/
FF4_FILES = {'tab': 'tab.png', 'toolbar-png': 'Toolbar.png', 'close': 'close.png', 'newtab': 'newtab.png',
             'reload': 'reload-stop-go.png'}
# Firefox 4's toolbar colour on Windows 7 (browser-aero.css: customToolbarColor hsl(214,44%,87%))
FF4_TOOLBAR = (209, 221, 237)


# the rows luxwm's glass is extended into Firefox's window under the glass themes ([extend_frame] firefox), the template's.
# Firefox 4's look: the tab row (3 + 25), the menu bar hidden (Firefox's default; shown, it pushes the tabs below the glass
# and they get the caption's colour behind them). The extension must end where the opaque rows begin: luxwm draws the
# frame's inner edge lines along the sides only below it, so an opaque row inside it has no edge at the left and right.
FF4_GLASS_ROWS = 3 + 25


def theme_glass(t):
    """the theme has glass frames (luxwm's DWM frames, composited unless Glass.composition = 0)"""
    return bool(t.get('path_frames')) and t.get('Glass_composition', '') != '0'


def ff4_dir():
    for p in (os.path.join(HERE, '..', 'share', 'firefox', 'ff4', 'MANIFEST'),
              (lhde_theme('find', 'firefox/ff4/MANIFEST') or '').strip()):
        if p and os.path.isfile(p):
            return os.path.dirname(os.path.realpath(p))
    return None


def caption_row(style, state, art):
    """the caption's last row without glass, which the menu bar and the tab row continue: the style's Window CAPTION part
    (what luxwm draws without a compositor, share/frames/*-classic) at its own size; with art its left and right sizing
    margins and its middle as three one-row pictures (art/caption-STATE-l, -m, -r.png) to stretch as luxwm stretches the
    caption. (average colour, {'l': url, 'm': url, 'r': url, 'lw': px, 'rw': px} or None)"""
    if not style.ok() or not style.has('Window'):
        return None, None
    size = style.size_of('Window', 'CAPTION', state) or (320, 29)
    w, h = size
    tmp = os.path.join(os.environ.get('TMPDIR', '/tmp'), 'lhde-firefox-caption-%d.png' % os.getpid())
    try:
        rows = read_png(tmp) if style.render('Window', 'CAPTION', state, w, h, tmp) else None
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)
    if not rows:
        return None, None
    row = [p[:3] + (255,) for p in rows[-1]]
    colour = average([row], 0, 1)
    m = [int(x) for x in re.findall(r'-?\d+', style.get('Window', 'CAPTION', 'SIZINGMARGINS') or '')]
    if not art or len(m) != 4 or m[0] + m[1] >= w:
        return colour, None
    l, r = max(1, m[0]), max(1, m[1])
    pieces = {'lw': l, 'rw': r}
    for k, part in (('l', row[:l]), ('m', row[l:w - r]), ('r', row[w - r:])):
        p = os.path.join(art, 'caption-%s-%s.png' % (state.lower(), k))
        write_png(p, [part])
        pieces[k] = url(p)
    return colour, pieces


def ff4_vars(t, style, art):
    """Firefox 4's look on Windows 7 without glass under luxwm's frame: the row behind the menu bar and the tabs in the
    caption's colour, Firefox 4's toolbar colour (the style's button face under Slate), Firefox 4's pictures"""
    fam = t.get('style_family', '') or next((f for f in ('slate', 'jade', 'aero') if f in t.get('VisualStyle_style', '') + t.get('theme', '')), '')
    nav = t.get('Explorer_navbar', '')
    lay = dict(LAYOUT['vision' if nav == 'vision' else 'slate' if fam == 'slate' else 'jade'])
    sm = style.section('sysmetrics') if style.ok() else {}
    # the caption luxwm draws without glass: the frame set frames_classic names (its msstyles: Jade's under the Aero themes),
    # else the theme's own style
    cap = style
    fc = os.path.join(t.get('path_frames_classic', ''), 'theme.ini')
    if os.path.isfile(fc):
        ini = {}
        with open(fc, errors='replace') as f:
            for line in f:
                if line.lstrip().startswith('['):
                    break
                if '=' in line and not line.lstrip().startswith(('#', ';')):
                    k, val = line.split('=', 1)
                    ini.setdefault(k.strip(), val.strip())
        p = (lhde_theme('find', ini.get('msstyles', '')) or '').strip() if ini.get('msstyles') else ''
        if p and os.path.isfile(p):
            cs = Style(p, ini.get('color', ''), ini.get('size', ''))
            if cs.ok():
                cap = cs
    frame, strip = caption_row(cap, 'ACTIVE', art)
    frame_in, strip_in = caption_row(cap, 'INACTIVE', art)
    if not frame:
        # no style (the free tree): the theme's caption colour, else Firefox 4's Aero Basic frame (browser-aero.css)
        frame = rgb(sm.get('ACTIVECAPTION')) or rgb(t.get('Colors_activecaption')) or (185, 209, 234)
        frame_in = rgb(sm.get('INACTIVECAPTION')) or rgb(t.get('Colors_inactivecaption')) or (215, 228, 242)
    frame_in = frame_in or mix(frame, (255, 255, 255), 0.3)
    toolbar = FF4_TOOLBAR
    if fam == 'slate':
        toolbar = rgb(sm.get('BTNFACE')) or rgb(t.get('Colors_btnface')) or (225, 225, 225)
    v = {
        'ff4-frame': css(frame), 'ff4-frame-inactive': css(frame_in),
        'ff4-frame-text': '#ffffff' if lum(frame) < 140 else '#000000',
        'ff4-toolbar': css(toolbar),
        'ff4-shadow': css(rgb(sm.get('BTNSHADOW')) or (160, 160, 160)),
        'ff4-tab-h': '25px', 'ff4-tabs-top': '3px',
        'search-w': '%dpx' % lay['search_w'],
    }
    # the caption's last row behind the menu bar and the tabs, its sizing margins kept at the sides as luxwm's caption has
    # them (luxwm's classic frame is 1 px wider than the client at each side: the pictures start 1 px further in)
    for key, s in (('ff4-frame-image', strip), ('ff4-frame-image-inactive', strip_in or strip)):
        v[key] = ('%s, %s, %s' % (s['l'], s['r'], s['m'])) if s else 'none'
        v[key + '-size'] = ('%dpx 100%%, %dpx 100%%, calc(100%% - %dpx) 100%%' % (s['lw'], s['rw'], s['lw'] + s['rw'] - 2)
                            if s else 'auto')
        v[key + '-pos'] = ('left -1px top, right -1px top, %dpx top' % (s['lw'] - 1)) if s else '0 0'
    src = ff4_dir()
    for key, name in FF4_FILES.items():
        v['ff4-' + key] = 'none'
        if art and src and os.path.isfile(os.path.join(src, name)):
            os.makedirs(os.path.join(art, 'ff4'), exist_ok=True)
            dest = os.path.join(art, 'ff4', name)
            shutil.copyfile(os.path.join(src, name), dest)
            v['ff4-' + key] = url(dest)
    return v, lay


def generate(theme, out=None, look=None):
    t = resolve(theme)
    style = Style(t.get('path_style', ''), t.get('VisualStyle_color', ''), t.get('VisualStyle_size', ''))
    longhorn = t.get('Explorer_chrome') == 'longhorn' and t.get('Explorer_navbar', 'none') != 'none'
    art = None
    if out:
        art = os.path.join(os.path.dirname(os.path.abspath(out)), 'lhde-art')
        shutil.rmtree(art, ignore_errors=True)
        os.makedirs(art)
    keep = 'xp'
    if longhorn:
        keep = 'longhorn' if look == 'explorer' else 'ff4'
    blocks = {keep}
    if keep == 'ff4':
        v, lay = ff4_vars(t, style, art)
        if theme_glass(t):
            blocks.add('ff4glass')
        # Firefox 4 drew its chrome in the system's menu font: the style's MENUFONT (Tahoma 11 px, Segoe UI 12 px)
        face, px = menu_font(t, style, (lay['face'], lay['crumb_px']))
        mface, mpx = face, px
    elif longhorn:
        v, lay = longhorn_vars(t, style, art)
        v.update(longhorn_menu_vars(t, style, art))
        face, px = lay['face'], lay['crumb_px']
        if style.ok():
            f = style.get('Navbar', 'TITLE', 'FONT') or ''
            if f.startswith('Tahoma'):
                face = 'Tahoma'
        mface, mpx = menu_font(t, style, (face, px))
    else:
        v, face = xp_vars(t, style, art)
        px = 11                                            # Tahoma 8 pt at 96 dpi
        mface, mpx = menu_font(t, style, (face, px))
    rules, family = font_faces(face, t.get('path_fonts', ''))
    v['font'] = family
    v['font-size'] = '%dpx' % px
    if mface != face:
        more, v['menu-font'] = font_faces(mface, t.get('path_fonts', ''))
        rules += more
    else:
        v['menu-font'] = family
    v['menu-font-size'] = '%dpx' % mpx
    if art and not os.listdir(art):
        os.rmdir(art)
    first = ('/* generated by lhde-firefox for the theme %s (%s, %s); do not edit: lhde-firefox generate writes it again */\n'
             % (theme, t.get('Theme_name', theme), {'ff4': 'Firefox 4', 'longhorn': 'Longhorn header', 'xp': 'XP toolbar'}[keep]))
    head = rules + [':root {\n' + ''.join('  --lhde-%s: %s;\n' % kv for kv in sorted(v.items())) + '}']
    text = first + template().replace('/*@VARS@*/', '\n'.join(head))
    text = re.sub(r'/\*@IF (\w+)@\*/\n(.*?)/\*@END@\*/\n',
                  lambda m: m.group(2) if m.group(1) in blocks else '', text, flags=re.S)
    if out:
        with open(out, 'w') as f:
            f.write(text)
    else:
        sys.stdout.write(text)
    return text, ('ff4glass' in blocks)


# ---- profiles ----------------------------------------------------------------------------------------------------------

def firefox_dirs():
    xdg = os.environ.get('XDG_CONFIG_HOME') or os.path.expanduser('~/.config')
    return [d for d in (os.path.join(xdg, 'mozilla', 'firefox'), os.path.expanduser('~/.mozilla/firefox'))
            if os.path.isfile(os.path.join(d, 'profiles.ini'))]


def read_ini(path):
    secs, cur = {}, None
    with open(path, errors='replace') as f:
        for line in f:
            line = line.strip()
            if line.startswith('[') and line.endswith(']'):
                cur = secs.setdefault(line[1:-1], {})
            elif cur is not None and '=' in line:
                k, v = line.split('=', 1)
                cur[k.strip()] = v.strip()
    return secs


def profiles():
    """[(name, path, is_default)] of every profiles.ini; the Install section's Default first, then Default=1"""
    out = []
    for base in firefox_dirs():
        ini = read_ini(os.path.join(base, 'profiles.ini'))
        installs = {s.get('Default') for n, s in ini.items() if n.startswith('Install')}
        for n, s in ini.items():
            if n.startswith('Profile') and 'Path' in s:
                p = s['Path'] if s.get('IsRelative', '1') == '0' else os.path.join(base, s['Path'])
                rank = 2 if s['Path'] in installs else 1 if s.get('Default') == '1' else 0
                out.append((s.get('Name', s['Path']), os.path.normpath(p), rank))
    best = max((r for _, _, r in out), default=0)
    return [(n, p, best > 0 and r == best) for n, p, r in out]


def in_use(prof):
    """Firefox holds the profile: .parentlock is locked (fcntl), or the lock symlink (ADDRESS:+PID) names a live
    process; a stale lock of a Firefox that crashed is not use"""
    pl = os.path.join(prof, '.parentlock')
    if os.path.exists(pl):
        import fcntl
        try:
            with open(pl, 'r+') as f:
                fcntl.lockf(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                fcntl.lockf(f, fcntl.LOCK_UN)
        except OSError:
            return True
    lock = os.path.join(prof, 'lock')
    if os.path.islink(lock):
        m = re.search(r':\+?(\d+)$', os.readlink(lock))
        if m:
            try:
                os.kill(int(m.group(1)), 0)
                return True
            except ProcessLookupError:
                pass
            except PermissionError:
                return True
    return False


def pick_profile(arg):
    if arg:
        if os.path.isdir(arg):
            return os.path.abspath(arg)
        for n, p, _ in profiles():
            if n == arg:
                return p
        sys.exit('lhde-firefox: no profile %s (a directory, or a name of lhde-firefox profiles)' % arg)
    for n, p, d in profiles():
        if d:
            return p
    sys.exit('lhde-firefox: no default Firefox profile found (profiles.ini in %s); give --profile DIR'
             % ' or '.join(['$XDG_CONFIG_HOME/mozilla/firefox', '~/.mozilla/firefox']))


# the prefs the look needs, written to user.js (Firefox applies them at every start)
PREFS = [
    ('toolkit.legacyUserProfileCustomizations.stylesheets', 'true', 'Firefox reads chrome/userChrome.css'),
    ('browser.tabs.inTitlebar', '0', 'the window manager (luxwm) draws the frame and the caption'),
    ('browser.uidensity', '1', 'compact: the period\'s small toolbar buttons'),
    ('browser.theme.toolbar-theme', '1', 'light chrome whatever the GTK theme says (the header sets its own colours)'),
    ('browser.compactmode.show', 'true', 'compact density offered in Customize'),
    ('sidebar.revamp', 'false', 'no sidebar button and launcher strip'),
    ('sidebar.verticalTabs', 'false', 'the tabs in their row below the band'),
    ('browser.search.widget.removeAfterDaysUnused', '36500', 'the search box is not taken away when unused'),
]


def js_value(v):
    return v if v in ('true', 'false') or re.match(r'^-?\d+$', v) else '"%s"' % v


def strip_block(text):
    return re.sub(r'\n?' + re.escape(BEGIN) + r'.*?' + re.escape(END) + r'\n?', '\n', text, flags=re.S).strip('\n')


def add_search_box(prof):
    """once: the search box into the toolbar layout after the address (prefs.js's browser.uiCustomization.state), and the
    bookmarks toolbar hidden unless shown (never shown by default); the user may move or show them afterwards"""
    import json
    pj = os.path.join(prof, 'prefs.js')
    text = open(pj, errors='replace').read() if os.path.isfile(pj) else ''
    lines = text.splitlines()
    state, idx = None, None
    for i, line in enumerate(lines):
        m = re.match(r'user_pref\("browser\.uiCustomization\.state",\s*(".*")\);$', line)
        if m:
            try:
                state, idx = json.loads(json.loads(m.group(1))), i
            except ValueError:
                pass
    if state is None:
        state = {'placements': {}, 'currentVersion': 0}
    nav = state.setdefault('placements', {}).get('nav-bar')
    if nav is None:
        nav = ['back-button', 'forward-button', 'stop-reload-button', 'urlbar-container', 'downloads-button',
               'fxa-toolbar-menu-button', 'unified-extensions-button']
        state['placements']['nav-bar'] = nav
    if any('search-container' in p for p in state['placements'].values()):
        return False
    nav.insert(nav.index('urlbar-container') + 1 if 'urlbar-container' in nav else len(nav), 'search-container')
    line = 'user_pref("browser.uiCustomization.state", %s);' % json.dumps(json.dumps(state, separators=(',', ':')))
    if idx is None:
        lines.append(line)
    else:
        lines[idx] = line
    if not any('"browser.toolbars.bookmarks.visibility"' in x for x in lines):
        lines.append('user_pref("browser.toolbars.bookmarks.visibility", "never");')
    if os.path.isfile(pj):
        shutil.copy2(pj, pj + '.lhde-backup')
    with open(pj, 'w') as f:
        f.write('\n'.join(lines) + '\n')
    return True


def install(theme, prof, look=None):
    if in_use(prof):
        sys.exit('lhde-firefox: the profile %s is in use: close Firefox first' % prof)
    chrome = os.path.join(prof, 'chrome')
    os.makedirs(chrome, exist_ok=True)
    uc = os.path.join(chrome, 'userChrome.css')
    if os.path.isfile(uc):
        with open(uc, errors='replace') as f:
            ours = 'generated by lhde-firefox' in f.read(400)
        if not ours:
            shutil.copy2(uc, uc + '.lhde-backup')
            print('kept your userChrome.css as %s' % (uc + '.lhde-backup'))
    _, glass = generate(theme, uc, look)
    uj = os.path.join(prof, 'user.js')
    old = strip_block(open(uj, errors='replace').read()) if os.path.isfile(uj) else ''
    block = [BEGIN, '// the prefs of lhde\'s Firefox look (docs/USAGE.md "Firefox")']
    prefs = PREFS + ([('mozilla.widget.use-argb-visuals', 'true',
                       'an ARGB window: the tab row shows luxwm\'s glass under the glass themes')] if glass else [])
    block += ['user_pref("%s", %s);  // %s' % (k, js_value(v), why) for k, v, why in prefs]
    block.append(END)
    with open(uj, 'w') as f:
        f.write((old + '\n\n' if old else '') + '\n'.join(block) + '\n')
    added = add_search_box(prof)
    # luxwm extends its glass into Firefox's window for these rows (settings.ini [extend_frame]; docs/SETTINGS.md); a
    # theme without glass takes the key out again
    lt = tool('lhde-theme')
    if lt:
        run([lt, 'setting', 'extend_frame', 'firefox', '0 0 %d 0' % FF4_GLASS_ROWS if glass else '-'])
    print('installed the %s look into %s' % (theme, prof))
    print('  %s, %s%s%s' % (uc, uj, ', the search box placed in prefs.js' if added else '',
                            ', settings.ini [extend_frame] firefox' if glass else ''))


def remove(prof):
    if in_use(prof):
        sys.exit('lhde-firefox: the profile %s is in use: close Firefox first' % prof)
    chrome = os.path.join(prof, 'chrome')
    uc = os.path.join(chrome, 'userChrome.css')
    if os.path.isfile(uc):
        with open(uc, errors='replace') as f:
            if 'generated by lhde-firefox' in f.read(400):
                os.remove(uc)
    if os.path.isfile(uc + '.lhde-backup') and not os.path.exists(uc):
        os.rename(uc + '.lhde-backup', uc)
    shutil.rmtree(os.path.join(chrome, 'lhde-art'), ignore_errors=True)
    uj = os.path.join(prof, 'user.js')
    if os.path.isfile(uj):
        rest = strip_block(open(uj, errors='replace').read())
        if rest.strip():
            with open(uj, 'w') as f:
                f.write(rest + '\n')
        else:
            os.remove(uj)
    lt = tool('lhde-theme')
    if lt:
        run([lt, 'setting', 'extend_frame', 'firefox', '-'])
    print('removed lhde\'s look from %s (prefs.js keeps the toolbar layout; Firefox\'s Customize resets it)' % prof)


def main(argv):
    if not argv or argv[0] in ('-h', '--help', 'help'):
        print(__doc__.strip())
        return 0
    cmd, rest = argv[0], argv[1:]
    prof, out, theme, look = None, None, None, None
    i = 0
    while i < len(rest):
        a = rest[i]
        if a in ('--profile', '-o', '--look') and i + 1 < len(rest):
            if a == '--profile':
                prof = rest[i + 1]
            elif a == '--look':
                look = rest[i + 1]
                if look not in ('ff4', 'explorer'):
                    sys.exit('lhde-firefox: --look ff4 or --look explorer')
            else:
                out = rest[i + 1]
            i += 2
            continue
        if a.startswith('-'):
            sys.exit('lhde-firefox: unknown option %s' % a)
        theme = a
        i += 1
    if cmd == 'generate':
        generate(theme or current_theme(), out, look)
    elif cmd == 'install':
        install(theme or current_theme(), pick_profile(prof), look)
    elif cmd == 'remove':
        remove(pick_profile(prof))
    elif cmd == 'profiles':
        for n, p, d in profiles():
            print('%-24s %s%s%s' % (n, p, '  (default)' if d else '', '  (in use)' if in_use(p) else ''))
    else:
        sys.exit('lhde-firefox: unknown command %s (generate, install, remove, profiles)' % cmd)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
