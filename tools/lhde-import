#!/usr/bin/env python3
"""lhde-import: the user's own Windows files into lhde's Windows tree (docs/USAGE.md "Getting the Windows resources",
docs/LAYOUT.md "The three trees"). The repository holds no Microsoft files; everything the programs draw from a Windows build
lands in $LHDE_WINDOWS (default ${XDG_DATA_HOME:-~/.local/share}/lhde-windows):
  <source>/   the raw files of one build, as the resource pack has them (system32/ themes/ fonts/ wallpapers/ source.ini)
  local/      styles dropped in by hand (--style) and other files that come from no source
  generated/  what the recipes derive (frame sets, luxshell's pack images, classic schemes): delete freely, --regenerate
  index/      symlinks under the names the programs ask for (styles/jade4074.msstyles, resources/4074, ...)

usage:
  lhde-import --pack FILE|DIR                 the normal way: a resource pack (lhde-pack; a directory or .tar.zst / .tar.xz)
  lhde-import --iso FILE [--source ID]        a Windows / Longhorn ISO: its build is detected (explorer.exe's version, the
  lhde-import --wim FILE [--source ID]        layout), the files of data/sources/<build>.ini packed into a temporary pack and
  lhde-import --dir PATH [--source ID]        imported from there (one code path with --pack); PATH = a Windows directory
  lhde-import --style FILE [NAME]             drop one visual style in (local/themes/NAME.msstyles; NAME defaults to the file's
                                              stem), with its Shell/ when it has one beside it, and run the recipes that read it
                                              (aero-patch: the frame sets aero-patch and aerovision)
  lhde-import --from-workspace DIR [--copy-resources]   aap's research workspace (~/fun/longhorn)
  lhde-import --regenerate                    delete generated/ and make it again from the imported files (--rebuild-cache)
  lhde-import --annotate                      write the file annotations (extended attributes, docs/ANNOTATIONS.md) a tree lacks:
                                              originals, generated files, directories; keeps attributes that are there; idempotent
  lhde-import --reindex                       make index/ again (after moving or deleting files by hand)
  lhde-import --migrate [-n]                  move an old-layout ~/.local/share/lhde (everything in one directory) into the
                                              three trees without reading any ISO; -n lists what it would do. Run it after
                                              make install; lhde-session runs it once by itself. Idempotent.
  lhde-import --list                          what the Windows tree holds
options: --windows DIR (default $LHDE_WINDOWS, else ${XDG_DATA_HOME:-~/.local/share}/lhde-windows; --data DIR is the old
         spelling), --force (replace files that exist), --no-recipes (raw files only), --tmp DIR (scratch for an extracted WIM;
         default beside the Windows tree), --no-annotate (write no extended attributes: the importer annotates what it writes,
         best effort, docs/ANNOTATIONS.md), --old DIR (--migrate: the old directory, default ${XDG_DATA_HOME:-~/.local/share}/lhde)
"""
import os
import shutil
import sys
import tempfile
_here = os.path.dirname(os.path.realpath(__file__))
sys.path[:0] = [_here, os.path.join(_here, '..', 'lib', 'lhde', 'tools')]   # the tree's tools/, or installed: <prefix>/bin + lib/lhde/tools
import lhdeimport as L
import lhdetree as T


def from_workspace(ws, W, force, copyres):
    """the research workspace's resources/ and x11/ (generated frame sets, lhshell/assets), as the first lhde-import did: the
    styles into local/themes, fonts/wallpapers/system32 per build into W/<build>/ (other names into local/), the x11 frame sets'
    and lhshell assets' PNGs into generated/"""
    R, X = os.path.join(ws, 'resources'), os.path.join(ws, 'x11')
    if not (os.path.isdir(os.path.join(R, 'msstyles')) and os.path.isdir(os.path.join(X, 'lhwm', 'themes'))):
        L.die('%s is not the Longhorn workspace (resources/msstyles, x11/lhwm/themes)' % ws)
    rep = {'copied': 0, 'kept': 0}
    known = set(L.load_sources())

    def home(b, sub, kind):
        return os.path.join(W, b, sub) if b in known else os.path.join(W, 'local', kind, b)
    for f in sorted(os.listdir(os.path.join(R, 'msstyles'))):
        if f.endswith('.msstyles'):
            L.copy_file(os.path.join(R, 'msstyles', f), os.path.join(W, 'local', 'themes', f), force, rep)
    for sub in ('fonts', 'wallpapers'):
        for b in sorted(os.listdir(os.path.join(R, sub))):
            if os.path.isdir(os.path.join(R, sub, b)):
                L.copy_tree(os.path.realpath(os.path.join(R, sub, b)), home(b, sub, sub), force, rep)
    for b in sorted(os.listdir(os.path.join(R, 'system32'))):
        src, dst = os.path.realpath(os.path.join(R, 'system32', b)), home(b, 'system32', 'resources')
        if os.path.lexists(dst) and not force:
            continue
        if os.path.lexists(dst):
            shutil.rmtree(dst) if os.path.isdir(dst) and not os.path.islink(dst) else os.unlink(dst)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        if copyres:
            for f in ('shell32.dll', 'imageres.dll', 'browseui.dll', 'shellstyle.dll', 'comctl32.dll', 'shdocvw.dll', 'themeui.dll', 'uDWM.dll'):
                if os.path.isfile(os.path.join(src, f)):
                    L.copy_file(os.path.join(src, f), os.path.join(dst, f), True, rep)
            ex = os.path.join(src, '..', 'explorer.exe')
            if os.path.isfile(ex):
                L.copy_file(ex, os.path.join(dst, 'explorer.exe'), True, rep)
        else:
            os.symlink(src, dst)
            L.log('  linked %s -> %s' % (dst, src))
    for b in known:
        if os.path.isdir(os.path.join(W, b)) and not os.path.exists(os.path.join(W, b, 'source.ini')) and T.shipped_source_ini(b):
            shutil.copyfile(T.shipped_source_ini(b), os.path.join(W, b, 'source.ini'))
    G = os.path.join(W, 'generated')
    names = {'aero': 'aero-patch', 'jade': 'jade4074', 'luna-blue': 'luna4051-blue', 'luna-olive': 'luna4051-olive', 'luna-silver': 'luna4051-silver'}
    for d in sorted(os.listdir(os.path.join(X, 'lhwm', 'themes'))):
        n = names.get(d, d)
        src = os.path.join(X, 'lhwm', 'themes', d)
        if not os.path.isdir(src) or not any(os.path.isfile(os.path.join(s, 'frames', n, 'theme.ini')) for s in T.shipped_dirs()):
            continue
        for f in os.listdir(src):
            if f.endswith('.png'):
                L.copy_file(os.path.join(src, f), os.path.join(G, 'frames', n, f), force, rep)
    A = os.path.join(X, 'lhshell', 'assets')
    for o, n in (('imageres', '4074/imageres'), ('shell32', '4074/shell32'), ('startpanel-jade', '4074/startpanel-jade'),
                 ('startpanel-slate', '4074/startpanel-slate'), ('imageres-4051', '4051/imageres'), ('startpanel-luna-blue', '4051/startpanel-luna-blue'),
                 ('startpanel-luna-olive', '4051/startpanel-luna-olive'), ('startpanel-luna-silver', '4051/startpanel-luna-silver'), ('aero5112', '5112/imageres')):
        src = os.path.join(A, o)
        if not os.path.isdir(src):
            continue
        for r, ds, fs in os.walk(src):
            for f in fs:
                rel = os.path.relpath(os.path.join(r, f), src)
                L.copy_file(os.path.join(r, f), os.path.join(G, 'packs', n, rel), force, rep)
    T.reindex(W)
    T.annotate_tree(W)
    L.log('workspace %s: %d files copied, %d kept' % (ws, rep['copied'], rep['kept']))


def listing(W):
    if not os.path.isdir(W):
        L.die('no Windows tree %s (lhde-import --pack FILE; lhde-import --migrate for an old ~/.local/share/lhde)' % W)
    print('%s:' % W)
    print('  sources:    %s' % (' '.join(T.sources_in(W)) or '(none)'))
    for k in ('styles', 'frames', 'packs', 'resources', 'fonts', 'wallpapers'):
        p = os.path.join(W, 'index', k)
        names = sorted({x[:-9] if x.endswith('.msstyles') else x for x in os.listdir(p)}) if os.path.isdir(p) else []
        print('  %-11s %s' % (k + ':', ' '.join(names) or '(none)'))


def main():
    a = sys.argv[1:]
    o = {'force': False, 'recipes': True, 'copyres': False, 'dry': False}
    mode = arg = None
    extra = []
    while a:
        x = a.pop(0)
        if x in ('--pack', '--iso', '--wim', '--dir', '--from-workspace'):
            mode, arg = x[2:], a.pop(0)
        elif x == '--style':
            mode, arg = 'style', a.pop(0)
            if a and not a[0].startswith('--'):
                extra.append(a.pop(0))
        elif x == '--source': o['source'] = a.pop(0)
        elif x in ('--windows', '--data'): o['data'] = a.pop(0)
        elif x == '--old': o['old'] = a.pop(0)
        elif x in ('-n', '--dry-run'): o['dry'] = True
        elif x == '--migrate': mode = 'migrate'
        elif x == '--auto': o['auto'] = True
        elif x == '--reindex': mode = 'reindex'
        elif x == '--annotate': mode = 'annotate'
        elif x == '--no-annotate': T.set_annotate(False)
        elif x == '--tmp': o['tmp'] = a.pop(0)
        elif x == '--force': o['force'] = True
        elif x == '--no-recipes': o['recipes'] = False
        elif x == '--copy-resources': o['copyres'] = True
        elif x == '--list': mode = 'list'
        elif x in ('--regenerate', '--rebuild-cache'): mode = 'rebuild'
        elif x in ('-h', '--help'): print(__doc__); return 0
        elif not x.startswith('-') and mode is None: mode, arg = ('pack' if os.path.isdir(x) or '.tar' in x else 'iso' if x.lower().endswith('.iso') else 'wim' if x.lower().endswith('.wim') else 'pack'), x
        else: L.die('unknown argument %s (--help)' % x)
    data = T.windows_dir(o.get('data'))
    if mode == 'list':
        listing(data); return 0
    if mode == 'migrate':
        T.migrate(os.path.abspath(o.get('old') or T.old_dir()), data, T.config_dir(), o['dry'], o.get('auto', False))
        if not o['dry']:
            T.annotate_tree(data)
        return 0
    if mode == 'annotate':
        if not os.path.isdir(data):
            L.die('no Windows tree %s' % data)
        if not T.ANNOTATE['on']:
            L.die('--annotate with --no-annotate')
        T.annotate_tree(data)
        L.log('annotated %s' % data)
        return 0
    if mode is None:
        L.die('nothing to import from (--help)')
    os.makedirs(data, exist_ok=True)
    L.log('Windows tree %s' % data)
    if mode == 'reindex':
        T.reindex(data); return 0
    if mode == 'rebuild':
        L.regenerate(data); return 0
    if mode == 'from-workspace':
        from_workspace(os.path.realpath(arg), data, o['force'], o['copyres']); return 0
    if mode == 'style':
        name = extra[0] if extra else os.path.basename(arg).rsplit('.', 1)[0].lower()
        rep = {'copied': 0, 'kept': 0}
        L.copy_file(arg, os.path.join(data, 'local', 'themes', name + '.msstyles'), o['force'], rep)
        shell = os.path.join(os.path.dirname(arg), 'Shell')
        if os.path.isdir(shell):
            L.copy_tree(shell, os.path.join(data, 'local', 'themes', name, 'Shell'), o['force'], rep)
        L.log('local/themes/%s.msstyles (%d copied, %d kept)' % (name, rep['copied'], rep['kept']))
        T.reindex(data)
        for kind, target, spec in L.STYLE_RECIPES.get(name, []):
            if o['recipes']:
                L.run_recipe(os.path.join(data, 'index'), kind, target, spec, 'style', o['force'])
        T.annotate_tree(data)
        return 0
    tmp = tempfile.mkdtemp(prefix='.lhde-import-', dir=o.get('tmp') or data)
    try:
        if mode == 'pack':
            L.import_pack(L.unpack(os.path.realpath(arg), tmp), data, o['force'], o['recipes'])
            return 0
        sources = L.load_sources()
        medium = os.path.realpath(arg)
        if o.get('source'):
            s = sources.get(o['source']) or L.die('no source %s' % o['source'])
            img, _ = L.image_for(s, medium, tmp)
        else:
            s, img = L.detect(medium, sources, tmp)
            if not s:
                L.die('%s: no source matches (%s); name one with --source ID (data/sources/*.ini)' % (arg, img))
        pack = os.path.join(tmp, 'pack')
        lines = L.pack_image(s, img, pack, tmp, os.path.basename(medium))
        L.write_pack(pack, lines, False)
        L.import_pack(pack, data, o['force'], o['recipes'])
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return 0


if __name__ == '__main__':
    sys.exit(main())
