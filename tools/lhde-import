#!/bin/sh
# lhde-import: fill lhde's data directory with the user's own Windows art (docs/LAYOUT.md "Asset policy"). The repository holds
# no Microsoft files; everything the programs draw from a Windows build lands here, under build-qualified names
# (THEME-FORMAT discussion: aero5048, aero5112, aero-patch, jade4074, slate4051, ...):
#   styles/      *.msstyles; XP-format backports as styles/<name>/<file>.msstyles with their Shell/ (shellstyle.dll)
#   frames/      the pixels of luxwm's frame sets (frames/<name>/*.png; their theme.ini ships in data/frames/<name>)
#   packs/       luxshell's pack images per build: packs/4074/{imageres,shell32,startpanel-jade,startpanel-slate},
#                packs/4051/{imageres,startpanel-luna-*}, packs/5112/imageres (the packs' shell.lua ships in data/packs)
#   resources/   per build: resources/4074, resources/4051 = that build's system32 (shell32.dll, imageres.dll, ... and, through
#                the directory's parent, its Resources/ and Microsoft.NET/), resources/demo (demo art)
#   fonts/       per build (fonts/4074 = 4074's WINDOWS/Fonts, fonts/5048, fonts/5112)
#   wallpapers/  per build (wallpapers/4074/Bliss.bmp, ...), as data/wallpapers.ini names them
#
# Usage:
#   lhde-import --from-workspace DIR [--data DIR] [--copy-resources] [--force]
#       DIR is the Longhorn research workspace (~/fun/longhorn: resources/, x11/ with its generated frame directories and
#       lhshell/assets). Copies what is there; nothing in DIR is changed. resources/<build> are symlinks to the workspace's
#       extracted system32 trees (713 MB) unless --copy-resources copies the files lhde reads (shell32.dll, imageres.dll,
#       browseui.dll, explorer.exe, shellstyle.dll, ...). --force replaces what an earlier import put there.
#   lhde-import ISO | WIM | WINDOWS-DIR      (step 4 of docs/LAYOUT.md: not implemented yet)
#   lhde-import --list [--data DIR]          what the data directory holds
# The data directory: --data, else $LHDE_DATA, else ${XDG_DATA_HOME:-~/.local/share}/lhde. Every lhde program honours
# LHDE_DATA the same way (lhtheme/lhde_data.h), so a scratch import can be tried without touching ~/.local/share/lhde.
set -e
die() { echo "lhde-import: $*" >&2; exit 2; }
log() { echo "lhde-import: $*"; }

ws= data= copyres=0 force=0 list=0
while [ $# -gt 0 ]; do
	case $1 in
	--from-workspace) ws=$2; shift 2 ;;
	--data) data=$2; shift 2 ;;
	--copy-resources) copyres=1; shift ;;
	--force) force=1; shift ;;
	--list) list=1; shift ;;
	-h|--help) sed -n '2,/^set -e/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
	-*) die "unknown option $1 (--help)" ;;
	*) die "importing from $1 (an ISO, a WIM or a Windows directory) is step 4 of docs/LAYOUT.md and not implemented yet; use --from-workspace" ;;
	esac
done
D=${data:-${LHDE_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/lhde}}

if [ $list = 1 ]; then
	[ -d "$D" ] || die "no data directory $D"
	for k in styles frames packs resources fonts wallpapers; do
		[ -d "$D/$k" ] || { echo "$k/: (none)"; continue; }
		printf '%s/: %s\n' "$k" "$(cd "$D/$k" && ls | tr '\n' ' ')"
	done
	exit 0
fi
[ -n "$ws" ] || die "nothing to import from (--from-workspace DIR; --help)"
ws=$(cd "$ws" && pwd) || die "no workspace $ws"
R=$ws/resources X=$ws/x11
[ -d "$R/msstyles" ] && [ -d "$X/lhwm/themes" ] && [ -d "$X/lhshell/assets" ] || die "$ws is not the Longhorn workspace (resources/msstyles, x11/lhwm/themes, x11/lhshell/assets)"
mkdir -p "$D"
D=$(cd "$D" && pwd)
log "data directory $D, from $ws"

# copy SRC DST: a file or a directory tree, symlinks followed (the workspace links into its extracted builds); an existing DST
# is kept unless --force
copy() {
	if [ -e "$2" ] || [ -L "$2" ]; then
		[ $force = 1 ] || { echo "  kept    ${2#$D/} (exists; --force replaces it)"; return 0; }
		rm -rf "$2"
	fi
	mkdir -p "$(dirname "$2")"
	cp -RL "$1" "$2"
	echo "  copied  ${2#$D/}"
}
# copy only the PNGs of directory SRC into DST (the text halves ship in data/). Merges file by file: DST may
# already exist with the shipped theme.ini/nav.ini in it (make install PREFIX=~/.local puts data/ into the same
# ~/.local/share/lhde), so the directory is never removed; existing PNGs are kept unless --force.
copypng() {
	mkdir -p "$2"
	n=0 k=0
	for f in "$1"/*.png; do
		[ -f "$f" ] || continue
		if [ -e "$2/$(basename "$f")" ] && [ $force = 0 ]; then k=$((k + 1)); continue; fi
		cp -L "$f" "$2/"; n=$((n + 1))
	done
	echo "  copied  ${2#$D/} ($n PNG${k:+, $k kept})"
}

# ---- styles/: the workspace's resources/msstyles already has the build-qualified names ----
log "styles"
for f in "$R"/msstyles/*.msstyles; do [ -e "$f" ] && copy "$f" "$D/styles/$(basename "$f")"; done
# the XP-format (v3) rebuilds of Jade and Slate 4074 that flxp's uxtheme loads (themes.ini flxp_msstyles), with Shell/
for s in jade slate; do
	src=$R/xp-backport/$s; [ -f "$src/$s.msstyles" ] || continue
	dst=$D/styles/${s}4074-xp
	if [ -d "$dst" ] && [ $force = 0 ]; then echo "  kept    styles/${s}4074-xp (exists; --force replaces it)"; continue; fi
	rm -rf "$dst"; mkdir -p "$dst"; cp -L "$src/$s.msstyles" "$dst/"; [ -d "$src/Shell" ] && cp -RL "$src/Shell" "$dst/"
	echo "  copied  styles/${s}4074-xp ($s.msstyles + Shell/)"
done

# ---- fonts/, wallpapers/ ----
log "fonts"
for b in "$R"/fonts/*/; do b=$(basename "$b"); copy "$R/fonts/$b" "$D/fonts/$b"; done
log "wallpapers"
for w in "$R"/wallpapers/*/; do w=$(basename "$w"); copy "$R/wallpapers/$w" "$D/wallpapers/$w"; done

# ---- resources/: a build's system32 ----
log "resources"
for b in "$R"/system32/*; do
	[ -e "$b" ] || continue
	n=$(basename "$b"); dst=$D/resources/$n
	if { [ -e "$dst" ] || [ -L "$dst" ]; } && [ $force = 0 ]; then echo "  kept    resources/$n (exists; --force replaces it)"; continue; fi
	rm -rf "$dst"; mkdir -p "$D/resources"
	if [ $copyres = 1 ]; then
		mkdir -p "$dst"; c=0
		for f in shell32.dll imageres.dll browseui.dll explorer.exe shellstyle.dll comctl32.dll shdocvw.dll themeui.dll; do
			[ -f "$b/$f" ] && cp -L "$b/$f" "$dst/" && c=$((c + 1))
		done
		echo "  copied  resources/$n ($c files of its system32)"
	else
		ln -s "$(cd "$b" && pwd -P)" "$dst"; echo "  linked  resources/$n -> $(cd "$b" && pwd -P)"
	fi
done
[ -f "$X/aurora_strip.png" ] && copy "$X/aurora_strip.png" "$D/resources/demo/aurora_strip.png"

# ---- frames/: the x11 lab's frame directories (generated: msstyles2theme.py, build_aero*.py, extraction), renamed ----
log "frames"
for m in aero:aero-patch jade:jade4074 aero5048:aero5048 aero5112:aero5112 aerovision:aerovision \
         jade4074-classic:jade4074-classic slate4074-classic:slate4074-classic slate4051-classic:slate4051-classic \
         luna-blue:luna4051-blue luna-olive:luna4051-olive luna-silver:luna4051-silver; do
	o=${m%%:*} n=${m#*:}
	[ -d "$X/lhwm/themes/$o" ] && copypng "$X/lhwm/themes/$o" "$D/frames/$n"
done

# ---- packs/: lhshell/assets (shellpack.sh output) by build ----
log "packs"
A=$X/lhshell/assets
for m in imageres:4074/imageres shell32:4074/shell32 startpanel-jade:4074/startpanel-jade startpanel-slate:4074/startpanel-slate \
         imageres-4051:4051/imageres startpanel-luna-blue:4051/startpanel-luna-blue startpanel-luna-olive:4051/startpanel-luna-olive \
         startpanel-luna-silver:4051/startpanel-luna-silver aero5112:5112/imageres; do
	o=${m%%:*} n=${m#*:}
	[ -d "$A/$o" ] && copy "$A/$o" "$D/packs/$n"
done

printf '%s\n' "# lhde-import --from-workspace $ws, $(date '+%Y-%m-%d %H:%M')" >> "$D/import.log"
log "done: $(du -sh "$D" 2>/dev/null | cut -f1) in $D (resources/ $( [ $copyres = 1 ] && echo copied || echo linked))"
