#!/usr/bin/env python3
"""lhde-schemes: the classic Appearance schemes (Windows Standard, Brick, High Contrast, ...) from the user's own Windows
2000 / XP / Server 2003 install medium into lhde's Windows tree as local/schemes/NAME.scheme, looked up as styles/NAME.scheme
(docs/THEME-FORMAT.md section 2a). lhde-import runs the same code for the xp and 2k sources ([schemes] in share/sources/*.ini,
into generated/schemes); this is the stand-alone way.

usage:
  lhde-schemes [--windows DIR] [--force] FILE...
FILE: a HIVEDEF.INF, or an install ISO (its I386/ or AMD64/HIVEDEF.INF is read with 7z).
--windows DIR: the Windows tree (default $LHDE_WINDOWS, else ${XDG_DATA_HOME:-~/.local/share}/lhde-windows). The files go to
DIR/local/schemes, and DIR/index is made again.
--force: replace scheme files that exist.
"""
import os
import subprocess
import sys
import tempfile
_here = os.path.dirname(os.path.realpath(__file__))
sys.path[:0] = [_here, os.path.join(_here, '..', 'lib', 'lhde', 'tools')]   # the tree's tools/, or installed: <prefix>/bin + lib/lhde/tools
import lhdeschemes as S
import lhdetree as T


def inf_from_iso(iso, tmp):
    for member in ('AMD64/HIVEDEF.INF', 'I386/HIVEDEF.INF'):
        r = subprocess.run(['7z', 'e', '-y', '-o' + tmp, iso, member], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        p = os.path.join(tmp, 'HIVEDEF.INF')
        if r.returncode == 0 and os.path.isfile(p):
            return p
    return None


def main():
    args, data, force = [], None, False
    a = sys.argv[1:]
    while a:
        x = a.pop(0)
        if x == '--windows' and a:
            data = a.pop(0)
        elif x == '--force':
            force = True
        elif x in ('-h', '--help'):
            print(__doc__.strip())
            return 0
        else:
            args.append(x)
    if not args:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    W = T.windows_dir(data)
    out = os.path.join(W, 'local', 'schemes')
    total = 0
    for f in args:
        with tempfile.TemporaryDirectory() as tmp:
            inf = f
            if f.lower().endswith('.iso'):
                inf = inf_from_iso(f, tmp)
                if not inf:
                    print('lhde-schemes: %s: no I386/ or AMD64/HIVEDEF.INF (7z)' % f, file=sys.stderr)
                    continue
            print('%s:' % f)
            w, k = S.import_inf(inf, out, force, os.path.basename(f))
            total += w + k
    if total:
        T.reindex(W)
    return 0 if total else 1


if __name__ == '__main__':
    sys.exit(main())
