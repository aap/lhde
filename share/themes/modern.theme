; ReactOS's Modern, Light (free, GPL: the reactos source, share/sources/reactos.ini; its other scheme is Dark): an XP-format
; style, drawn live by wuxtheme (luxwm's msstyles mode, no frame set). Build reactos: ReactOS's icons and fonts. The XP
; explorer chrome, the classic taskbar. The wallpaper is taste (ReactOS sets none): a Pexels photo chosen by aap, diva's pale
; green veils (pexels.com/photo/30887567, the Pexels licence; the free source, share/sources/free.ini), filled.
[Theme]
name     = ReactOS Modern
build    = reactos

[VisualStyle]
style    = modern
color    = Light

[Glass]
frames         = none
frames_classic = none
composition    = 0

[Shell]
taskbar  = classic

[Explorer]
chrome   = xp
navbar   = none

[Desktop]
wallpaper = free/diva-30887567
mode      = fill
icons     = reactos
