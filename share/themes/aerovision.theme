; Aero vision (docs/NAVBAR.md): RealAero (as aero4074) with the vision header drawn by luxnav (15 px top deco, the Explorer plate
; cropped at the client's header, 13-row caption buttons); the aero bars with glowing taskbar text (packs/4074-aerovision)
[Theme]
name     = Aero vision
build    = 4074

[VisualStyle]
style    = realaero
color    = Default
size     = Normal

[Glass]
frames         = aerovision
frames_classic = jade4074-classic
composition    = auto

[Shell]
taskbar  = avalon
pack     = 4074-aerovision   ; the aero table with glowing taskbar text

[Explorer]
chrome   = longhorn
navbar   = vision            ; small | big (share/navbar/vision.ini)
navbar_preset = auto

[Desktop]
wallpaper = demos/exec_briefing_chadDesktop.dir_18_1   ; the chadDesktop demo (lhde-import --from-workspace; else 4074's Bliss)
mode      = fill
icons     = longhorn4074

[Fonts]
smoothing = cleartype      ; every 4074 screenshot has ClearType text (Tahoma 8 and Segoe UI alike)
