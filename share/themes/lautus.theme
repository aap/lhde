; ReactOS's Lautus (free, GPL: the reactos source, data/sources/reactos.ini): an XP-format style, drawn live by wuxtheme
; (luxwm's msstyles mode, no frame set). Build reactos: ReactOS's icons, fonts and wallpapers. The XP explorer chrome, the
; classic taskbar. The wallpaper is taste (ReactOS sets none).
[Theme]
name     = ReactOS Lautus
build    = reactos

[VisualStyle]
style    = lautus

[Glass]
frames         = none
frames_classic = none
composition    = 0

[Shell]
taskbar  = classic

[Explorer]
chrome   = xp
navbar   = none

[Desktop]
wallpaper = reactos/Borealis
mode      = fill
icons     = reactos
