; ReactOS's Lunar (its default visual style; free, GPL: the reactos source, share/sources/reactos.ini): an XP-format style,
; drawn live by wuxtheme (luxwm's msstyles mode, no frame set). Build reactos: ReactOS's icons and fonts. The XP explorer
; chrome, the classic taskbar. The wallpaper is taste (ReactOS sets none): a Pexels photo chosen by aap, Tim Mossholder's dark
; water (pexels.com/photo/9398211, the Pexels licence; the free source, share/sources/free.ini), filled (cropped, not
; stretched: a 3:2 photo on a 4:3 or 16:10 screen).
[Theme]
name     = ReactOS Lunar
build    = reactos

[VisualStyle]
style    = lunar

[Glass]
frames         = none
frames_classic = none
composition    = 0

[Shell]
taskbar  = classic

[Explorer]
chrome   = xp
navbar   = none

[Desktop]
wallpaper = free/timmossholder-9398211
mode      = fill
icons     = reactos
