; ReactOS's Mizu (free, GPL: the reactos source, share/sources/reactos.ini): an XP-format style, drawn live by wuxtheme
; (luxwm's msstyles mode, no frame set). Build reactos: ReactOS's icons and fonts. The XP explorer chrome, the classic
; taskbar. The wallpaper is taste (ReactOS's own Mizu wallpaper, CC BY-SA, is not taken): a Pexels photo chosen by aap,
; Marek Piwnicki's blue smoke (pexels.com/photo/12966762, the Pexels licence; the free source, share/sources/free.ini), filled.
[Theme]
name     = ReactOS Mizu
build    = reactos

[VisualStyle]
style    = mizu

[Glass]
frames         = none
frames_classic = none
composition    = 0

[Shell]
taskbar  = classic

[Explorer]
chrome   = xp
navbar   = none

[Desktop]
wallpaper = free/marek-piwnicki-12966762
mode      = fill
icons     = reactos
