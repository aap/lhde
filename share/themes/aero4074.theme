; RealAero, Lucas Brooks' reconstruction of the Aero theme for 4074 (styles/realaero.msstyles: built from Microsoft resources,
; imported by the user, docs/USAGE.md "The Aero patches for 4074"), with 4074's glass, as the x11 lab tuned it. Aliases: realaero, and
; aero-patch, the name lhde gave it before
[Theme]
name     = Aero (4074)
build    = 4074
aliases  = realaero aero-patch aero

[VisualStyle]
style    = realaero
color    = Default
size     = Normal

[Glass]
frames         = realaero
frames_classic = jade4074-classic
composition    = auto

[Shell]
taskbar  = avalon
pack     = 4074-aero

[Explorer]
chrome   = longhorn
navbar   = 4074

[Desktop]
wallpaper = demos/Aero Enmeshed     ; a demo image (not on the ISOs: lhde-import --from-workspace, else the build's Bliss)
mode      = fill
icons     = longhorn4074

[Fonts]
smoothing = cleartype      ; every 4074 screenshot has ClearType text (Tahoma 8 and Segoe UI alike)
