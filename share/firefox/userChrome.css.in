/* lhde's look for Firefox's own chrome (userChrome.css): the Longhorn Explorer header for the Longhorn themes, Firefox 4's
   look on XP for the XP and classic ones. Template of tools/lhde-firefox, which writes the theme's values into the block of
   custom properties below (from liblhde's resolver and the visual style through ut-dump) and keeps the sections for the
   theme's family; docs/USAGE.md "Firefox". Firefox 160's element ids (browser.xhtml, browser/omni.ja).

   Measured against flxp's header (flxp/shell/ui/lhheader.cpp, navbar.cpp: 4074's framelet geometry, 4051's navigation bar):
   the band's height (the travel art's: 54 rows), its picture (the style's Navbar::Rebar BACKGROUND with its sizing margins),
   the travel buttons (TravelBack/TravelFwd::AnimationButton, 38 + 27 x 54, 2 px from the left edge), where the address
   starts (the breadcrumb's text x of the style's layout), the text colour (Navbar.TITLE), the face and size (the style's
   breadcrumb face: Tahoma 11 px for Slate, Segoe UI 12 px for Jade and Aero), the search box (160 x 20, 8 px from the right
   edge; vision: 180 x 21, 4 px). Firefox is not transparent on X11: where flxp's header is glass, the band is the style's
   opaque navigation bar, as flxp draws it without composition.
   Taste (Firefox's own parts, after Firefox 4's look): the address sits on the breadcrumb's row and shows as a field only
   while hovered or focused, the reload button and the other toolbar buttons at the right of the band's lower row, the tabs
   on a flat row below the band in its lower colour, the selected tab lighter and joined to the page, small close buttons. */

/*@VARS@*/

/* ---- both families ---------------------------------------------------------------------------------------------------- */
#navigator-toolbox {
  display: flex !important;
  flex-direction: column !important;
  font-family: var(--lhde-font) !important;
  border-bottom: 0 !important;
}
#PersonalToolbar { order: 3; }

/* the menu bar (Alt, or View > Toolbars > Menu Bar): Firefox's GTK menu bar items drawn as the theme's. Its height is set
   only while it is shown: Firefox collapses it with [inactive] (an !important user rule would win over that) */
#main-menubar > menu {
  appearance: none !important;
  margin: 0 !important;
  border: 0 !important;
  border-radius: 0 !important;
  background: none !important;
  color: inherit !important;
  font-family: var(--lhde-menu-font) !important;
  font-size: var(--lhde-menu-font-size) !important;
}
#main-menubar > menu > .menubar-text, #main-menubar > menu > label { margin: 0 !important; color: inherit !important; }
#toolbar-menubar .titlebar-buttonbox-container, #toolbar-menubar .titlebar-spacer { display: none !important; }

/* things with no place in the period's header */
#nav-bar toolbarspring,
#nav-bar .titlebar-spacer,
#TabsToolbar .titlebar-spacer,
#sidebar-button,
#firefox-view-button,
#alltabs-button,
#taskbar-tabs-favicon,
#tracking-protection-icon-container,
#urlbar .urlbar-go-button,
#nav-bar-overflow-button:not([overflowedItem]) { display: none !important; }

#nav-bar .toolbarbutton-1:not(#back-button, #forward-button) {
  --toolbarbutton-inner-padding: 3px !important;
  --toolbarbutton-outer-padding: 1px !important;
  --toolbarbutton-border-radius: 2px !important;
}

/*@IF longhorn@*/
/* ---- the Longhorn header band ----------------------------------------------------------------------------------------- */
:root {
  --toolbar-bgcolor: var(--lhde-band-low) !important;
  --toolbar-color: var(--lhde-text) !important;
  --toolbox-bgcolor: var(--lhde-band-low) !important;
  --toolbox-bgcolor-inactive: var(--lhde-band-low) !important;
  --toolbox-textcolor: var(--lhde-tab-text) !important;
  --tabs-navbar-separator-style: none !important;
  --toolbarbutton-icon-fill: var(--lhde-text) !important;
  --urlbar-height: var(--lhde-field-h) !important;
  --urlbar-container-height: var(--lhde-field-h) !important;
  --toolbar-field-background-color: transparent !important;
  --toolbar-field-color: var(--lhde-text) !important;
  --toolbar-field-border-color: transparent !important;
  --toolbar-field-focus-background-color: #ffffff !important;
  --toolbar-field-focus-color: #000000 !important;
  --toolbar-field-focus-border-color: var(--lhde-field-border) !important;
  --urlbar-border-radius: 0px !important;
  --urlbarview-border-radius: 0px !important;
  --tab-border-radius: 0px !important;
  --tab-min-height: var(--lhde-tab-h) !important;
  --tab-block-margin: 0px !important;
  --tab-margin-block: 0px !important;
  --tab-shadow-max-size: 0px !important;
  --tab-selected-shadow: none !important;
  --tab-box-shadow-selected: none !important;
  --tab-background-color: transparent !important;
  --tab-background-color-hover: var(--lhde-tab-hover) !important;
  --tab-background-color-selected: var(--lhde-tab-selected) !important;
  --tab-selected-bgcolor: var(--lhde-tab-selected) !important;
  --tab-border: none !important;
  --tab-border-color: transparent !important;
  --tab-border-color-selected: transparent !important;
  --tab-text-color: var(--lhde-tab-text) !important;
  --tab-text-color-hover: var(--lhde-tab-text) !important;
  --tab-text-color-selected: var(--lhde-tab-selected-text) !important;
}

#nav-bar {
  box-sizing: border-box !important;
  height: var(--lhde-band-h) !important;
  min-height: var(--lhde-band-h) !important;
  max-height: var(--lhde-band-h) !important;
  padding: 0 var(--lhde-search-right) 0 var(--lhde-nav-x) !important;
  background-color: var(--lhde-band-color) !important;
  background-image: none !important;
  border: 0 !important;
  border-image-source: var(--lhde-band-image) !important;
  border-image-slice: var(--lhde-band-slice) fill !important;
  border-image-width: var(--lhde-band-border) !important;
  border-image-repeat: stretch !important;
  box-shadow: none !important;
  color: var(--lhde-text) !important;
  align-items: stretch !important;
}
:root:-moz-window-inactive #nav-bar {
  border-image-source: var(--lhde-band-image-inactive) !important;
  background-color: var(--lhde-band-color-inactive) !important;
  color: var(--lhde-text-inactive) !important;
}
#nav-bar { order: 0; }
#toolbar-menubar { order: 1; }
#TabsToolbar { order: 2; }

/* the menu bar: flxp's menu band under the header (flxp/explorer/lhbar.cpp: Slate's Document::Rebar strip, 22 rows, white
   menu-font text, ExplorerMenu::Toolbar.BUTTON as the hot and pressed frames over the band's full height; the first item's
   frame 2 px from the left edge, its text 9 px inside the frame: measured on flxp slate4051 and jade4074) */
#toolbar-menubar:not([inactive]) {
  height: var(--lhde-menu-h) !important;
  min-height: var(--lhde-menu-h) !important;
  max-height: var(--lhde-menu-h) !important;
}
#toolbar-menubar {
  padding: 0 0 0 2px !important;
  border: 0 !important;
  background-color: transparent !important;
  background-image: var(--lhde-menu-bg) !important;
  box-shadow: inset 0 1px var(--lhde-menu-highlight) !important;
  border-image-source: var(--lhde-menu-image) !important;
  border-image-slice: 1 1 0 1 fill !important;
  border-image-width: 1px 1px 0 1px !important;
  border-image-repeat: stretch !important;
  color: var(--lhde-menu-text) !important;
}
:root:-moz-window-inactive #toolbar-menubar { color: var(--lhde-menu-text-inactive) !important; }
#toolbar-menubar > .toolbar-items, #menubar-items, #main-menubar { height: var(--lhde-menu-h) !important; align-items: stretch !important; }
#main-menubar > menu {
  padding: 0 8px 0 9px !important;
  min-height: var(--lhde-menu-h) !important;
}
#main-menubar > menu:is([_moz-menuactive="true"], :hover) {
  border-image: var(--lhde-menu-hot) 5 fill / 5px stretch !important;
}
#main-menubar > menu[open] { border-image: var(--lhde-menu-pressed) 5 fill / 5px stretch !important; }

/* the travel buttons fill the band's height, the rest sits on the breadcrumb's row */
#nav-bar-customization-target {
  align-items: flex-end !important;
  height: var(--lhde-band-h) !important;
}
#nav-bar-customization-target > * { margin-bottom: var(--lhde-row-bottom) !important; }

/* the travel buttons: the style's TravelBack and TravelFwd art, the forward plate continuing the back plate */
#back-button, #forward-button {
  margin: 0 !important;
  padding: 0 !important;
  align-self: stretch !important;
  height: var(--lhde-travel-h) !important;
  margin-bottom: 0 !important;
  background: var(--lhde-back-normal) no-repeat left top / 100% 100% !important;
  width: var(--lhde-back-w) !important;
  min-width: var(--lhde-back-w) !important;
  border-radius: 0 !important;
  list-style-image: var(--lhde-back-glyph) !important;
  -moz-context-properties: fill !important;
  fill: var(--lhde-text) !important;
}
#forward-button {
  background-image: var(--lhde-fwd-normal) !important;
  width: var(--lhde-fwd-w) !important;
  min-width: var(--lhde-fwd-w) !important;
  list-style-image: var(--lhde-fwd-glyph) !important;
}
#back-button > .toolbarbutton-icon, #forward-button > .toolbarbutton-icon {
  background: none !important;
  box-shadow: none !important;
  padding: 0 !important;
  width: var(--lhde-glyph-size) !important;
  height: var(--lhde-glyph-size) !important;
}
#back-button[disabled] > .toolbarbutton-icon, #forward-button[disabled] > .toolbarbutton-icon { opacity: 1 !important; }
#back-button:not([disabled]):hover { background-image: var(--lhde-back-hot) !important; }
#back-button:not([disabled]):is(:hover:active, [open]) { background-image: var(--lhde-back-pressed) !important; }
#back-button[disabled] { background-image: var(--lhde-back-disabled) !important; }
#forward-button:not([disabled]):hover { background-image: var(--lhde-fwd-hot) !important; }
#forward-button:not([disabled]):is(:hover:active, [open]) { background-image: var(--lhde-fwd-pressed) !important; }
#forward-button[disabled] { background-image: var(--lhde-fwd-disabled) !important; }

/* the address on the breadcrumb's row, from the crumbs' x; a field only while hovered or focused (flxp's address edit) */
#stop-reload-button { order: 2; }
#urlbar-container {
  order: 1;
  flex: 1 1 auto !important;
  width: auto !important;
  max-width: none !important;
  margin-inline: var(--lhde-crumb-gap) 6px !important;
  padding: 0 !important;
  height: var(--lhde-field-h) !important;
  min-height: var(--lhde-field-h) !important;
  --urlbar-container-padding-block: 0px !important;
  font-family: var(--lhde-font) !important;
  font-size: var(--lhde-font-size) !important;
}
#urlbar {
  font-family: var(--lhde-font) !important;
  font-size: var(--lhde-font-size) !important;
  text-shadow: var(--lhde-text-shadow) !important;
}
#urlbar:not([focused], [open]):hover > .urlbar-background {
  background-color: var(--lhde-field-hover) !important;
  border: 1px solid var(--lhde-field-border) !important;
}
#urlbar:is([focused], [open]) { text-shadow: none !important; }
#urlbar-input, #urlbar .urlbar-input { font-family: var(--lhde-font) !important; font-size: var(--lhde-font-size) !important; }
#identity-box, #page-action-buttons, #star-button-box { opacity: 0.85; }

/* the search box at the right, as flxp's */
#search-container {
  order: 3;
  --toolbar-field-color: #000000 !important;
  --toolbar-field-background-color: var(--lhde-search-bg) !important;
  --toolbarbutton-icon-fill: #000000 !important;
  color: #000000 !important;
  text-shadow: none !important;
  min-width: var(--lhde-search-w) !important;
  max-width: var(--lhde-search-w) !important;
  width: var(--lhde-search-w) !important;
  margin-inline: 8px 0 !important;
  height: var(--lhde-search-h) !important;
  font-family: var(--lhde-font) !important;
  font-size: var(--lhde-font-size) !important;
}
#search-container .urlbar-background, #searchbar, #searchbar-new .urlbar-background {
  background-color: var(--lhde-search-bg) !important;
  border: 1px solid var(--lhde-field-border) !important;
  border-radius: 0 !important;
}
#search-container .urlbar, #searchbar-new { --urlbar-height: var(--lhde-search-h) !important; min-height: var(--lhde-search-h) !important; }
#nav-bar-customization-target > :is(#downloads-button, #unified-extensions-button, #fxa-toolbar-menu-button,
  #PanelUI-button, #library-button, #home-button, #stop-reload-button) { order: 4; }
#PanelUI-button { margin-bottom: var(--lhde-row-bottom) !important; align-self: flex-end !important; }
#PanelUI-menu-button, #unified-extensions-button, #fxa-toolbar-menu-button, #downloads-button { opacity: 0.9; }

/* the tabs: a flat row below the band in its lower colour, the selected tab lighter and joined to the page. The band's own
   last row is its line (Slate's dark one, Jade's blue one), as flxp's header ends on it (lhheader.cpp paint_bottom) and its
   menu band follows at once: no border of the row's own above it, or the line is doubled */
#TabsToolbar {
  background: var(--lhde-band-low) !important;
  border-top: 0 !important;
  border-bottom: 1px solid var(--lhde-tab-line) !important;
  color: var(--lhde-tab-text) !important;
  min-height: 0 !important;
}
#TabsToolbar .toolbar-items, #tabbrowser-tabs, #tabbrowser-arrowscrollbox { min-height: var(--lhde-tab-h) !important; }
#tabbrowser-tabs { --tab-min-height: var(--lhde-tab-h) !important; padding-inline: 0 !important; border: 0 !important; }
.tabbrowser-tab {
  padding: 0 !important;
  min-height: var(--lhde-tab-h) !important;
  font-family: var(--lhde-font) !important;
  font-size: var(--lhde-font-size) !important;
}
.tabbrowser-tab + .tabbrowser-tab:not([visuallyselected]) .tab-background,
.tabbrowser-tab:not([visuallyselected]) + .tabbrowser-tab .tab-background { border-left: 1px solid var(--lhde-tab-sep) !important; }
.tab-background {
  margin: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  outline: none !important;
  min-height: var(--lhde-tab-h) !important;
}
.tab-background:is([selected], [multiselected]) {
  background: var(--lhde-tab-selected) !important;
  border-left: 1px solid var(--lhde-tab-line) !important;
  border-right: 1px solid var(--lhde-tab-line) !important;
}
.tabbrowser-tab { color: var(--lhde-tab-text) !important; }
.tabbrowser-tab[visuallyselected] { color: var(--lhde-tab-selected-text) !important; }
.tab-content { padding-inline: 6px 2px !important; }
.tab-label { font-family: var(--lhde-font) !important; font-size: var(--lhde-font-size) !important; }
.tab-close-button {
  width: 16px !important;
  height: 16px !important;
  padding: 3px !important;
  margin-inline-end: 0 !important;
}
#tabs-newtab-button, #new-tab-button { --toolbarbutton-inner-padding: 3px !important; }
#tabbrowser-tabs .tabbrowser-tab:not([visuallyselected]) .tab-label { opacity: 0.95; }
/*@END@*/

/*@IF xp@*/
/* ---- the XP look: Firefox 4's on XP in the theme's parts, Tahoma 8 pt --------------------------------------------- */
#toolbar-menubar { order: 0; }
#TabsToolbar { order: 1; }
#nav-bar { order: 2; }

/* the menu bar: a plain row in the window's face colour over the toolbars (Firefox 4's on XP), 22 rows as flxp's menu band
   under Luna, then the rebar's etched line (Rebar.BAND EDGESHADOWCOLOR over BTNHIGHLIGHT, flxp's line between its bands;
   classic: BTNSHADOW). Items: Tahoma 8, the first text 10 px from the left; hot raised 1 px (BTNHIGHLIGHT, BTNSHADOW),
   open sunken, as flxp's menu band (Internet Explorer 6's, measured under Luna) */
#toolbar-menubar:not([inactive]) {
  height: 24px !important;
  min-height: 24px !important;
  max-height: 24px !important;
  padding: 0 0 2px 2px !important;
  background: linear-gradient(to top, var(--lhde-xp-light) 0 1px, var(--lhde-xp-etch) 1px 2px, transparent 2px),
              var(--lhde-xp-face) !important;
}
#toolbar-menubar {
  border: 0 !important;
  color: var(--lhde-xp-text) !important;
}
#toolbar-menubar > .toolbar-items, #menubar-items, #main-menubar { height: 22px !important; align-items: stretch !important; }
#main-menubar > menu {
  padding: 0 8px 0 7px !important;
  margin: 1px 0 2px !important;
  border: 1px solid transparent !important;
}
#main-menubar > menu:is([_moz-menuactive="true"], :hover) {
  border-color: var(--lhde-xp-light) var(--lhde-xp-shadow) var(--lhde-xp-shadow) var(--lhde-xp-light) !important;
}
#main-menubar > menu[open] {
  border-color: var(--lhde-xp-shadow) var(--lhde-xp-light) var(--lhde-xp-light) var(--lhde-xp-shadow) !important;
}

/* Firefox 4's look on XP (its screenshots at 96 dpi), in the style's parts. Measured there: the tab row in BTNFACE with
   the selected tab joined to the navigation toolbar below it, that toolbar 36 rows from near white to BTNFACE with a
   BTNSHADOW line under it. Luna's own: the tabs are the style's Tab.TABITEM (rounded, the orange line of the hot and
   selected tab), the line under them the selected tab's edge, the toolbar buttons' frames Toolbar.BUTTON, the fields'
   border 127 157 185 (flxp's address bar). Without a style (classic): Windows' tab control drawn with the 3D colours.
   Taste, Firefox 4's own and not XP's: the round 32 px Back button with Forward tucked against it (flxp's XP toolbar has
   Internet Explorer's flat Back and Forward). Firefox 4's orange application button is Firefox's, not XP's, and is not
   imitated: the menu is Firefox's current one at the right. The window frame stays luxwm's: Firefox 4 drew its tabs in
   the title bar only on Vista and 7 with glass, on XP the frame was the system's (docs/USAGE.md). */
:root {
  --toolbar-bgcolor: var(--lhde-xp-face) !important;
  --toolbar-color: var(--lhde-xp-text) !important;
  --toolbox-bgcolor: var(--lhde-xp-face) !important;
  --toolbox-bgcolor-inactive: var(--lhde-xp-face) !important;
  --toolbox-textcolor: var(--lhde-xp-text) !important;
  --toolbox-textcolor-inactive: var(--lhde-xp-text) !important;
  --toolbarbutton-icon-fill: var(--lhde-xp-text) !important;
  --toolbarbutton-hover-background: transparent !important;
  --toolbarbutton-active-background: transparent !important;
  --toolbar-field-background-color: #ffffff !important;
  --toolbar-field-color: #000000 !important;
  --toolbar-field-border-color: var(--lhde-xp-field-border) !important;
  --toolbar-field-focus-background-color: #ffffff !important;
  --toolbar-field-focus-color: #000000 !important;
  --toolbar-field-focus-border-color: var(--lhde-xp-field-border) !important;
  --urlbar-height: 22px !important;
  --urlbar-min-height: 22px !important;
  --urlbar-border-radius: 0px !important;
  --urlbarview-border-radius: 0px !important;
  --tab-border-radius: 0px !important;
  --tab-min-height: 23px !important;
  --tab-block-margin: 0px !important;
  --tab-margin-block: 0px !important;
  --tab-shadow-max-size: 0px !important;
  --tab-selected-shadow: none !important;
  --tab-box-shadow-selected: none !important;
  --tab-background-color: transparent !important;
  --tab-background-color-selected: transparent !important;
  --tab-selected-bgcolor: transparent !important;
  --tab-background-color-hover: transparent !important;
  --tab-text-color: var(--lhde-xp-text) !important;
  --tab-text-color-selected: var(--lhde-xp-text) !important;
  --tabs-navbar-separator-style: none !important;
}
#navigator-toolbox { background: var(--lhde-xp-face) !important; color: var(--lhde-xp-text) !important; }
#nav-bar, #TabsToolbar, #PersonalToolbar {
  color: var(--lhde-xp-text) !important;
  font-family: var(--lhde-font) !important;
  font-size: var(--lhde-font-size) !important;
  border-top: 0 !important;
  box-shadow: none !important;
}

/* the tab row: BTNFACE, 2 rows above the tabs, the line under them (the selected tab covers it) */
#TabsToolbar {
  background: linear-gradient(to top, var(--lhde-xp-tab-line) 0 1px, transparent 1px), var(--lhde-xp-face) !important;
  border-bottom: 0 !important;
  padding-top: 2px !important;
  min-height: 0 !important;
  height: 26px !important;
  max-height: 26px !important;
}
#TabsToolbar :is(.toolbar-items, #TabsToolbar-customization-target), #tabbrowser-tabs, #tabbrowser-arrowscrollbox {
  min-height: 0 !important;
  height: 24px !important;
  max-height: 24px !important;
  align-items: stretch !important;
}
#tabbrowser-tabs { --tab-min-height: 23px !important; padding-inline: 2px 0 !important; border: 0 !important; }
.tabbrowser-tab {
  padding: 0 !important;
  min-height: 24px !important;
  font-family: var(--lhde-font) !important;
  font-size: var(--lhde-font-size) !important;
  color: var(--lhde-xp-text) !important;
}
.tabbrowser-tab, .tab-stack, .tab-content { height: 24px !important; max-height: 24px !important; min-height: 0 !important; }
.tabbrowser-tab:not(:first-child) { margin-inline-start: -1px !important; }
.tab-stack { align-items: stretch !important; }
/* the unselected tabs 2 rows lower and 1 row short of the line (XP's tab control: the selected tab is 2 rows taller) */
/* the classic tab is the 1 px border (BTNHIGHLIGHT left and top, BTNSHADOW right) on BTNFACE; a style's picture covers it */
.tab-background {
  margin: 2px 0 1px !important;
  min-height: 0 !important;
  border: 1px solid !important;
  border-color: var(--lhde-xp-light) var(--lhde-xp-dark) transparent var(--lhde-xp-light) !important;
  border-bottom: 0 !important;
  border-radius: 0 !important;
  outline: none !important;
  box-shadow: none !important;
  background: var(--lhde-xp-face) padding-box !important;
  border-image: var(--lhde-xp-tab-normal) 6 fill / 6px stretch !important;
}
.tabbrowser-tab:hover > .tab-stack > .tab-background:not([selected], [multiselected]) {
  border-image: var(--lhde-xp-tab-hot) 6 fill / 6px stretch !important;
}
.tab-background:is([selected], [multiselected]) {
  margin: 0 !important;
  border-image: var(--lhde-xp-tab-selected) 6 fill / 6px 6px 0 6px stretch !important;
}
.tab-content { padding-inline: 6px 3px !important; }
.tabbrowser-tab:not([selected]) .tab-content { padding-top: 2px !important; }
.tab-label { font-family: var(--lhde-font) !important; font-size: var(--lhde-font-size) !important; }
.tab-close-button { width: 16px !important; height: 16px !important; padding: 3px !important; margin-inline-end: 0 !important; }
#tabs-newtab-button, #new-tab-button { --toolbarbutton-inner-padding: 3px !important; }

/* the navigation toolbar: from the selected tab's bottom colour to BTNFACE, the BTNSHADOW line under it */
#nav-bar {
  background: linear-gradient(var(--lhde-xp-nav-top), var(--lhde-xp-face)) !important;
  border-bottom: 1px solid var(--lhde-xp-shadow) !important;
  min-height: 37px !important;
  padding-block: 1px !important;
}
#PersonalToolbar {
  background: var(--lhde-xp-face) !important;
  border-bottom: 1px solid var(--lhde-xp-shadow) !important;
}
#urlbar-container { order: 1; }
#stop-reload-button { order: 2; }
#search-container { order: 3; }
#nav-bar-customization-target > :is(#downloads-button, #unified-extensions-button, #fxa-toolbar-menu-button, #library-button) { order: 4; }
#urlbar, #urlbar-input, #searchbar, .tab-label { font-family: var(--lhde-font) !important; font-size: var(--lhde-font-size) !important; }
#urlbar .urlbar-background, #searchbar-new .urlbar-background, #search-container .urlbar-background {
  border-radius: 0 !important;
  border: 1px solid var(--lhde-xp-field-border) !important;
  background-color: #ffffff !important;
  box-shadow: none !important;
  outline: none !important;
}

/* the toolbar buttons: Toolbar.BUTTON's hot, pressed and checked frames (classic: raised and sunken 1 px) */
:is(#nav-bar, #PersonalToolbar, #TabsToolbar) .toolbarbutton-1 > :is(.toolbarbutton-icon, .toolbarbutton-badge-stack, .toolbarbutton-text) {
  border-radius: 0 !important;
  border: 1px solid transparent !important;
  background: none !important;
}
:is(#nav-bar, #PersonalToolbar, #TabsToolbar) .toolbarbutton-1:not([disabled]):hover > :is(.toolbarbutton-icon, .toolbarbutton-badge-stack) {
  border-color: var(--lhde-xp-light) var(--lhde-xp-shadow) var(--lhde-xp-shadow) var(--lhde-xp-light) !important;
  border-image: var(--lhde-xp-tb-hot) 4 fill / 4px stretch !important;
}
:is(#nav-bar, #PersonalToolbar, #TabsToolbar) .toolbarbutton-1:not([disabled]):is(:hover:active, [open]) > :is(.toolbarbutton-icon, .toolbarbutton-badge-stack) {
  border-color: var(--lhde-xp-shadow) var(--lhde-xp-light) var(--lhde-xp-light) var(--lhde-xp-shadow) !important;
  border-image: var(--lhde-xp-tb-pressed) 4 fill / 4px stretch !important;
}
:is(#nav-bar, #PersonalToolbar) .toolbarbutton-1:not([disabled]):is([checked], [starred]) > .toolbarbutton-icon {
  border-color: var(--lhde-xp-shadow) var(--lhde-xp-light) var(--lhde-xp-light) var(--lhde-xp-shadow) !important;
  border-image: var(--lhde-xp-tb-checked) 4 fill / 4px stretch !important;
}

/* taste, Firefox 4's: Back a round 32 px button, Forward a smaller one tucked against its right (the keyhole) */
#back-button, #forward-button {
  padding: 0 !important;
  margin: 0 !important;
  align-self: center !important;
}
#back-button { position: relative !important; z-index: 2 !important; margin-inline-start: 3px !important; }
#forward-button { position: relative !important; z-index: 1 !important; }
#back-button[disabled], #forward-button[disabled] { opacity: 1 !important; }
#nav-bar #back-button > .toolbarbutton-icon {
  box-sizing: border-box !important;
  width: 32px !important;
  height: 32px !important;
  padding: 7px !important;
  border: 1px solid var(--lhde-xp-shadow) !important;
  border-radius: 50% !important;
  background: linear-gradient(#ffffff, var(--lhde-xp-face)) !important;
  box-shadow: inset 0 1px #ffffff !important;
  border-image: none !important;
}
#nav-bar #forward-button > .toolbarbutton-icon {
  box-sizing: border-box !important;
  width: 30px !important;
  height: 22px !important;
  padding: 2px 3px 2px 9px !important;
  margin-inline-start: -7px !important;
  border: 1px solid var(--lhde-xp-shadow) !important;
  border-radius: 0 4px 4px 0 !important;
  background: linear-gradient(#ffffff, var(--lhde-xp-face)) !important;
  border-image: none !important;
}
#nav-bar :is(#back-button, #forward-button):not([disabled]):hover > .toolbarbutton-icon {
  background: linear-gradient(#ffffff, var(--lhde-xp-nav-top)) !important;
  border-color: var(--lhde-xp-field-border) !important;
  border-image: none !important;
}
#nav-bar :is(#back-button, #forward-button):not([disabled]):hover:active > .toolbarbutton-icon {
  background: linear-gradient(var(--lhde-xp-face), #ffffff) !important;
  border-image: none !important;
}
#back-button[disabled] > .toolbarbutton-icon, #forward-button[disabled] > .toolbarbutton-icon { opacity: 1 !important; }
#back-button[disabled] .toolbarbutton-icon, #forward-button[disabled] .toolbarbutton-icon { fill: var(--lhde-xp-shadow) !important; }
/*@END@*/
